---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BlogBlocks from '@/components/BlogBlocks.astro';
import { getPublicBlogPostBySlug } from '@/lib/cms/blog';
import { listPublicInterventions } from '@/lib/cms/interventions';
import { listLinkedInterventionSlugsForBlog } from '@/lib/cms/blog';
import { isCmsAuthed } from '@/lib/cms/auth';

Astro.response.headers.set('Cache-Control', 'no-store');

const slug = String(Astro.params.slug ?? '').trim();
if (!slug) return Astro.redirect('/blog');

const cmsAuthed = isCmsAuthed(Astro);

let dbPost: Awaited<ReturnType<typeof getPublicBlogPostBySlug>> = null;
try {
  dbPost = await getPublicBlogPostBySlug({ slug, includeDraft: cmsAuthed });
} catch {
  dbPost = null;
}

const contentEntries = await getCollection('blog');
const entry =
  !dbPost
    ? contentEntries.find((p) => p.slug === slug && !p.data.draft)
    : null;

if (!dbPost && !entry) return Astro.redirect('/blog');

const title = dbPost?.seo_title || dbPost?.title || entry?.data.title;
const description = dbPost?.seo_description || dbPost?.description || entry?.data.description;
const pageTitle = dbPost?.title || entry?.data.title;
const dateLabel = dbPost?.published_at
  ? new Date(dbPost.published_at).toLocaleDateString('fr-FR')
  : entry
    ? entry.data.date.toLocaleDateString('fr-FR')
    : '';

const rendered = entry ? await entry.render() : null;
const Content = rendered?.Content;

// Linked interventions (from join table)
let linkedInterventions: { title: string; href: string; description: string }[] = [];
if (dbPost) {
  try {
    const slugs = await listLinkedInterventionSlugsForBlog(dbPost.slug);
    if (slugs.length) {
      const all = await listPublicInterventions();
      const map = new Map(all.map((i) => [i.slug, i]));
      linkedInterventions = slugs
        .map((s) => map.get(s))
        .filter(Boolean)
        .map((i) => ({
          title: i!.title,
          description: i!.description,
          href: `/interventions/${i!.category}/${i!.slug}`,
        }));
    }
  } catch {
    linkedInterventions = [];
  }
}
---

<BaseLayout title={title} description={description} noindex={dbPost?.status === 'brouillon' && cmsAuthed}>
  <section class="mx-auto max-w-3xl px-4 py-14">
    <a href="/blog" class="text-sm font-semibold text-ink/70 hover:text-ink">← Blog</a>
    <h1 class="mt-3 font-display text-4xl tracking-tight">{pageTitle}</h1>
    <p class="mt-2 text-sm text-ink/60">{dateLabel}</p>
    <p class="mt-4 text-lg text-ink/75">{description}</p>

    {dbPost ? (
      <div class="mt-10">
        <BlogBlocks blocks={dbPost.content_blocks ?? []} />
      </div>
    ) : (
      <article class="prose-med mt-10 max-w-none">
        {Content ? <Content /> : null}
      </article>
    )}

    {linkedInterventions.length ? (
      <div class="mt-12">
        <div class="flex items-end justify-between gap-3">
          <h2 class="font-display text-2xl tracking-tight">Interventions concernées</h2>
        </div>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {linkedInterventions.slice(0, 4).map((i) => (
            <a href={i.href} class="rounded-3xl border border-ink/10 bg-paper p-6 shadow-soft transition hover:shadow-lift">
              <div class="font-display text-xl tracking-tight">{i.title}</div>
              <div class="mt-2 text-sm text-ink/70">{i.description}</div>
              <div class="mt-4 text-sm font-semibold">Voir l’intervention →</div>
            </a>
          ))}
        </div>
      </div>
    ) : null}

    <div class="mt-10 rounded-3xl border border-ink/10 bg-paper p-6 text-sm text-ink/70">
      Information generale - ne remplace pas une consultation.
    </div>
  </section>
</BaseLayout>
