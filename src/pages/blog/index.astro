---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatFrenchPunctuation } from '@/lib/typography';
import { listPublicLinkedInterventionSlugsForBlog, listPublicBlogPosts } from '@/lib/cms/blog';
import { interventionCategories } from '@/lib/interventions';
import { listPublicInterventions } from '@/lib/cms/interventions';
import {
  approvedBlogPreviewPosts,
  getApprovedBlogPreviewInterventionSlugs,
  useApprovedBlogPreview,
} from '@/lib/blogPreview';

type BlogTheme = 'Journal' | 'Médecine esthétique' | 'Visage' | 'Silhouette' | 'Seins';

type CardPost = {
  slug: string;
  title: string;
  description: string;
  theme: BlogTheme;
  coverImage: string;
};

const imageFallbacks = [
  '/images/placeholders/clinic.webp',
  '/images/interventions/medecine-esthetique.webp',
  '/images/interventions/rajeunissement-du-visage.webp',
  '/images/interventions/rhinoplastie.webp',
];

function inferThemeFromText(input: string): BlogTheme {
  const text = input.toLowerCase();
  if (/(implant|mammaire|sein|prothèse)/.test(text)) return 'Seins';
  if (/(liposuccion|j-plasma|abdominoplastie|poids|silhouette)/.test(text)) return 'Silhouette';
  if (/(lifting|visage|rhinoplastie|nez)/.test(text)) return 'Visage';
  if (/(injection|toxine|hyaluronique|médecine esthétique|esthétique)/.test(text)) return 'Médecine esthétique';
  return 'Journal';
}

let posts: CardPost[] = [];
try {
  const rows = useApprovedBlogPreview ? approvedBlogPreviewPosts : await listPublicBlogPosts();
  let interventionThemeByBlogSlug = new Map<string, BlogTheme>();

  try {
    const interventions = await listPublicInterventions();
    const interventionBySlug = new Map(interventions.map((i) => [i.slug, i]));
    const links = await Promise.all(
      rows.map(async (post) => ({
        blogSlug: post.slug,
        interventionSlugs: useApprovedBlogPreview
          ? getApprovedBlogPreviewInterventionSlugs(post.slug)
          : await listPublicLinkedInterventionSlugsForBlog(post.slug),
      })),
    );

    interventionThemeByBlogSlug = new Map(
      links.map((entry) => {
        const linked = entry.interventionSlugs.map((slug) => interventionBySlug.get(slug)).filter(Boolean);
        const first = linked[0];
        if (!first) return [entry.blogSlug, 'Journal' as BlogTheme];
        const categoryTitle = interventionCategories.find((c) => c.key === first.category)?.title;
        const theme =
          categoryTitle === 'Médecine esthétique' ||
          categoryTitle === 'Visage' ||
          categoryTitle === 'Silhouette' ||
          categoryTitle === 'Seins'
            ? categoryTitle
            : 'Journal';
        return [entry.blogSlug, theme as BlogTheme];
      }),
    );
  } catch {
    interventionThemeByBlogSlug = new Map<string, BlogTheme>();
  }

  posts = rows.map((p, idx) => {
    const coverBlock = (Array.isArray(p.content_blocks) ? p.content_blocks : []).find(
      (block: any) => block?.type === 'image' && typeof block?.url === 'string' && block.url.trim(),
    ) as { url?: string } | undefined;
    const inferred = inferThemeFromText(`${p.title} ${p.description}`);
    const theme = interventionThemeByBlogSlug.get(p.slug) ?? inferred;
    return {
      slug: p.slug,
      title: p.title,
      description: p.description,
      theme,
      coverImage: coverBlock?.url?.trim() || imageFallbacks[idx % imageFallbacks.length],
    };
  });
} catch {
  posts = [];
}

const featured = posts[0] ?? null;
const cards = featured ? posts.slice(1) : posts;
---

<BaseLayout title="Blog" description="Articles d'information médicale : préparation, suites et questions fréquentes.">
  <section class="mx-auto max-w-7xl px-4 pb-24 pt-10 sm:px-6 sm:pt-14">
    <div class="border-y border-ink/25 py-5">
      <div class="flex items-center justify-between gap-6 text-[0.65rem] font-semibold uppercase tracking-[0.24em] text-ink/65">
        <span>Le journal du Dr Sirine Soussi</span>
        <span class="hidden sm:inline">Tunis · Médecine & chirurgie esthétique</span>
      </div>
    </div>
    <div class="grid gap-8 border-b border-ink/25 py-9 lg:grid-cols-[2fr_1fr] lg:items-end lg:py-12">
      <h1 class="text-balance font-display text-6xl leading-[0.82] tracking-[-0.045em] text-ink sm:text-7xl lg:text-[6.7rem]">
        Comprendre<br />avant de décider
      </h1>
      <p class="max-w-sm text-sm leading-7 text-ink/70 lg:pb-2">
        Des repères médicaux accessibles pour comprendre les techniques, leurs indications et leurs limites avant une consultation.
      </p>
    </div>

    {featured ? (
      <header class="-mx-4 grid border-b border-ink/25 bg-mist/55 px-4 py-10 sm:-mx-6 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:py-14">
        <a href={`/blog/${featured.slug}`} class="group block overflow-hidden card-focus lg:col-span-7">
          <div class="aspect-[4/3] h-full min-h-[20rem] overflow-hidden bg-mist lg:aspect-[5/4]">
            <img
              src={featured.coverImage}
              alt=""
              class:list={[
                'h-full w-full transition duration-700 group-hover:scale-[1.025]',
                featured.slug === 'deep-plane-facelift-tunisie' ? 'object-contain' : 'object-cover',
              ]}
              loading="eager"
            />
          </div>
        </a>
        <div class="flex flex-col border-t border-ink/25 pt-6 lg:col-span-5 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
          <div class="flex items-center justify-between text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-copper-deep">
            <span>À la une</span>
            <span>{featured.theme}</span>
          </div>
          <h2 class="mt-8 text-balance font-display text-5xl leading-[0.94] tracking-[-0.025em] sm:text-6xl">{formatFrenchPunctuation(featured.title)}</h2>
          <p class="mt-7 max-w-xl text-base leading-8 text-ink/75">{featured.description}</p>
          <a href={`/blog/${featured.slug}`} class="mt-auto inline-flex w-fit items-center gap-3 border-b border-ink pb-1 pt-10 text-xs font-semibold uppercase tracking-[0.18em] transition hover:opacity-70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-copper/50">
            Lire l'article
            <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
              <path d="M8 16 16 8M9 8h7v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </header>
    ) : null}

    {cards.length ? (
      <section aria-labelledby="articles-title" class="pt-14 sm:pt-16">
        <div class="mb-2 flex items-end justify-between gap-4 pb-5">
          <h2 id="articles-title" class="font-display text-4xl tracking-tight text-ink sm:text-5xl">Dernières parutions</h2>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-ink/60">{posts.length} sujets</p>
        </div>
        <div class="border-t border-ink/25">
        {cards.map((p, index) => (
          <article class:list={[
            'group border-b border-ink/25 py-8 sm:py-10',
            index % 2 === 1 && '-mx-4 bg-mist/55 px-4 sm:-mx-6 sm:px-6',
          ]}>
            <a href={`/blog/${p.slug}`} class="grid gap-6 card-focus md:grid-cols-12 md:items-start md:gap-8">
              <div class:list={['overflow-hidden bg-mist md:col-span-4', index % 2 === 1 && 'md:order-2']}>
                <div class="aspect-[4/3] overflow-hidden">
                  <img
                    src={p.coverImage}
                    alt=""
                    class:list={[
                      'h-full w-full transition duration-700 group-hover:scale-[1.025]',
                      p.slug === 'deep-plane-facelift-tunisie' ? 'object-contain' : 'object-cover',
                    ]}
                    loading="lazy"
                  />
                </div>
              </div>
              <div class:list={['md:col-span-8 md:grid md:grid-cols-[4rem_1fr] md:gap-6', index % 2 === 1 && 'md:order-1']}>
                 <span class="font-display text-3xl text-copper/70">{String(index + 2).padStart(2, '0')}</span>
                <div class="mt-3 md:mt-0">
                  <div class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-copper-deep">{p.theme}</div>
                  <h3 class="mt-3 max-w-2xl text-balance font-display text-4xl leading-[1.02] tracking-tight transition group-hover:opacity-70 sm:text-5xl">{formatFrenchPunctuation(p.title)}</h3>
                  <p class="mt-5 max-w-2xl text-sm leading-7 text-ink/75 sm:text-base">{p.description}</p>
                  <span class="mt-6 inline-flex items-center gap-2 border-b border-ink/50 pb-1 text-xs font-semibold uppercase tracking-[0.14em] text-ink">Lire l’article <span aria-hidden="true">↗</span></span>
                </div>
              </div>
            </a>
          </article>
        ))}
        </div>
      </section>
    ) : (
      <section class="border-y border-ink/25 py-16 text-center text-ink/70">
        Les articles sont temporairement indisponibles.
      </section>
    )}

    <section class="-mx-4 mt-20 grid gap-8 bg-ink px-4 py-10 text-paper sm:-mx-6 sm:grid-cols-[1fr_auto] sm:items-end sm:px-6 sm:py-12 lg:px-10">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sand">Consultation</p>
        <h2 class="mt-3 font-display text-4xl leading-none tracking-tight sm:text-5xl">Une question sur votre situation ?</h2>
        <p class="mt-4 max-w-2xl text-sm leading-7 text-paper/70">Les informations du blog restent générales. Une consultation permet d’évaluer votre indication de manière personnalisée.</p>
      </div>
      <a href="/contact" class="inline-flex min-h-12 shrink-0 items-center justify-center border border-paper/60 bg-paper px-6 text-xs font-semibold uppercase tracking-[0.16em] text-ink transition hover:bg-transparent hover:text-paper focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-copper/50">Prendre rendez-vous</a>
    </section>
  </section>
</BaseLayout>
