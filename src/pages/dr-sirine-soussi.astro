---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/lib/site';

const quickLinks = [
  { href: '#parcours', label: 'Parcours' },
  { href: '#expertise', label: 'Expertise' },
  { href: '#philosophie', label: 'Philosophie' },
  { href: '#cabinet', label: 'Cabinet' },
  { href: '#rendez-vous', label: 'Rendez-vous' },
];

const parcoursCards = [
  {
    index: '01',
    title: 'Formation',
    text: "Cursus en chirurgie plastique, esthétique et reconstructrice, complété par une formation continue orientée sécurité et précision du geste.",
  },
  {
    index: '02',
    title: 'Expérience',
    text: "Pratique en milieu hospitalier et en cabinet, avec prise en charge des indications esthétiques, reconstructrices et fonctionnelles.",
  },
  {
    index: '03',
    title: 'Suivi',
    text: "Accompagnement avant et après intervention : information claire, consignes personnalisées et contrôles réguliers.",
  },
];

const expertiseCards = [
  {
    title: 'Chirurgie esthétique',
    text: 'Visage, silhouette et seins avec stratégie personnalisée.',
    href: '/interventions/visage',
    image: '/images/thumbnails/visage.webp',
  },
  {
    title: 'Médecine esthétique',
    text: 'Injections et soins non chirurgicaux à visée naturelle.',
    href: '/interventions/medecine-esthetique',
    image: '/images/thumbnails/medecine-esthetique.webp',
  },
  {
    title: 'Chirurgie reconstructrice',
    text: 'Réparation et restauration selon indication clinique.',
    href: '/interventions/chirurgie-reparatrice',
    image: '/images/thumbnails/chirurgie-reparatrice.webp',
  },
  {
    title: 'Chirurgie de la main',
    text: 'Pathologies et traumatologie avec parcours de soins dédié.',
    href: '/interventions/chirurgie-de-la-main',
    image: '/images/thumbnails/chirurgie-de-la-main.webp',
  },
];

const principes = [
  {
    index: '01',
    title: 'Écoute et précision',
    text: 'Chaque prise en charge commence par un échange clair pour comprendre la demande, poser un cadre médical réaliste et expliquer les options.',
  },
  {
    index: '02',
    title: 'Esthétique naturelle',
    text: "L'objectif est d'embellir sans transformer, en respectant la singularité du visage, les proportions et l'expressivité.",
  },
  {
    index: '03',
    title: 'Sécurité et transparence',
    text: 'Une information précise sur les bénéfices, les limites, les risques et les suites est intégrée à chaque consultation.',
  },
];
---

<BaseLayout
  title="Dr Sirine Soussi"
  description="Parcours, expertises et philosophie du Dr Sirine Soussi - chirurgie plastique, esthétique, reconstructrice et chirurgie de la main."
>
  <section class="relative overflow-hidden bg-paper">
    <div class="absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-mist to-transparent"></div>
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:py-20">
      <div class="order-2 space-y-7 lg:order-1">
        <div class="space-y-4">
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-ink/55">Chirurgie plastique & esthétique</div>
          <h1 class="font-display text-5xl leading-tight tracking-tight sm:text-6xl lg:text-7xl">Dr Sirine Soussi</h1>
          <p class="max-w-xl text-lg italic text-ink/70">
            Chirurgie plastique, esthétique, reconstructrice et chirurgie de la main.
          </p>
          <p class="max-w-xl text-base leading-relaxed text-ink/75">
            Une approche médicale rigoureuse, centrée sur l'écoute, la sécurité et un résultat naturel adapté à chaque patiente.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a href="/contact" class="btn btn-pill btn-lg btn-primary">Prendre rendez-vous</a>
          <a href="/interventions" class="btn btn-pill btn-lg btn-secondary">Voir les interventions</a>
        </div>

        <div class="rounded-3xl border border-ink/10 bg-mist/70 p-6 shadow-soft">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-ink/60">Accès rapide</div>
          <div class="mt-4 flex flex-wrap gap-2">
            {quickLinks.map((x) => (
              <a href={x.href} class="rounded-full border border-ink/10 bg-paper px-4 py-2 text-sm font-semibold text-ink/80 transition hover:border-ink/25 hover:bg-paper/70">
                {x.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <div class="overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-lift">
          <img
            src="/images/doctor/dr-sirine-soussi-01.png"
            width="1200"
            height="1500"
            alt="Portrait du Dr Sirine Soussi"
            loading="eager"
            fetchpriority="high"
            class="h-[34rem] w-full object-cover sm:h-[42rem]"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper py-20">
    <div class="mx-auto max-w-4xl px-4 text-center">
      <h2 class="font-display text-4xl tracking-tight sm:text-5xl">L'excellence au service de la beauté</h2>
      <div class="mx-auto mt-8 max-w-3xl space-y-6 text-base leading-relaxed text-ink/75 sm:text-lg">
        <p>
          Spécialiste en chirurgie plastique, esthétique et reconstructrice, le Dr Sirine Soussi met son expertise au service de patientes
          accompagnées avec précision et transparence.
        </p>
        <p>
          Chaque indication est discutée en consultation selon l'examen clinique, les attentes et les priorités de sécurité, avec une
          recherche constante d'harmonie et de naturel.
        </p>
      </div>
    </div>
  </section>

  <section id="parcours" class="bg-mist/45 py-20">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-10">
        <h2 class="font-display text-4xl tracking-tight">Parcours & engagement</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {parcoursCards.map((card) => (
          <article class="rounded-3xl border border-ink/10 bg-paper p-8 shadow-soft transition hover:-translate-y-0.5 hover:shadow-lift">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-ink/45">{card.index}</div>
            <h3 class="mt-4 font-display text-3xl tracking-tight">{card.title}</h3>
            <p class="mt-4 text-sm leading-relaxed text-ink/75">{card.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="expertise" class="bg-paper py-20">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="max-w-xl font-display text-4xl leading-tight tracking-tight sm:text-5xl">Champs d'expertise médicale</h2>
        <p class="max-w-sm text-sm leading-relaxed text-ink/70">
          Une approche multidisciplinaire pour répondre à chaque indication avec précision chirurgicale et clarté médicale.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {expertiseCards.map((item) => (
          <a href={item.href} class="group relative overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-soft">
            <img src={item.image} alt={item.title} class="h-80 w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(20,20,19,0.75),transparent_60%)]"></div>
            <div class="absolute inset-x-0 bottom-0 p-5 text-paper">
              <div class="font-display text-2xl tracking-tight">{item.title}</div>
              <div class="mt-1 text-sm text-paper/80">{item.text}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="philosophie" class="bg-[#e5e2db] py-20">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div>
        <h2 class="font-display text-5xl leading-tight tracking-tight">La philosophie du cabinet</h2>
        <p class="mt-5 max-w-md text-base leading-relaxed text-ink/70">
          Une médecine esthétique et chirurgicale exigeante, centrée sur la relation de confiance, la précision technique et la sécurité.
        </p>
      </div>
      <div class="rounded-3xl border border-ink/10 bg-paper p-8 shadow-soft sm:p-10">
        <div class="space-y-7">
          {principes.map((item) => (
            <article class="border-b border-ink/10 pb-7 last:border-b-0 last:pb-0">
              <div class="flex items-start gap-4">
                <span class="pt-1 text-xs font-semibold uppercase tracking-[0.2em] text-ink/40">{item.index}</span>
                <div>
                  <h3 class="font-display text-2xl tracking-tight">{item.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-ink/75">{item.text}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="cabinet" class="bg-paper py-20">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="rounded-3xl border border-ink/10 bg-mist/60 p-8 shadow-soft sm:p-10">
        <h2 class="font-display text-4xl tracking-tight">Le cabinet à {site.contact.city}</h2>
        <div class="mt-8 space-y-5 text-sm text-ink/75">
          <div>
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-ink/55">Adresse</div>
            <div class="mt-2 leading-relaxed">{site.contact.addressLines.join(' · ')}</div>
          </div>
          <div>
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-ink/55">Contact</div>
            <div class="mt-2">{site.contact.phoneDisplay}</div>
          </div>
          <div>
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-ink/55">Horaires</div>
            <div class="mt-2 leading-relaxed">{site.contact.hoursLines.join(' · ')}</div>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-2">
          <a href={site.links.whatsapp} class="btn btn-pill btn-md btn-secondary">WhatsApp</a>
          <a href={site.links.tel} class="btn btn-pill btn-md btn-primary">Appeler</a>
        </div>
      </div>

      <div class="overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-soft">
        <img
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuBpRM1jlsAFU9z06tws9MsmIBVdzugn76J0My-5sQcPQKGlwzlzT26PIAVI9D6WQAZdHkviwPeaYGB_7_PcqxyFkYaBitNpG38sacOHBGJb6AZrMyWf-pwCdVZxFc_yd654pB5FoMN-5plH0oRMWfQnXSDp3J6h6CfA8zAXHASdW3nik2t4dqIh4dpeFsum2VywforiIQA9hgsPtDSaTZSRZDpmW4UySr-QeAVHJGH9-egPCU-NofGYklx8Yd9Nn4XHPFCbqnMNBeaI"
          alt="Intérieur du cabinet"
          class="h-full min-h-[26rem] w-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section id="rendez-vous" class="relative overflow-hidden bg-ink py-20 text-paper">
    <div class="absolute inset-0 opacity-15">
      <img
        src="https://lh3.googleusercontent.com/aida-public/AB6AXuCuTHCpNGuQfaM3Ngjz0mu9cZflxMnep0kYDoQ-GRy53lTm4cwxWAG6FY4UMRj7KgWHeJ0z-BgIxXbIX3y7cjP5DPaGyUjbFfW4zGACC3K7IyJai84P2y0tdF3d6cWKJA3TLKEym0mGoD_X0pEhJgdTcfAuIOON7rXqGjGCnRWpYSVQCtihLGASNOjMHhp8EXiC9uAkssjjZk8KSRhS7OUDhm4TOUV_3g8WpRPIGSXmORYCmiXpKSlMYXjs_np_5RxNJ39Ev6tW7Gkv"
        alt="Texture décorative"
        class="h-full w-full object-cover"
        loading="lazy"
      />
    </div>
    <div class="relative mx-auto max-w-4xl px-4 text-center">
      <h2 class="font-display text-4xl leading-tight tracking-tight sm:text-5xl">
        Prendre rendez-vous
        <span class="italic text-paper/70"> en toute clarté</span>
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-paper/80">
        Une consultation permet de définir une indication personnalisée, d'expliquer les options possibles et de répondre à vos questions
        sur les suites.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/contact" class="btn btn-pill btn-lg bg-paper text-ink hover:bg-paper/90">Réserver une consultation</a>
        <a href={site.links.tel} class="btn btn-pill btn-lg border border-paper/35 bg-transparent text-paper hover:bg-paper/10">
          {site.contact.phoneDisplay}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
