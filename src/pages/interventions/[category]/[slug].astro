---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/lib/site';
import { interventionCategories } from '@/lib/interventions';
import { listPublicAvantApresCases, type AvantApresCaseView } from '@/lib/cms/avantApres';
import { getPublicInterventionBySlug } from '@/lib/cms/interventions';
import { renderMarkdown } from '@/lib/markdown';
import InterventionBlocks from '@/components/InterventionBlocks.astro';
import { listLinkedBlogSlugsForIntervention, listPublicBlogPosts } from '@/lib/cms/blog';
import { getCollection } from 'astro:content';
import { interventionCategoryKeys, type InterventionCategoryKey } from '@/lib/interventions';

Astro.response.headers.set('Cache-Control', 'no-store');

const rawCategory = String(Astro.params.category ?? '');
const category = (interventionCategoryKeys as readonly string[]).includes(rawCategory)
  ? (rawCategory as InterventionCategoryKey)
  : null;
const slug = String(Astro.params.slug ?? '').trim();
if (!category || !slug) {
  return Astro.redirect('/interventions');
}

const cmsAuthed = Astro.cookies.get('cms_auth')?.value === 'true';

let dbItem: Awaited<ReturnType<typeof getPublicInterventionBySlug>> = null;
try {
  dbItem = await getPublicInterventionBySlug({ slug, category, includeDraft: cmsAuthed });
} catch {
  dbItem = null;
}

// Fallback to repo content collection if Supabase is not configured or item not found.
const contentEntries = await getCollection('interventions');
const entry =
  !dbItem
    ? contentEntries.find((e) => {
        const leaf = e.slug.split('/').filter(Boolean).slice(-1)[0] ?? e.slug;
        return e.data.category === category && leaf === slug;
      })
    : null;

if (!dbItem && !entry) {
  return Astro.redirect(`/interventions/${category}`);
}

const title = dbItem?.seo_title || dbItem?.title || entry?.data.title;
const description = dbItem?.seo_description || dbItem?.description || entry?.data.description;
const pageTitle = dbItem?.title || entry?.data.title;
const categoryThumb = interventionCategories.find((c) => c.key === category)?.thumbnailSrc;

const hasBlocks = Array.isArray(dbItem?.content_blocks) && (dbItem?.content_blocks?.length ?? 0) > 0;
const contentHtml = dbItem && !hasBlocks ? renderMarkdown(dbItem.body_md) : null;
const rendered = entry ? await entry.render() : null;
const Content = rendered?.Content;
type AvantApresCaseWithIntervention = AvantApresCaseView & {
  intervention_category?: string | null;
  intervention_slug?: string | null;
  case_number?: number | null;
  description?: string | null;
};
let relatedCases = (await listPublicAvantApresCases()) as AvantApresCaseWithIntervention[];
relatedCases = relatedCases.filter(
  (item) => item.intervention_category === category && item.intervention_slug === slug,
);
relatedCases = relatedCases
  .sort((a, b) => (a.case_number ?? 999) - (b.case_number ?? 999))
  .slice(0, 4);

let relatedArticles: { title: string; description: string; href: string }[] = [];
if (dbItem) {
  try {
    const slugs = await listLinkedBlogSlugsForIntervention(dbItem.slug);
    if (slugs.length) {
      const posts = await listPublicBlogPosts();
      const map = new Map(posts.map((p) => [p.slug, p]));
      relatedArticles = slugs
        .map((s) => map.get(s))
        .filter(Boolean)
        .map((p) => ({ title: p!.title, description: p!.description, href: `/blog/${p!.slug}` }));
    }
  } catch {
    relatedArticles = [];
  }
}
---

<BaseLayout title={title} description={description} noindex={dbItem?.status === 'brouillon' && cmsAuthed}>
  <section class="mx-auto max-w-3xl px-4 py-14">
    <a href={`/interventions/${category}`} class="text-sm font-semibold text-ink/70 hover:text-ink">
      ← Retour a la categorie
    </a>
    <h1 class="mt-3 font-display text-4xl tracking-tight">{pageTitle}</h1>
    <p class="mt-4 text-lg text-ink/75">{description}</p>

    {categoryThumb ? (
      <div class="mt-7 overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-soft">
        <img
          src={categoryThumb}
          width="1200"
          height="900"
          alt=""
          loading="lazy"
          class="h-40 w-full object-cover sm:h-52"
        />
      </div>
    ) : null}

    <div class="mt-8 rounded-3xl border border-ink/10 bg-mist p-6 text-sm text-ink/75">
      <div class="font-semibold text-ink">Prendre rendez-vous</div>
      <div class="mt-2">Telephone: {site.contact.phoneDisplay}</div>
      <div class="mt-4 flex flex-col gap-3 sm:flex-row">
        <a href={site.links.tel} class="rounded-full bg-ink px-5 py-2.5 text-center font-semibold text-paper">Appeler</a>
        <a href={site.links.whatsapp} class="rounded-full border border-ink/15 bg-paper px-5 py-2.5 text-center font-semibold text-ink">WhatsApp</a>
      </div>
    </div>

    {dbItem && hasBlocks ? (
      <div class="mt-10">
        <InterventionBlocks blocks={dbItem.content_blocks ?? []} />
      </div>
    ) : (
      <article class="prose-med mt-10 max-w-none">
        {contentHtml ? <Fragment set:html={contentHtml} /> : Content ? <Content /> : null}
      </article>
    )}

    {relatedCases.length ? (
      <section class="mt-12">
        <div class="flex items-center justify-between gap-3">
          <div>
            <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Avant / après</div>
            <h2 class="mt-2 font-display text-2xl tracking-tight">Résultats pour cette intervention</h2>
          </div>
            <a
              href={`/avant-apres?intervention_category=${category}&intervention_slug=${slug}`}
              class="link text-sm"
            >
              Tout voir →
            </a>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {relatedCases.map((item: AvantApresCaseWithIntervention) => (
              <a
                href={`/avant-apres/${item.id}`}
                class="group overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-soft transition hover:shadow-lift"
              >
                <div class="relative aspect-[4/3] w-full">
                  <img src={item.afterUrl} alt="Après" class="h-full w-full object-cover" loading="lazy" />
                  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_top,rgba(20,20,19,0.55),transparent_55%)]"></div>
                  <div class="absolute inset-x-0 bottom-0 p-5 text-paper">
                    <div class="text-xs font-semibold uppercase tracking-wide text-paper/70">Avant / après</div>
                    <div class="mt-1 font-display text-2xl tracking-tight">
                      {item.case_number ? `Cas ${String(item.case_number).padStart(2, '0')}` : item.title}
                    </div>
                  </div>
                </div>
                <div class="p-5">
                  {item.case_number ? (
                    <div class="text-sm text-ink/70">Cas {String(item.case_number).padStart(2, '0')}</div>
                  ) : null}
                  {item.description ? (
                    <div class="mt-2 text-sm text-ink/70">{item.description}</div>
                  ) : null}
                </div>
              </a>
            ))}
        </div>
      </section>
    ) : null}

    {relatedArticles.length ? (
      <section class="mt-14">
        <div class="flex items-end justify-between gap-3">
          <h2 class="font-display text-2xl tracking-tight">À lire aussi</h2>
          <a href="/blog" class="link text-sm">Tous les articles →</a>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {relatedArticles.slice(0, 4).map((a) => (
            <a href={a.href} class="rounded-3xl border border-ink/10 bg-paper p-6 shadow-soft transition hover:shadow-lift">
              <div class="font-display text-xl tracking-tight">{a.title}</div>
              <div class="mt-2 text-sm text-ink/70">{a.description}</div>
              <div class="mt-4 text-sm font-semibold">Lire →</div>
            </a>
          ))}
        </div>
      </section>
    ) : null}

    <div class="mt-10 rounded-3xl border border-ink/10 bg-paper p-6 text-sm text-ink/70">
      Information générale - ne remplace pas une consultation. Les résultats et les suites varient selon chaque patient.
    </div>
  </section>
</BaseLayout>
