---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  interventionCategoryFallbackList,
  interventionCategories,
  interventionCategoryKeys,
  interventionCategoryMeta,
  type InterventionCategoryKey
} from '@/lib/interventions';
import { listPublicInterventions } from '@/lib/cms/interventions';
import { getCollection } from 'astro:content';

const rawCategory = String(Astro.params.category ?? '');
const category = (interventionCategoryKeys as readonly string[]).includes(rawCategory)
  ? (rawCategory as InterventionCategoryKey)
  : null;

if (!category) {
  return Astro.redirect('/interventions');
}

type CardItem = { title: string; description: string; slug: string; category: InterventionCategoryKey; order?: number | null };

let items: CardItem[] = [];
try {
  const rows = await listPublicInterventions(category);
  items = rows
    .map((r) => ({
      title: r.title,
      description: r.description,
      slug: r.slug,
      category: r.category,
      order: r.order,
    }))
    .sort((a, b) => (a.order ?? 999) - (b.order ?? 999));
} catch {
  // Fallback to repo content collection if Supabase is not configured.
  const entries = (await getCollection('interventions'))
    .filter((i) => i.data.category === category)
    .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
  items = entries.map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    slug: entry.slug.split('/').filter(Boolean).slice(-1)[0] ?? entry.slug,
    category: entry.data.category,
    order: entry.data.order ?? null,
  }));
}

function leafSlug(full: string) {
  const parts = full.split('/').filter(Boolean);
  return parts[parts.length - 1] ?? full;
}

const title = interventionCategoryMeta[category]?.title ?? 'Interventions';
const thumbSrc = interventionCategories.find((c) => c.key === category)?.thumbnailSrc;
const pageDescriptionByCategory: Partial<Record<InterventionCategoryKey, string>> = {
  'medecine-esthetique':
    "Medecine esthetique a Tunis: injections et soins de la peau, indications, deroule, suites et questions frequentes.",
};
const introByCategory: Partial<Record<InterventionCategoryKey, string>> = {
  'medecine-esthetique':
    "La medecine esthetique regroupe des gestes non chirurgicaux qui visent une amelioration progressive et naturelle. En consultation, l'indication est personnalisee selon votre peau, vos priorites et vos antecedents.",
};
const pageDescription = pageDescriptionByCategory[category] ?? `Interventions - ${title}.`;
const categoryIntro = introByCategory[category] ?? null;
---

<BaseLayout title={title} description={pageDescription}>
  <section class="mx-auto max-w-6xl px-4 py-14">
    <a href="/interventions" class="text-sm font-semibold text-ink/70 hover:text-ink">← Toutes les categories</a>
    <h1 class="mt-3 font-display text-4xl tracking-tight">{title}</h1>

    {thumbSrc ? (
      <div class="mt-7 overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-soft">
        <img
          src={thumbSrc}
          width="1200"
          height="900"
          alt=""
          loading="lazy"
          class="h-44 w-full object-cover sm:h-56"
        />
      </div>
    ) : null}

    {categoryIntro ? (
      <p class="mt-4 max-w-2xl text-ink/75">
        {categoryIntro}
      </p>
    ) : null}

    {items.length ? (
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {items.map((i) => (
          <a
            href={`/interventions/${i.category}/${leafSlug(i.slug)}`}
            class="rounded-3xl border border-ink/10 bg-mist p-7 shadow-soft transition hover:shadow-lift"
          >
            <div class="font-display text-2xl tracking-tight">{i.title}</div>
            <div class="mt-2 text-ink/70">{i.description}</div>
            <div class="mt-5 text-sm font-semibold">Lire la fiche →</div>
          </a>
        ))}
      </div>
    ) : (
      <div class="mt-10 rounded-3xl border border-ink/10 bg-paper p-8 text-ink/75">
        <div class="font-display text-2xl tracking-tight">Liste des interventions</div>
        {interventionCategoryFallbackList[category]?.length ? (
          <ul class="mt-5 grid gap-2 sm:grid-cols-2">
            {interventionCategoryFallbackList[category]!.map((x) => (
              <li class="rounded-2xl border border-ink/10 bg-mist px-4 py-3 text-sm">{x}</li>
            ))}
          </ul>
        ) : (
          <p class="mt-4">Les fiches detaillees arrivent bientot pour cette categorie.</p>
        )}

      </div>
    )}
  </section>
</BaseLayout>
