---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BeforeAfterPair from '@/components/BeforeAfterPair.astro';
import { getCollection } from 'astro:content';
import { getPublicAvantApresCase, type AvantApresCaseView } from '@/lib/cms/avantApres';
import { listPublicInterventions } from '@/lib/cms/interventions';

Astro.response.headers.set('Cache-Control', 'no-store');
const { id } = Astro.params;
type AvantApresCaseWithIntervention = AvantApresCaseView & {
  intervention_category?: string | null;
  intervention_slug?: string | null;
  description?: string | null;
  case_number?: number | null;
};
const item = (id ? await getPublicAvantApresCase(id) : null) as AvantApresCaseWithIntervention | null;
if (!item) {
  return Astro.redirect('/avant-apres');
}

type InterventionLite = { title: string; category: string; slug: string };
let interventions: InterventionLite[] = [];
try {
  const rows = await listPublicInterventions();
  interventions = rows.map((r) => ({ title: r.title, category: r.category, slug: r.slug }));
} catch {
  const entries = await getCollection('interventions');
  interventions = entries.map((entry) => ({
    title: entry.data.title,
    category: entry.data.category,
    slug: entry.slug.split('/').filter(Boolean).slice(-1)[0] ?? entry.slug,
  }));
}

const relatedIntervention =
  item.intervention_category && item.intervention_slug
    ? interventions.find(
        (entry) => entry.category === item.intervention_category && entry.slug === item.intervention_slug,
      )
    : null;
const publicTitle = relatedIntervention?.title ?? item.title ?? 'Résultat documenté';
const pageTitle = publicTitle;
const mediaSets = item.media_sets?.length
  ? item.media_sets
  : [
      {
        id: 'legacy',
        case_id: item.id,
        set_order: 1,
        label: 'Vue principale',
        view_key: null,
        result_delay_value: null,
        result_delay_unit: null,
        result_delay_label: null,
        media_mode: 'pair' as const,
        before_path: item.before_path,
        after_path: item.after_path,
        is_cover: true,
        public_note: null,
        created_at: item.created_at,
        updated_at: item.updated_at,
        beforeUrl: item.beforeUrl,
        afterUrl: item.afterUrl,
      },
    ];

const patientChips: string[] = [];
if (item.patient_context?.patient_age) patientChips.push(`${item.patient_context.patient_age} ans`);
if (item.patient_context?.weight_kg) patientChips.push(`${Number(item.patient_context.weight_kg)} kg`);
if (item.patient_context?.smoking_status === 'non_smoker') patientChips.push('Non fumeuse');
if (item.patient_context?.smoking_status === 'smoker') patientChips.push('Fumeuse');
if (item.patient_context?.post_bariatric) patientChips.push('Post-bariatrique');
if (item.patient_context?.revision_case) patientChips.push('Reprise');
if (item.patient_context?.pregnancies_count) patientChips.push(`${item.patient_context.pregnancies_count} grossesse(s)`);
---

<BaseLayout title={pageTitle} description="Avant/après avec consentement. Les résultats varient selon chaque patient.">
  <section class="mx-auto max-w-5xl px-4 py-14 sm:py-16">
    <a href="/avant-apres" class="link text-sm">← Retour aux résultats</a>
    <div class="mt-10 max-w-3xl">
      <p class="text-sm font-semibold text-copper-deep">Résultat documenté</p>
      <h1 class="mt-3 text-balance font-display text-4xl tracking-tight sm:text-5xl">{publicTitle}</h1>
      {item.summary ? <p class="mt-5 text-lg leading-relaxed text-ink/80">{item.summary}</p> : item.description ? <p class="mt-5 text-lg leading-relaxed text-ink/80">{item.description}</p> : null}
    </div>
    {patientChips.length ? (
      <div class="mt-5 flex flex-wrap gap-2">
        {patientChips.map((chip) => (
          <span class="rounded-full border border-ink/15 bg-mist/70 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.13em] text-ink/70">{chip}</span>
        ))}
      </div>
    ) : null}

    {item.procedures.length ? (
      <div class="mt-8 rounded-3xl border border-ink/10 bg-paper p-5 sm:p-6">
        <div class="text-sm font-semibold text-ink/75">Actes réalisés</div>
        <ul class="mt-3 space-y-2 text-sm text-ink/75">
          {item.procedures.map((proc) => (
            <li>
              {proc.label}
              {proc.is_primary ? <span class="ml-2 rounded-full bg-ink/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-ink/65">Principal</span> : null}
            </li>
          ))}
        </ul>
      </div>
    ) : null}

    <div class="mt-8 space-y-8">
      {mediaSets.map((set) => (
        <section class="rounded-3xl border border-ink/10 bg-paper p-5 sm:p-6">
          <div class="mb-5 flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-balance font-display text-2xl tracking-tight">{set.label ?? 'Vue'}</h2>
            {set.result_delay_label ? (
              <span class="rounded-full border border-ink/15 bg-mist px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.13em] text-ink/65">
                {set.result_delay_label}
              </span>
            ) : null}
          </div>
          <div class="mt-3">
            <BeforeAfterPair beforeUrl={set.beforeUrl} afterUrl={set.afterUrl} mode={set.media_mode} />
          </div>
          {set.public_note ? <p class="mt-4 text-sm text-ink/70">{set.public_note}</p> : null}
        </section>
      ))}
    </div>

    {item.clinical_context ? (
      <div class="mt-8 rounded-2xl border border-ink/10 bg-mist p-5 text-sm leading-relaxed text-ink/75">
        {item.clinical_context}
      </div>
    ) : null}

    <div class="mt-10 rounded-3xl border border-ink/10 bg-mist p-6 text-sm text-ink/75">
      Les résultats varient selon chaque patient. Toute publication se fait avec consentement.
    </div>
  </section>
</BaseLayout>
