---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BrandLockup from '@/components/BrandLockup.astro';
import { site } from '@/lib/site';
import { interventionCategories, interventionCategoryHref } from '@/lib/interventions';
import type { InterventionCategoryKey } from '@/lib/interventions';

const addressQuery = [...site.contact.addressLines, site.contact.city, site.contact.country]
  .filter(Boolean)
  .join(', ');
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressQuery)}`;
const mapsEmbed = `https://www.google.com/maps?q=${encodeURIComponent(addressQuery)}&output=embed`;

const metrics = [
  {
    value: '10+',
    label: 'Années de formation et de pratique chirurgicale',
  },
  {
    value: '4',
    label: 'Cliniques parisiennes de référence - fellowships 2016–2019',
  },
  {
    value: '3',
    label: "Années d'assistanat à l'Institut Kassab",
  },
  {
    value: '100%',
    label: 'Des interventions réalisées en clinique agréée, Tunis',
  },
];

const interventions: Array<{ key: InterventionCategoryKey; title: string; text: string }> = [
  {
    key: 'visage',
    title: 'Chirurgie du visage',
    text: 'Rhinoplastie, blépharoplastie, otoplastie, lifting, lipofilling',
  },
  {
    key: 'seins',
    title: 'Chirurgie des seins',
    text: 'Augmentation, réduction, lifting, lipofilling mammaire',
  },
  {
    key: 'silhouette',
    title: 'Chirurgie de la silhouette',
    text: 'Liposuccion, abdominoplastie, lifting des bras et cuisses',
  },
  {
    key: 'chirurgie-de-la-main',
    title: 'Chirurgie de la main',
    text: 'Canal carpien, tendons, malformations, microchirurgie',
  },
  {
    key: 'medecine-esthetique',
    title: 'Médecine esthétique',
    text: 'Injections, acide hyaluronique, toxine botulique',
  },
  {
    key: 'chirurgie-reparatrice',
    title: 'Chirurgie réparatrice',
    text: 'Tumeurs cutanées, cicatrices, brûlures et séquelles',
  },
];

const interventionVisuals = Object.fromEntries(
  interventionCategories.map((item) => [item.key, item.thumbnailSrc]),
) as Record<InterventionCategoryKey, string>;

const testimonials = [
  {
    stars: '★★★★★',
    title: 'Cynthia Gamber',
    meta: 'Rhinoplastie secondaire · il y a 12 semaines',
    quote:
      "Elle a sauvé mon visage. J'avais effectué une rhinoplastie en Turquie qui avait été un désastre - elle a su tout reprendre et faire le nez que je désirais depuis toujours. Aucune cicatrice visible. Elle a des mains en or. J'espère qu'un jour elle sera très connue dans le monde. Allez-y les yeux fermés !",
  },
  {
    stars: '★★★★★',
    title: 'Ju · Local Guide',
    meta: 'Liposuccion + lipofilling · il y a 6 semaines',
    quote:
      "Je recommande le Dr Soussi les yeux fermés. Elle a sublimé ma silhouette. Très à l'écoute, professionnelle et rassurante. Elle m'a clairement expliqué ce qui était possible ou non selon mon corps, sans jamais promettre l'impossible.",
  },
  {
    stars: '★★★★★',
    title: 'Steph Pyares',
    meta: 'Abdominoplastie · il y a 6 semaines',
    quote:
      "Cette femme a des mains de fée. On voit qu'elle aime la perfection et que tout soit carré, autant en salle d'opération que dans la chambre. Le fait de passer directement par elle sur WhatsApp est bien meilleur. Un grand merci.",
  },
];
---

<BaseLayout title="Accueil" description={site.description}>
  <div class="home-page">
  <section class="relative isolate -mt-[4.5rem] overflow-hidden bg-ink text-paper">
    <img
      src="/images/placeholders/hero-clinic-01.webp"
      width="1280"
      height="960"
      alt="Cabinet du Dr Sirine Soussi aux Berges du Lac"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(18,18,17,0.52)_0%,rgba(18,18,17,0.68)_50%,rgba(18,18,17,0.50)_100%)]"></div>
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(46rem_26rem_at_50%_42%,rgba(190,119,76,0.22),transparent_68%),linear-gradient(to_top,rgba(18,18,17,0.48),transparent_46%)]"></div>
    <div class="relative mx-auto flex min-h-[44rem] max-w-6xl items-center justify-center px-4 pb-16 pt-[8.5rem] text-center lg:min-h-[50rem] lg:pb-24 lg:pt-[9.5rem]" data-reveal-group="hero">
      <div class="mx-auto max-w-4xl">
        <h1 class="reveal mx-auto flex justify-center" aria-label={site.name} data-reveal>
          <span class="sm:hidden">
            <BrandLockup
              id="hero-brand-mobile"
              gapClass="gap-2"
              markClass="h-28"
              wordmarkClass="-ml-1"
              wordmarkSize="1.8rem"
              wordmarkWeight={400}
              wordmarkFontFamily="'Playfair Display', Georgia, serif"
              wordmarkLetterSpacing="-0.025em"
            />
          </span>
          <span class="hidden sm:inline">
            <BrandLockup
              id="hero-brand-desktop"
              layout="wordmark-centered"
              markClass="h-36 lg:h-44"
              markOffsetClass="mr-2 sm:mr-3"
              wordmarkSize="clamp(2rem, 4.6vw, 3.7rem)"
              wordmarkWeight={400}
              wordmarkFontFamily="'Playfair Display', Georgia, serif"
              wordmarkLetterSpacing="-0.025em"
            />
          </span>
        </h1>
        <p class="reveal mx-auto mt-7 max-w-2xl text-xl leading-relaxed text-paper/88 sm:text-2xl" data-reveal>
          Chirurgie plastique, esthétique, reconstructrice et chirurgie de la main
        </p>
        <div class="reveal mt-8 flex flex-wrap justify-center gap-3" data-reveal>
          <a href="/contact" class="btn btn-pill btn-lg btn-accent fx-cta-sheen">Prendre rendez-vous</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper">
    <div class="mx-auto max-w-6xl border-y border-ink/10 px-4" data-reveal-group="mots">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr]">
        <div class="py-12 lg:py-16 lg:pr-12">
          <h2 class="section-heading intro-heading reveal max-w-3xl text-ink" data-reveal>Une pratique fondée sur l’écoute</h2>
          <div class="mt-7 space-y-5 text-base leading-8 text-ink/78 sm:text-lg">
            <p>
              Formée à Tunis puis à Paris - au sein des plus grandes cliniques de la capitale française - je suis revenue en Tunisie avec
              une conviction : que l'excellence chirurgicale n'a pas de frontières, et que chaque patient mérite une prise en charge
              rigoureuse, personnalisée et honnête.
            </p>
            <p>
              Ce qui me guide dans chaque consultation, c'est l'écoute. Comprendre ce que vous ressentez, évaluer ce qui est réalisable,
              vous proposer la meilleure indication selon votre cas - et rien de plus. La chirurgie esthétique, telle que je la conçois,
              doit sublimer sans dénaturer.
            </p>
            <a href="/dr-sirine-soussi" class="reveal inline-flex border-b border-ink/35 pb-1 text-sm font-semibold uppercase tracking-[0.18em] text-ink/80 transition hover:border-ink hover:text-ink" data-reveal>
              → Lire mon parcours complet
            </a>
          </div>
        </div>
        <div class="border-t border-ink/10 py-8 lg:border-l lg:border-t-0 lg:py-16 lg:pl-12">
          <div class="reveal fx-image-pan overflow-hidden rounded-[1.5rem] border border-ink/10 bg-mist shadow-soft" data-reveal>
            <img
              src="/images/placeholders/clinic.webp"
              width="1280"
              height="960"
              alt="Cabinet du Dr Sirine Soussi"
              loading="lazy"
              class="h-full min-h-[28rem] w-full object-cover sm:min-h-[34rem]"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-mist/35">
    <div class="mx-auto max-w-6xl border-b border-ink/10 px-4" data-reveal-group="chiffres">
      <div class="border-b border-ink/10 py-10">
        <h2 class="section-heading section-heading-compact reveal text-ink" data-reveal>Repères de parcours</h2>
        <p class="reveal mt-4 max-w-xl text-sm leading-7 text-ink/68" data-reveal>
          Quelques repères pour situer une pratique construite entre formation hospitalière, expérience internationale et activité clinique.
        </p>
      </div>
      <div class="reveal" data-reveal>
        <dl class="grid divide-y divide-ink/10 sm:grid-cols-2 sm:divide-x sm:divide-y-0 lg:grid-cols-4">
          {metrics.map((item) => (
            <div class="px-0 py-6 sm:px-5 lg:px-6">
              <dt class="font-display text-4xl tracking-tight text-copper sm:text-5xl">{item.value}</dt>
              <dd class="mt-3 max-w-[18rem] text-sm leading-7 text-ink/76">{item.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="bg-paper">
    <div class="mx-auto max-w-6xl border-b border-ink/10 px-4" data-reveal-group="interventions">
      <div class="border-b border-ink/10 py-10">
        <h2 class="section-heading section-heading-compact reveal text-ink" data-reveal>Interventions</h2>
        <p class="reveal mt-4 max-w-xl text-sm leading-7 text-ink/68" data-reveal>
          Des indications discutées en consultation, avec une priorité donnée à la sécurité, au naturel et à la justesse du geste.
        </p>
      </div>
      <div class="grid gap-4 py-8 md:grid-cols-2 xl:grid-cols-3">
        {interventions.map((item) => (
          <a
            href={interventionCategoryHref(item.key)}
            class="reveal group fx-lift-soft fx-card-edge overflow-hidden rounded-[1.5rem] border border-ink/10 bg-mist/55 card-focus"
            data-reveal
          >
            <div class="relative aspect-[16/10] w-full overflow-hidden">
              <img
                src={interventionVisuals[item.key]}
                width="1200"
                height="900"
                alt={item.title}
                loading="lazy"
                class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
              />
              <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_top,rgba(20,20,19,0.45),transparent_62%)]"></div>
            </div>
            <div class="p-6">
              <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-copper-deep">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-ink/76">{item.text}</p>
              <div class="mt-4 text-sm font-semibold text-ink/78 transition group-hover:text-ink">Découvrir →</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ink text-paper">
    <div class="mx-auto max-w-6xl border-b border-paper/12 px-4" data-reveal-group="avis">
      <div class="grid gap-3 border-b border-paper/12 py-10 md:grid-cols-[1fr_auto] md:items-end">
        <h2 class="section-heading section-heading-compact reveal text-paper" data-reveal>Retours de patients</h2>
        <div class="reveal text-sm font-semibold tracking-[0.08em] text-paper/70 md:text-right" data-reveal>Avis Google vérifiés</div>
      </div>
      <div class="grid lg:grid-cols-[1.08fr_0.92fr] lg:items-stretch">
        {testimonials.slice(0, 1).map((item) => (
          <article class="reveal py-8 lg:pr-10" data-reveal>
            <div class="rounded-[1.75rem] border border-ink/10 bg-mist/45 p-6 shadow-soft sm:p-8 lg:p-10">
              <div class="text-lg font-semibold tracking-[0.18em] text-copper" role="img" aria-label="5 étoiles">{item.stars}</div>
              <blockquote class="mt-5 text-xl leading-9 text-ink/84 sm:text-2xl sm:leading-10">
                « {item.quote} »
              </blockquote>
              <footer class="mt-7">
                <div class="text-sm font-semibold uppercase tracking-[0.16em] text-ink/78">{item.title}</div>
                <div class="mt-1 text-xs uppercase tracking-[0.14em] text-ink/64">{item.meta}</div>
              </footer>
            </div>
          </article>
        ))}
        <div class="reveal border-t border-paper/12 py-8 lg:border-l lg:border-t-0 lg:pl-10" data-reveal>
          <div class="grid divide-y divide-paper/12">
            {testimonials.slice(1).map((item) => (
              <article class="py-5 first:pt-0 last:pb-0">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-paper/82">{item.title}</h3>
                  <div class="text-sm font-semibold tracking-[0.14em] text-copper" role="img" aria-label="5 étoiles">{item.stars}</div>
                </div>
                <p class="mt-3 text-sm leading-7 text-paper/80">« {item.quote} »</p>
                <div class="mt-3 text-xs uppercase tracking-[0.12em] text-paper/64">{item.meta}</div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="mx-auto max-w-6xl border-b border-ink/10 px-4" data-reveal-group="cta-final">
      <div class="grid gap-8 py-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:py-16">
        <div>
          <h2 class="section-heading section-heading-compact reveal text-ink" data-reveal>Prendre rendez-vous</h2>
          <p class="reveal text-3xl italic leading-tight text-ink sm:text-4xl" data-reveal>
            Je vous reçois en consultation au cabinet aux Berges du Lac 1, Tunis.
          </p>
          <p class="reveal mt-5 max-w-2xl text-ink/78" data-reveal>
            Une information médicale claire, une consultation structurée et une prise en charge personnalisée.
          </p>
          <div class="reveal mt-7 flex flex-wrap gap-3" data-reveal>
            <a href="/contact" class="btn btn-pill btn-lg btn-primary fx-cta-sheen">Prendre rendez-vous</a>
            <a href={mapsHref} target="_blank" rel="noreferrer" class="btn btn-pill btn-lg border border-ink/25 text-ink hover:bg-mist">Itinéraire</a>
          </div>
          <address class="reveal mt-5 border-t border-ink/15 pt-4 text-xs leading-5 not-italic text-ink/70" data-reveal>
            <a href={mapsHref} target="_blank" rel="noreferrer" class="inline-flex items-start gap-2 rounded-md underline decoration-ink/30 underline-offset-4 transition hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-copper/50 focus-visible:ring-offset-2 focus-visible:ring-offset-paper">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21s7-5.1 7-12a7 7 0 0 0-14 0c0 6.9 7 12 7 12Z" />
                <circle cx="12" cy="9" r="2.4" />
              </svg>
              {site.contact.addressLines.join(', ')}, {site.contact.city}
            </a>
          </address>
        </div>
        <div class="reveal overflow-hidden rounded-[1.5rem] border border-ink/10 bg-mist shadow-soft" data-reveal>
          <iframe
            src={mapsEmbed}
            title="Plan d'accès au cabinet du Dr Sirine Soussi"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-[20rem] w-full border-0 lg:h-[24rem]"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>

<style>
  .home-page :is(h1, h2) {
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-transform: none;
    text-wrap: balance;
  }

  .home-page h3 {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .home-page p {
    max-width: 65ch;
    font-size: 1rem;
    line-height: 1.72;
    text-wrap: pretty;
  }

  .home-page p + p {
    margin-top: 1.5rem;
  }

  .section-label {
    font-size: 0.93rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-wrap: balance;
  }

  .section-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.16;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .section-heading-compact {
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
  }

  .intro-heading {
    font-size: clamp(1.9rem, 3.8vw, 3.05rem);
  }

  .reveal {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .reveal-ready .reveal {
      opacity: 0;
      transform: translateY(18px);
      transition:
        opacity 560ms ease,
        transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .reveal-ready .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fx-lift-soft {
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease,
      background-color 220ms ease;
  }

  .fx-lift-soft:hover {
    transform: translateY(-2px);
    border-color: rgba(var(--c-copper) / 0.28);
    box-shadow: 0 18px 38px rgba(17, 24, 39, 0.08);
  }

  .fx-card-edge {
    position: relative;
    overflow: hidden;
  }

  .fx-card-edge::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(to right, rgba(var(--c-copper) / 0.68), rgba(var(--c-sand) / 0.24));
    transform: scaleX(0.2);
    transform-origin: left center;
    transition: transform 240ms ease;
  }

  .fx-card-edge:hover::before {
    transform: scaleX(1);
  }

  .fx-image-pan img {
    transition: transform 860ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .fx-image-pan:hover img {
    transform: scale(1.03) translateY(-1px);
  }

  .metric-value {
    transition: transform 240ms ease, text-shadow 240ms ease;
  }

  .fx-lift-soft:hover .metric-value {
    transform: translateY(-1px);
    text-shadow: 0 0 18px rgba(var(--c-copper) / 0.16);
  }

  .fx-cta-sheen {
    position: relative;
    overflow: hidden;
  }

  .fx-cta-sheen::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 20%, rgba(255, 255, 255, 0.26) 48%, transparent 74%);
    transform: translateX(-145%);
    transition: transform 440ms ease;
  }

  .fx-cta-sheen:hover::after,
  .fx-cta-sheen:focus-visible::after {
    transform: translateX(140%);
  }

  .fx-cta-secondary {
    transition: background-color 220ms ease, border-color 220ms ease, transform 220ms ease;
  }

  .fx-cta-secondary:hover {
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .reveal.is-visible,
      .fx-lift-soft,
    .fx-card-edge::before,
    .fx-image-pan img,
    .metric-value,
    .fx-cta-sheen::after,
    .fx-cta-secondary {
      transition: none;
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
  const revealGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal-group]'));

  document.documentElement.classList.add('reveal-ready');

  revealGroups.forEach((group) => {
    const items = Array.from(group.querySelectorAll<HTMLElement>('[data-reveal]'));
    items.forEach((item, index) => {
      item.style.transitionDelay = `${Math.min(index * 65, 260)}ms`;
    });
  });

  if (mediaQuery.matches) {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14, rootMargin: '0px 0px -8% 0px' },
    );

    revealItems.forEach((item) => observer.observe(item));
  }
</script>
