    .location-media,
    .location-chip {
      animation: none;
      transition: none;
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && !hero.hasAttribute('data-hero-initialized')) {
    hero.setAttribute('data-hero-initialized', '');
    const image = hero.querySelector<HTMLImageElement>('[data-hero-image]');
    const resources: Promise<unknown>[] = [image?.decode() ?? Promise.resolve()];

    if ('fonts' in document) resources.push(document.fonts.ready);

    void Promise.allSettled(resources).then(() => {
      requestAnimationFrame(() => {
        hero.removeAttribute('data-hero-pending');
        hero.setAttribute('data-hero-ready', '');
      });
    });
  }

  const reviews = document.querySelector<HTMLElement>('[data-google-reviews]');
  if (reviews) {
    const surface = reviews.querySelector<HTMLElement>('[data-reviews-surface]');
    const media = gsap.matchMedia();
    let entered = false;
    media.add('(prefers-reduced-motion: no-preference)', () => {
      if (entered || !surface) return;
      // Same ascending inset wipe as the hero veil. Content travels with its
      // opaque surface so light text is never exposed on the light fallback.
      const reveal = gsap.fromTo(surface,
        { clipPath: 'inset(100% 0 0 0)' },
        {
          clipPath: 'inset(0% 0 0 0)', duration: 1, ease: 'expo.out',
          scrollTrigger: {
            trigger: reviews, start: 'top 90%', once: true,
            onEnter: () => { entered = true; },
          },
        });
      const onFocus = () => {
        entered = true;
        reveal.progress(1);
        reveal.scrollTrigger?.kill();
      };
      reviews.addEventListener('focusin', onFocus);
      return () => reviews.removeEventListener('focusin', onFocus);
    });
    document.addEventListener('astro:before-swap', () => media.revert(), { once: true });
  }

  const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
  const revealGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal-group]'));

  document.documentElement.classList.add('reveal-ready');

  revealGroups.forEach((group) => {
    const items = Array.from(group.querySelectorAll<HTMLElement>('[data-reveal]'));
    const step = Number(group.dataset.revealStep) || 65;
    items.forEach((item, index) => {
      item.style.transitionDelay = `${Math.min(index * step, 260)}ms`;
    });
  });

  if (mediaQuery.matches) {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14, rootMargin: '0px 0px -8% 0px' },
    );

    revealItems.forEach((item) => observer.observe(item));
  }
</script>
