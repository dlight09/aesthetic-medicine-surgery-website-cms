---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/lib/site';
import { interventionCategories, interventionCategoryHref } from '@/lib/interventions';
import type { InterventionCategoryKey } from '@/lib/interventions';

const proofChips = [
  'Diplômée Faculté de Médecine de Tunis',
  'Fellowship Paris 2016–2019',
  'Ancienne AHU · Institut Kassab',
  'Ordre des Médecins n° 22356',
];

const metrics = [
  {
    value: '10+',
    label: 'Années de formation et de pratique chirurgicale',
  },
  {
    value: '4',
    label: 'Cliniques parisiennes de référence — fellowships 2016–2019',
  },
  {
    value: '3',
    label: "Années d'assistanat à l'Institut Kassab",
  },
  {
    value: '100%',
    label: 'Des interventions réalisées en clinique agréée, Tunis',
  },
];

const interventions: Array<{ key: InterventionCategoryKey; title: string; text: string }> = [
  {
    key: 'visage',
    title: 'Chirurgie du visage',
    text: 'Rhinoplastie, blépharoplastie, otoplastie, lifting, lipofilling',
  },
  {
    key: 'seins',
    title: 'Chirurgie des seins',
    text: 'Augmentation, réduction, lifting, lipofilling mammaire',
  },
  {
    key: 'silhouette',
    title: 'Chirurgie de la silhouette',
    text: 'Liposuccion, abdominoplastie, lifting des bras et cuisses',
  },
  {
    key: 'chirurgie-de-la-main',
    title: 'Chirurgie de la main',
    text: 'Canal carpien, tendons, malformations, microchirurgie',
  },
  {
    key: 'medecine-esthetique',
    title: 'Médecine esthétique',
    text: 'Injections, acide hyaluronique, toxine botulique',
  },
];

const interventionVisuals = Object.fromEntries(
  interventionCategories.map((item) => [item.key, item.thumbnailSrc]),
) as Record<InterventionCategoryKey, string>;

const philosophyCards = [
  {
    title: "L'art du détail",
    text: "Une passion pour les formes et les proportions qui guide chaque intervention, du plan opératoire au dernier geste.",
  },
  {
    title: 'Sécurité absolue',
    text: "La sécurité du patient prime sur tout. Je ne pratique que les interventions pour lesquelles l'indication est juste.",
  },
  {
    title: 'Résultats naturels',
    text: "Sublimer sans transformer. Respecter l'identité de chaque corps, comme un sculpteur respecte la matière.",
  },
];

const testimonials = [
  {
    stars: '★★★★★',
    title: 'Cynthia Gamber',
    meta: 'Rhinoplastie secondaire · il y a 12 semaines',
    quote:
      "Elle a sauvé mon visage. J'avais effectué une rhinoplastie en Turquie qui avait été un désastre — elle a su tout reprendre et faire le nez que je désirais depuis toujours. Aucune cicatrice visible. Elle a des mains en or. J'espère qu'un jour elle sera très connue dans le monde. Allez-y les yeux fermés !",
  },
  {
    stars: '★★★★★',
    title: 'Ju · Local Guide',
    meta: 'Liposuccion + lipofilling · il y a 6 semaines',
    quote:
      "Je recommande le Dr Soussi les yeux fermés. Elle a sublimé ma silhouette. Très à l'écoute, professionnelle et rassurante. Elle m'a clairement expliqué ce qui était possible ou non selon mon corps, sans jamais promettre l'impossible.",
  },
  {
    stars: '★★★★★',
    title: 'Steph Pyares',
    meta: 'Abdominoplastie · il y a 6 semaines',
    quote:
      "Cette femme a des mains de fée. On voit qu'elle aime la perfection et que tout soit carré, autant en salle d'opération que dans la chambre. Le fait de passer directement par elle sur WhatsApp est bien meilleur. Un grand merci.",
  },
  {
    stars: '★★★★★',
    title: 'Cécile D.',
    meta: 'Chirurgie esthétique',
    quote:
      "Mon intervention s'est déroulée dans une clinique avec un personnel accueillant, bienveillant, avec le Dr Soussi, merveilleuse chirurgienne, qui a fait un travail remarquable.",
  },
];
---

<BaseLayout title="Accueil" description={site.description}>
  <section class="relative overflow-hidden bg-paper">
    <div class="absolute inset-0 bg-[radial-gradient(70rem_35rem_at_14%_10%,rgba(231,219,200,0.45),transparent_62%),radial-gradient(60rem_32rem_at_88%_18%,rgba(185,111,84,0.12),transparent_62%)]"></div>
    <div class="relative mx-auto grid max-w-6xl gap-8 px-4 py-14 lg:grid-cols-[1.03fr_0.97fr] lg:items-center lg:py-20" data-reveal-group="hero">
      <div class="space-y-7">
        <div class="section-label reveal text-ink/55" data-reveal>CHIRURGIENNE PLASTICIENNE · TUNIS, LES BERGES DU LAC</div>
        <h1 class="home-name reveal" data-reveal>Dr Sirine Soussi</h1>
        <p class="reveal text-xl leading-relaxed text-ink/82" data-reveal>
          Spécialiste en chirurgie plastique, esthétique, reconstructrice & chirurgie de la main
        </p>
        <p class="reveal max-w-2xl text-base leading-8 text-ink/76 sm:text-lg" data-reveal>
          Une chirurgie juste, précise et sûre — pensée pour chaque patient, jamais pour l'excès. Je vous reçois en consultation à
          Tunis pour vous accompagner vers la meilleure décision pour vous.
        </p>

        <div class="grid gap-3 sm:grid-cols-2" data-reveal-group="chips">
          {proofChips.map((item) => (
            <div class="chip-proof reveal fx-chip rounded-2xl border border-ink/10 bg-paper/88 px-4 py-3 text-xs font-semibold uppercase tracking-[0.16em] text-ink/72 shadow-soft" data-reveal>
              {item}
            </div>
          ))}
        </div>

        <div class="reveal flex flex-wrap gap-3" data-reveal>
          <a href="/contact" class="btn btn-pill btn-lg btn-primary fx-cta-sheen">Prendre rendez-vous</a>
          <a href={site.links.whatsapp} class="btn btn-pill btn-lg btn-secondary fx-cta-secondary">Appel & WhatsApp</a>
        </div>
      </div>

      <div class="reveal fx-image-pan overflow-hidden rounded-[2rem] border border-ink/10 bg-paper shadow-lift" data-reveal>
        <img
          src="/images/doctor/dr-sirine-soussi-01.png"
          width="1200"
          height="1500"
          alt="Portrait du Dr Sirine Soussi"
          loading="eager"
          fetchpriority="high"
          class="h-[32rem] w-full object-cover sm:h-[40rem]"
        />
      </div>
    </div>
  </section>

  <section class="bg-paper py-16">
    <div class="mx-auto max-w-6xl px-4" data-reveal-group="mots">
      <div class="section-label reveal text-ink/50" data-reveal>EN QUELQUES MOTS</div>
      <div class="mt-5 grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
        <div class="space-y-5 text-base leading-8 text-ink/78 sm:text-lg">
          <p>
            Formée à Tunis puis à Paris — au sein des plus grandes cliniques de la capitale française — je suis revenue en Tunisie avec
            une conviction : que l'excellence chirurgicale n'a pas de frontières, et que chaque patient mérite une prise en charge
            rigoureuse, personnalisée et honnête.
          </p>
          <p>
            Ce qui me guide dans chaque consultation, c'est l'écoute. Comprendre ce que vous ressentez, évaluer ce qui est réalisable,
            vous proposer la meilleure indication selon votre cas — et rien de plus. La chirurgie esthétique, telle que je la conçois,
            doit sublimer sans dénaturer.
          </p>
          <a href="/dr-sirine-soussi" class="reveal inline-flex border-b border-ink/35 pb-1 text-sm font-semibold uppercase tracking-[0.18em] text-ink/80 transition hover:border-ink hover:text-ink" data-reveal>
            → Lire mon parcours complet
          </a>
        </div>
        <div class="reveal fx-image-pan overflow-hidden rounded-[2rem] border border-ink/10 bg-paper shadow-soft" data-reveal>
          <img
            src="/images/about/Hopital-paris.jpg"
            width="1200"
            height="900"
            alt="Hôpital Saint-Louis à Paris"
            loading="lazy"
            class="h-full min-h-[21rem] w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f4efe8] py-16">
    <div class="mx-auto max-w-6xl px-4" data-reveal-group="chiffres">
      <div class="section-label reveal text-ink/50" data-reveal>EN CHIFFRES</div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {metrics.map((item) => (
          <article class="reveal fx-lift-soft rounded-[1.6rem] border border-ink/10 bg-paper p-5 shadow-soft" data-reveal>
            <div class="metric-value font-display text-5xl tracking-tight text-copper">{item.value}</div>
            <p class="mt-3 text-sm leading-7 text-ink/74">{item.label}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-paper py-16">
    <div class="mx-auto max-w-6xl px-4" data-reveal-group="interventions">
      <div class="section-label reveal text-ink/50" data-reveal>MES INTERVENTIONS</div>
      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {interventions.map((item) => (
          <a
            href={interventionCategoryHref(item.key)}
            class="reveal group fx-lift-soft fx-card-edge overflow-hidden rounded-[1.5rem] border border-ink/10 bg-mist/55 shadow-soft card-focus"
            data-reveal
          >
            <div class="relative aspect-[16/10] w-full overflow-hidden">
              <img
                src={interventionVisuals[item.key]}
                width="1200"
                height="900"
                alt={item.title}
                loading="lazy"
                class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
              />
              <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_top,rgba(20,20,19,0.45),transparent_62%)]"></div>
            </div>
            <div class="p-6">
              <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-copper">{item.title}</h2>
              <p class="mt-3 text-sm leading-7 text-ink/76">{item.text}</p>
              <div class="mt-4 text-sm font-semibold text-ink/78 transition group-hover:text-ink">Découvrir →</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mist/35 py-16">
    <div class="mx-auto max-w-6xl px-4" data-reveal-group="philo">
      <div class="section-label reveal text-ink/50" data-reveal>MA PHILOSOPHIE</div>
      <div class="mt-5 space-y-5 text-base leading-8 text-ink/78 sm:text-lg">
        <p>
          J'ai grandi dans une famille où la médecine était une vocation transmise, une présence quotidienne qui m'a appris très tôt
          que soigner relevait avant tout d'une exigence morale — envers soi-même autant qu'envers l'autre. Mais ce qui m'a conduite
          vers la chirurgie esthétique en particulier, c'est quelque chose de plus intime — une sensibilité aux formes, aux
          proportions, à la beauté des choses bien faites.
        </p>
        <p>
          Depuis toujours, je suis attirée par les arts plastiques, la sculpture, tout ce qui relève de la création précise et
          réfléchie. La chirurgie plastique est, pour moi, le lieu exact où ces deux univers se rejoignent : la rigueur de la science,
          la dextérité du geste, et le sens esthétique qui guide chaque décision.
        </p>
        <p>
          Opérer, c'est sculpter. Avec la même exigence qu'un artiste qui ne pose son outil que lorsque chaque détail est juste — ni
          trop, ni insuffisant. Cette méticulosité, je l'ai depuis l'enfance. Elle n'est pas une contrainte, c'est ce qui me définit et
          ce qui, je crois, fait la différence dans mon travail.
        </p>
      </div>

      <div class="mt-7 grid gap-4 md:grid-cols-3">
        {philosophyCards.map((item) => (
          <article class="reveal fx-lift-soft fx-card-edge rounded-[1.5rem] border border-ink/10 bg-paper p-6 shadow-soft" data-reveal>
            <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-copper">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-ink/76">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-paper py-16">
    <div class="mx-auto max-w-6xl px-4" data-reveal-group="avis">
      <div class="section-label reveal text-ink/50" data-reveal>CE QU'ILS DISENT</div>
      <div class="reveal mt-3 text-sm uppercase tracking-[0.2em] text-ink/56" data-reveal>Avis Google vérifiés</div>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {testimonials.map((item) => (
          <article class="reveal fx-lift-soft rounded-[1.5rem] border border-ink/10 bg-mist/45 p-6 shadow-soft" data-reveal>
            <div class="text-sm font-semibold tracking-[0.18em] text-copper">{item.stars}</div>
            <div class="mt-2 text-sm font-semibold uppercase tracking-[0.18em] text-ink/72">{item.title}</div>
            <div class="mt-1 text-xs uppercase tracking-[0.16em] text-ink/54">{item.meta}</div>
            <p class="mt-4 text-sm leading-7 text-ink/76">« {item.quote} »</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ink py-16 text-paper">
    <div class="mx-auto max-w-6xl px-4" data-reveal-group="cta-final">
      <div class="section-label reveal text-paper/70" data-reveal>Prendre rendez-vous</div>
      <div class="mt-4 grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
        <div>
          <p class="reveal text-3xl italic leading-tight text-paper sm:text-4xl" data-reveal>
            Je vous reçois en consultation aux Berges du Lac, Tunis.
          </p>
          <p class="reveal mt-4 max-w-2xl text-base leading-8 text-paper/82 sm:text-lg" data-reveal>
            La première consultation est dédiée à votre projet et à vos questions — sans engagement.
          </p>
          <div class="reveal mt-7 flex flex-wrap gap-3" data-reveal>
            <a href="/contact" class="btn btn-pill btn-lg bg-paper text-ink hover:bg-paper/90 fx-cta-sheen">Prendre rendez-vous</a>
            <a href={site.links.whatsapp} class="btn btn-pill btn-lg border border-paper/35 bg-transparent text-paper hover:bg-paper/10 fx-cta-secondary">Appel & WhatsApp</a>
          </div>
        </div>

        <div class="reveal" data-reveal>
          <div class="fx-image-pan overflow-hidden rounded-[1.5rem] border border-paper/20 bg-paper/5 shadow-soft">
            <img
              src="/images/placeholders/clinic.webp"
              width="1536"
              height="1024"
              alt="Cabinet de consultation aux Berges du Lac"
              loading="lazy"
              class="h-[17rem] w-full object-cover sm:h-[19rem]"
            />
          </div>
        </div>
      </div>
      <div class="reveal mt-8 text-xs leading-relaxed text-paper/62" data-reveal>
        Dr Sirine Soussi · Immeuble Ben Cheikh, 1er étage · Rue du Lac Turkana, Les Berges du Lac 1, Tunis · +216 52 233 333
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-label {
    font-size: 0.93rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .home-name {
    font-family: 'Cormorant Garamond', 'Fraunces', serif;
    font-style: italic;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 0.98;
    font-size: clamp(2.6rem, 6vw, 4.8rem);
  }

  .chip-proof {
    background:
      linear-gradient(rgba(var(--c-paper) / 0.96), rgba(var(--c-paper) / 0.96)) padding-box,
      linear-gradient(135deg, rgba(var(--c-sand) / 0.42), rgba(var(--c-copper) / 0.12), transparent) border-box;
    border: 1px solid transparent;
  }

  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 560ms ease,
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .fx-chip,
  .fx-lift-soft {
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease,
      background-color 220ms ease;
  }

  .fx-chip:hover,
  .fx-lift-soft:hover {
    transform: translateY(-2px);
    border-color: rgba(var(--c-copper) / 0.28);
    box-shadow: 0 18px 38px rgba(17, 24, 39, 0.08);
  }

  .fx-card-edge {
    position: relative;
    overflow: hidden;
  }

  .fx-card-edge::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(to right, rgba(var(--c-copper) / 0.68), rgba(var(--c-sand) / 0.24));
    transform: scaleX(0.2);
    transform-origin: left center;
    transition: transform 240ms ease;
  }

  .fx-card-edge:hover::before {
    transform: scaleX(1);
  }

  .fx-image-pan img {
    transition: transform 860ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .fx-image-pan:hover img {
    transform: scale(1.03) translateY(-1px);
  }

  .metric-value {
    transition: transform 240ms ease, text-shadow 240ms ease;
  }

  .fx-lift-soft:hover .metric-value {
    transform: translateY(-1px);
    text-shadow: 0 0 18px rgba(var(--c-copper) / 0.16);
  }

  .fx-cta-sheen {
    position: relative;
    overflow: hidden;
  }

  .fx-cta-sheen::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 20%, rgba(255, 255, 255, 0.26) 48%, transparent 74%);
    transform: translateX(-145%);
    transition: transform 440ms ease;
  }

  .fx-cta-sheen:hover::after,
  .fx-cta-sheen:focus-visible::after {
    transform: translateX(140%);
  }

  .fx-cta-secondary {
    transition: background-color 220ms ease, border-color 220ms ease, transform 220ms ease;
  }

  .fx-cta-secondary:hover {
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .reveal.is-visible,
    .fx-chip,
    .fx-lift-soft,
    .fx-card-edge::before,
    .fx-image-pan img,
    .metric-value,
    .fx-cta-sheen::after,
    .fx-cta-secondary {
      transition: none;
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
  const revealGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal-group]'));

  revealGroups.forEach((group) => {
    const items = Array.from(group.querySelectorAll<HTMLElement>('[data-reveal]'));
    items.forEach((item, index) => {
      item.style.transitionDelay = `${Math.min(index * 65, 260)}ms`;
    });
  });

  if (mediaQuery.matches) {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14, rootMargin: '0px 0px -8% 0px' },
    );

    revealItems.forEach((item) => observer.observe(item));
  }
</script>
