  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .reveal.is-visible,
    .ambient-mark,
    .fx-lift-soft,
    .fx-card-edge::before,
    .fx-image-pan img,
    .procedure-media,
    .procedure-arrow,
    .metric-value,
    .fx-cta-sheen::after,
