---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { listPublicAvantApresCasesPage, type AvantApresCaseView } from '@/lib/cms/avantApres';
import { interventionCategories } from '@/lib/interventions';
import { listPublicInterventions } from '@/lib/cms/interventions';

Astro.response.headers.set('Cache-Control', 'no-store');

const interventionCategory = Astro.url.searchParams.get('intervention_category');
const interventionSlug = Astro.url.searchParams.get('intervention_slug');

type AvantApresCaseWithIntervention = AvantApresCaseView & {
  intervention_category?: string | null;
  intervention_slug?: string | null;
  description?: string | null;
  case_number?: number | null;
};
type InterventionLite = { title: string; category: string; slug: string; order?: number | null };

let cases: AvantApresCaseWithIntervention[] = [];
try {
  const pageSize = 100;
  let offset = 0;
  let total = 0;
  do {
    const page = await listPublicAvantApresCasesPage({
      interventionCategory,
      interventionSlug,
      offset,
      limit: pageSize,
    });
    cases.push(...(page.items as AvantApresCaseWithIntervention[]));
    total = page.total;
    offset += page.items.length;
    if (!page.items.length) break;
  } while (offset < total);
} catch {
  cases = [];
}

let interventions: InterventionLite[] = [];
try {
  const rows = await listPublicInterventions();
  interventions = rows.map((row) => ({
    title: row.title,
    category: row.category,
    slug: row.slug,
    order: row.order,
  }));
} catch {
  const entries = await getCollection('interventions');
  interventions = entries.map((entry) => ({
    title: entry.data.title,
    category: entry.data.category,
    slug: entry.slug.split('/').filter(Boolean).slice(-1)[0] ?? entry.slug,
    order: entry.data.order ?? null,
  }));
}

const categoryMetaByKey = new Map<string, (typeof interventionCategories)[number] & { order: number }>(
  interventionCategories.map((category, index) => [category.key, { ...category, order: index }]),
);
const interventionMetaByRef = new Map(
  interventions.map((entry) => [
    `${entry.category}::${entry.slug}`,
    {
      ...entry,
      href: `/interventions/${entry.category}/${entry.slug}`,
    },
  ]),
);

const slugify = (value: string) =>
  value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const caseCards = cases.map((item) => {
  const interventionMeta =
    item.intervention_category && item.intervention_slug
      ? interventionMetaByRef.get(`${item.intervention_category}::${item.intervention_slug}`) ?? null
      : null;
  const categoryMeta = item.intervention_category
    ? categoryMetaByKey.get(item.intervention_category) ?? null
    : null;
  const coverSet = item.media_sets?.find((set) => set.is_cover) ?? item.media_sets?.[0] ?? null;
  const contextChips: string[] = [];
  if (coverSet?.result_delay_label) contextChips.push(coverSet.result_delay_label);
  if (item.patient_context?.smoking_status === 'non_smoker') contextChips.push('Non fumeuse');
  if (item.patient_context?.smoking_status === 'smoker') contextChips.push('Fumeuse');
  if (item.patient_context?.post_bariatric) contextChips.push('Post-bariatrique');
  if (item.patient_context?.revision_case) contextChips.push('Reprise');

  return {
    ...item,
    interventionMeta,
    categoryKey: item.intervention_category ?? 'autres-resultats',
    categoryTitle: categoryMeta?.title ?? item.intervention_category ?? 'Autres résultats',
    categoryDescription: categoryMeta?.description ?? null,
    categoryOrder: categoryMeta?.order ?? 999,
    procedureKey: item.intervention_slug ?? `autres-${slugify(item.title || 'resultat-documente')}`,
    procedureTitle: interventionMeta?.title ?? item.title ?? 'Résultat documenté',
    procedureOrder: interventionMeta?.order ?? 999,
    publicTitle: item.title || interventionMeta?.title || 'Résultat documenté',
    contextChips,
    isComparison: coverSet?.media_mode === 'comparison',
  };
});

type CaseCard = (typeof caseCards)[number];
type ProcedureGroup = {
  key: string;
  title: string;
  order: number;
  href: string | null;
  cases: CaseCard[];
};
type CategoryGroup = {
  key: string;
  title: string;
  description: string | null;
  order: number;
  procedures: ProcedureGroup[];
  count: number;
};

const categoryGroupsByKey = new Map<string, CategoryGroup>();
for (const item of caseCards) {
  let categoryGroup = categoryGroupsByKey.get(item.categoryKey);
  if (!categoryGroup) {
    categoryGroup = {
      key: item.categoryKey,
      title: item.categoryTitle,
      description: item.categoryDescription,
      order: item.categoryOrder,
      procedures: [],
      count: 0,
    };
    categoryGroupsByKey.set(item.categoryKey, categoryGroup);
  }

  let procedureGroup = categoryGroup.procedures.find((group) => group.key === item.procedureKey);
  if (!procedureGroup) {
    procedureGroup = {
      key: item.procedureKey,
      title: item.procedureTitle,
      order: item.procedureOrder,
      href: item.interventionMeta?.href ?? null,
      cases: [],
    };
    categoryGroup.procedures.push(procedureGroup);
  }
  procedureGroup.cases.push(item);
  categoryGroup.count += 1;
}

const categoryGroups = Array.from(categoryGroupsByKey.values())
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title, 'fr'))
  .map((category) => ({
    ...category,
    id: `categorie-${slugify(category.key)}`,
    procedures: category.procedures
      .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title, 'fr'))
      .map((procedure) => ({
        ...procedure,
        id: `procedure-${slugify(category.key)}-${slugify(procedure.key)}`,
        cases: procedure.cases.sort(
          (a, b) =>
            (a.case_number ?? Number.MAX_SAFE_INTEGER) -
              (b.case_number ?? Number.MAX_SAFE_INTEGER) ||
            a.publicTitle.localeCompare(b.publicTitle, 'fr'),
        ),
      })),
  }));

const selectedIntervention =
  interventionCategory && interventionSlug
    ? interventionMetaByRef.get(`${interventionCategory}::${interventionSlug}`) ?? null
    : null;
const hasActiveFilter = Boolean(interventionCategory || interventionSlug);
const hasPreviewCases = caseCards.some((item) => item.id.startsWith('preview-'));
---

<BaseLayout
  title="Avant/Après"
  description="Galerie de résultats avant et après publiés avec consentement. Chaque résultat est propre au patient."
>
  <div class="bg-paper">
    <section class="border-b border-ink/10">
      <div class="mx-auto max-w-5xl px-4 py-16 text-center sm:py-24">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-copper-deep">Résultats documentés</p>
        <h1 class="mx-auto mt-5 max-w-3xl text-balance font-display text-4xl leading-none tracking-tight text-ink sm:text-6xl">
          Galerie avant & après
        </h1>
        <p class="mx-auto mt-7 max-w-3xl text-pretty text-base leading-relaxed text-ink/75 sm:text-lg">
          Découvrez une sélection de résultats classés par catégorie et par intervention. Ces cas illustrent
          des prises en charge individualisées : ils ne permettent pas de prévoir le résultat d’une autre personne.
        </p>
        <p class="mx-auto mt-4 max-w-3xl text-sm leading-relaxed text-ink/65">
          Toutes les photographies sont publiées avec le <a
            href="/consentement"
            class="link underline underline-offset-4">consentement</a
          > des patients. Les résultats varient selon l’anatomie, l’indication et les suites propres à chacun.
        </p>
      </div>
    </section>

    {categoryGroups.length ? (
      <nav class="border-b border-ink/10 bg-mist/45" aria-label="Accéder aux catégories de résultats">
        <div class="mx-auto max-w-6xl px-4 py-8 sm:py-10">
          <p class="text-center text-xs font-semibold uppercase tracking-[0.18em] text-ink/55">Explorer par catégorie</p>
          <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {categoryGroups.map((category) => (
              <a
                href={`#${category.id}`}
                class="group flex min-h-20 items-center justify-between gap-4 rounded-2xl border border-ink/10 bg-paper px-5 py-4 transition hover:border-ink/25 hover:shadow-soft focus:outline-none focus-visible:ring-2 focus-visible:ring-copper/40"
              >
                <span class="font-display text-2xl tracking-tight text-ink">{category.title}</span>
                <span class="flex items-center gap-3 text-xs font-semibold text-ink/55">
                  {category.count} {category.count > 1 ? 'cas' : 'cas'}
                  <span aria-hidden="true" class="text-lg transition-transform group-hover:translate-y-0.5">↓</span>
                </span>
              </a>
            ))}
          </div>
          {hasActiveFilter ? (
            <p class="mt-6 text-center text-sm text-ink/70">
              Vue filtrée{selectedIntervention ? ` : ${selectedIntervention.title}` : ''}.{' '}
              <a href="/avant-apres" class="link underline underline-offset-4">Afficher toute la galerie</a>
            </p>
          ) : null}
        </div>
      </nav>
    ) : null}

    {hasPreviewCases ? (
      <div class="mx-auto max-w-6xl px-4 pt-8">
        <p class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-relaxed text-amber-800">
          Certaines images sont des extraits PDF utilisés temporairement en prévisualisation, en attendant les photos haute définition.
        </p>
      </div>
    ) : null}

    {categoryGroups.length ? (
      <div class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
        {categoryGroups.map((category, categoryIndex) => (
          <section
            id={category.id}
            class:list={['scroll-mt-24', categoryIndex ? 'mt-24 border-t border-ink/10 pt-20 sm:mt-32 sm:pt-24' : '']}
            aria-labelledby={`${category.id}-title`}
          >
            <header class="max-w-3xl">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-copper-deep">Catégorie</p>
              <h2 id={`${category.id}-title`} class="mt-3 text-balance font-display text-4xl tracking-tight text-ink sm:text-5xl">
                {category.title}
              </h2>
              {category.description ? <p class="mt-4 text-base leading-relaxed text-ink/70">{category.description}</p> : null}
            </header>

            {category.procedures.length > 1 ? (
              <nav class="mt-8 flex gap-2 overflow-x-auto pb-2 no-scrollbar" aria-label={`Interventions : ${category.title}`}>
                {category.procedures.map((procedure) => (
                  <a href={`#${procedure.id}`} class="btn btn-pill btn-sm min-h-11 shrink-0 btn-secondary">
                    {procedure.title}
                  </a>
                ))}
              </nav>
            ) : null}

            <div class="mt-12 space-y-20">
              {category.procedures.map((procedure) => (
                <section id={procedure.id} class="scroll-mt-24" aria-labelledby={`${procedure.id}-title`}>
                  <div class="mb-7 flex flex-wrap items-end justify-between gap-3 border-b border-ink/10 pb-4">
                    <h3 id={`${procedure.id}-title`} class="font-display text-3xl tracking-tight text-ink sm:text-4xl">
                      {procedure.title}
                    </h3>
                    {procedure.href ? (
                      <a class="link text-sm underline underline-offset-4" href={procedure.href}>Découvrir l’intervention</a>
                    ) : null}
                  </div>

                  <div class="grid gap-7 md:grid-cols-2 md:gap-8">
                    {procedure.cases.map((item) => (
                      <article class="group overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-soft transition-shadow hover:shadow-lift">
                        <a
                          href={`/avant-apres/${item.id}`}
                          class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-copper/50"
                          aria-label={`Voir le cas : ${item.publicTitle}`}
                        >
                          {item.isComparison ? (
                            <div class="relative flex aspect-[5/4] items-center justify-center overflow-hidden bg-mist/55">
                              <img
                                src={item.beforeUrl}
                                alt="Photographie comparative avant et après intervention"
                                class="h-full w-full object-contain"
                                loading="lazy"
                              />
                              <span class="absolute left-3 top-3 rounded-full bg-paper/90 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/75 sm:left-4 sm:top-4">
                                Avant / Après
                              </span>
                            </div>
                          ) : (
                            <div class="grid aspect-[5/4] grid-cols-2 bg-mist/55">
                              <div class="relative overflow-hidden border-r border-paper/50">
                                <img src={item.beforeUrl} alt="Avant" class="h-full w-full object-cover" loading="lazy" />
                                <span class="absolute left-3 top-3 rounded-full bg-paper/90 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/75 sm:left-4 sm:top-4 sm:px-3">
                                  Avant
                                </span>
                              </div>
                              <div class="relative overflow-hidden">
                                <img
                                  src={item.afterUrl}
                                  alt="Après"
                                  class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.02]"
                                  loading="lazy"
                                />
                                <span class="absolute left-3 top-3 rounded-full bg-paper/90 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-ink/75 sm:left-4 sm:top-4 sm:px-3">
                                  Après
                                </span>
                              </div>
                            </div>
                          )}

                          <div class="flex items-start justify-between gap-4 p-5 sm:p-6">
                            <div>
                              {item.case_number ? (
                                <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-copper-deep">Cas n° {item.case_number}</p>
                              ) : null}
                              <h4 class:list={['text-balance font-display text-2xl tracking-tight text-ink', item.case_number ? 'mt-2' : '']}>
                                {item.publicTitle}
                              </h4>
                              {item.description ? <p class="mt-3 text-sm leading-relaxed text-ink/70">{item.description}</p> : null}
                              {item.contextChips.length ? (
                                <div class="mt-4 flex flex-wrap gap-2">
                                  {item.contextChips.slice(0, 4).map((chip) => (
                                    <span class="rounded-full border border-ink/10 bg-mist/70 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-ink/65">
                                      {chip}
                                    </span>
                                  ))}
                                </div>
                              ) : null}
                            </div>
                            <span class="mt-1 inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-ink/15 text-ink/55 transition group-hover:border-ink/35 group-hover:text-ink" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4">
                                <path d="M8 16 16 8M9 8h7v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                              </svg>
                            </span>
                          </div>
                        </a>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </section>
        ))}

        <aside class="mt-20 rounded-3xl border border-ink/10 bg-mist/60 px-6 py-7 sm:mt-28 sm:px-8" aria-label="Information importante">
          <p class="text-sm leading-relaxed text-ink/75">
            Ces photographies illustrent des cas précis et ne constituent ni une garantie de résultat ni un avis médical personnalisé.
            Une consultation est nécessaire pour évaluer votre situation et discuter des options adaptées.
          </p>
        </aside>
      </div>
    ) : (
      <section class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
        <div class="rounded-3xl border border-ink/10 bg-mist/60 p-8 text-center sm:p-12">
          <h2 class="font-display text-3xl tracking-tight text-ink">
            {hasActiveFilter ? 'Aucun cas publié dans cette sélection' : 'Galerie en cours de préparation'}
          </h2>
          <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-ink/70">
            {hasActiveFilter
              ? 'Aucun résultat consenti et publié ne correspond actuellement à cette catégorie ou à cette intervention.'
              : 'Les cas apparaîtront ici une fois leur sélection finalisée et leur consentement de publication confirmé.'}
          </p>
          {hasActiveFilter ? <a href="/avant-apres" class="btn btn-pill btn-md btn-secondary mt-6">Voir toute la galerie</a> : null}
        </div>
      </section>
    )}

    <section class="bg-ink text-paper">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:py-16">
        <div class="flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-end">
          <div class="max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-paper/60">Consultation personnalisée</p>
            <h2 class="mt-3 text-balance font-display text-3xl leading-tight tracking-tight sm:text-4xl">Parler de votre projet avec le Dr Soussi</h2>
            <p class="mt-4 text-sm leading-relaxed text-paper/75">L’indication, les possibilités et les limites sont évaluées individuellement en consultation.</p>
          </div>
          <a href="/contact" class="btn btn-pill btn-lg shrink-0 bg-paper text-ink hover:bg-paper/90">Prendre rendez-vous</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
