---
import CmsLayout from '@/layouts/CmsLayout.astro';
import { interventionCategories } from '@/lib/interventions';
import { defaultInterventionMarkdownTemplate } from '@/lib/cms/interventionTemplate';

Astro.response.headers.set('Cache-Control', 'no-store');

const template = defaultInterventionMarkdownTemplate();
---

<CmsLayout title="Nouvelle intervention">
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <section class="cms-card p-7">
      <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Intervention</div>
      <h1 class="mt-2 font-display text-3xl tracking-tight">Nouvelle fiche</h1>

      <form id="intervention-form" class="mt-8 grid gap-5">
        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">Titre</span>
          <input class="cms-input" name="title" placeholder="Titre de l’intervention" autocomplete="off" />
        </label>
        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">Description courte</span>
          <textarea rows={3} class="cms-textarea" name="description"></textarea>
        </label>
        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">Categorie</span>
          <select class="cms-select" name="category">
            {interventionCategories.map((c) => (
              <option value={c.key}>{c.key}</option>
            ))}
          </select>
        </label>
        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">Ordre</span>
          <input class="cms-input" name="order" placeholder="1" inputmode="numeric" />
        </label>
        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">Slug (URL)</span>
          <input class="cms-input" name="slug" placeholder="ex: injection-toxine-botulique" autocomplete="off" />
          <span class="text-xs text-ink/50">Généré automatiquement à partir du titre (modifiable avant création).</span>
        </label>

        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">SEO Title (optionnel)</span>
          <input class="cms-input" name="seo_title" placeholder="ex: Injection de toxine botulique à Tunis" />
        </label>
        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">SEO Description (optionnel)</span>
          <textarea rows={2} class="cms-textarea" name="seo_description"></textarea>
        </label>

        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">Contenu (Markdown)</span>
          <textarea rows={14} class="cms-textarea" name="body_md">{template}</textarea>
        </label>
      </form>
    </section>

    <aside class="cms-panel p-6">
      <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Publication</div>
      <div class="mt-4 grid gap-3">
        <label class="flex items-center justify-between rounded-2xl border border-ink/10 bg-paper px-4 py-3 text-sm">
          <span>Statut</span>
          <select class="bg-transparent text-sm">
            <option>Brouillon</option>
            <option>Publie</option>
          </select>
        </label>
        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">Slug</span>
          <input class="cms-input" placeholder="ex: blepharoplastie" />
        </label>
      </div>

      <div class="mt-6 space-y-3">
        <button
          type="submit"
          value="draft"
          name="intent"
          form="intervention-form"
          class="btn btn-pill btn-md btn-primary w-full"
        >
          Enregistrer brouillon
        </button>
        <button
          type="submit"
          value="publish"
          name="intent"
          form="intervention-form"
          class="btn btn-pill btn-md btn-secondary w-full"
        >
          Publier
        </button>
      </div>
      <div id="intervention-status" class="mt-4 text-xs text-ink/60"></div>
      <div id="intervention-error" class="mt-2 text-xs text-rose-600"></div>
    </aside>
  </div>
</CmsLayout>

<script is:inline>
  (() => {
    const form = document.getElementById('intervention-form');
    const status = document.getElementById('intervention-status');
    const error = document.getElementById('intervention-error');
    if (!(form instanceof HTMLFormElement)) return;

    const slugify = (value) =>
      String(value || '')
        .toLowerCase()
        .trim()
        .replace(/[’']/g, '')
        .replace(/\s+/g, '-')
        .replace(/[^a-z0-9-]/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');

    const titleInput = form.querySelector('input[name="title"]');
    const slugInput = form.querySelector('input[name="slug"]');
    let slugTouched = false;
    if (slugInput instanceof HTMLInputElement) {
      slugInput.addEventListener('input', () => {
        slugTouched = true;
      });
    }
    if (titleInput instanceof HTMLInputElement && slugInput instanceof HTMLInputElement) {
      titleInput.addEventListener('input', () => {
        if (slugTouched && slugInput.value.trim()) return;
        slugInput.value = slugify(titleInput.value);
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (error) error.textContent = '';
      if (status) status.textContent = 'Enregistrement...';

      const submitter = event.submitter;
      const intent = submitter && submitter instanceof HTMLButtonElement ? submitter.value : 'draft';

      const formData = new FormData(form);
      const payload = {
        title: String(formData.get('title') ?? '').trim(),
        description: String(formData.get('description') ?? '').trim(),
        category: String(formData.get('category') ?? '').trim(),
        order: String(formData.get('order') ?? '').trim(),
        slug: String(formData.get('slug') ?? '').trim(),
        seo_title: String(formData.get('seo_title') ?? '').trim(),
        seo_description: String(formData.get('seo_description') ?? '').trim(),
        body_md: String(formData.get('body_md') ?? ''),
        status: intent === 'publish' ? 'publie' : 'brouillon'
      };

      if (!payload.slug) payload.slug = slugify(payload.title);

      try {
        const res = await fetch('/api/cms/interventions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (!res.ok) {
          const text = await res.text().catch(() => '');
          throw new Error(text || 'save');
        }
        const data = await res.json();
        if (status) status.textContent = 'Enregistré.';
        window.location.href = `/cms/interventions/${encodeURIComponent(data.slug)}`;
      } catch (err) {
        const msg = String(err && err.message ? err.message : 'Erreur');
        if (error) error.textContent = msg === 'Slug already exists' ? 'Slug déjà utilisé.' : 'Erreur de sauvegarde.';
        if (status) status.textContent = '';
      }
    });
  })();
</script>
