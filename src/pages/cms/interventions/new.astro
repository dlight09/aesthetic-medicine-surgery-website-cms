---
import CmsLayout from '@/layouts/CmsLayout.astro';
import { interventionCategories } from '@/lib/interventions';
import { defaultSeoTemplateData } from '@/lib/cms/interventionSeoTemplate';

Astro.response.headers.set('Cache-Control', 'no-store');

const defaultSeo = defaultSeoTemplateData();
const sectionLabels = [
  { key: '01', label: "Qu'est-ce que..." },
  { key: '02', label: 'Etes-vous une bonne candidate ?' },
  { key: '03', label: 'La consultation' },
  { key: '04', label: 'Preparation pre-operatoire' },
  { key: '05', label: "L'intervention" },
  { key: '06', label: 'Hospitalisation' },
  { key: '07', label: 'Suites operatoires' },
  { key: '08', label: 'Resultats' },
  { key: '09', label: 'Risques et complications' },
] as const;
---

<CmsLayout title="Nouvelle intervention">
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_280px]">
    <form id="intervention-form" class="cms-card p-7 space-y-4">
      <input type="hidden" name="template_kind" value="seo_v2" />
      <input type="hidden" name="content_blocks" value="[]" />
      <input type="hidden" name="body_md" value="" />
      <input type="hidden" name="category" value={interventionCategories[0]?.key ?? 'visage'} />
      <input type="hidden" name="seo_title" value="" />
      <input type="hidden" name="seo_description" value="" />
      <input type="hidden" name="status" value="brouillon" />
      <input type="hidden" name="description" value="" />
      <input type="hidden" name="slug" value="" />

      <details id="sec-general" data-accordion open class="rounded-2xl border border-ink/10 bg-paper">
        <summary class="cursor-pointer px-4 py-3 font-semibold">General</summary>
        <div class="grid gap-3 border-t border-ink/10 p-4">
          <label class="grid gap-2 text-sm"><span>Titre</span><input class="cms-input" name="title" /></label>
          <label class="grid gap-2 text-sm"><span>Introduction</span><textarea rows={5} class="cms-textarea" name="seo_intro"></textarea></label>
        </div>
      </details>

      <details id="sec-facts" data-accordion class="rounded-2xl border border-ink/10 bg-paper">
        <summary class="cursor-pointer px-4 py-3 font-semibold">Quick Facts</summary>
        <div class="grid gap-3 border-t border-ink/10 p-4 sm:grid-cols-2">
          {[0, 1, 2, 3].map((idx) => (
            <div class="rounded-xl border border-ink/10 bg-mist/20 p-3">
              <label class="grid gap-2 text-sm"><span>Valeur {idx + 1}</span><input class="cms-input" name={`qf_value_${idx}`} value={defaultSeo.quickFacts[idx].value} /></label>
            </div>
          ))}
        </div>
      </details>

      {sectionLabels.map((s, idx) => (
        <details id={`sec-${s.key}`} data-accordion class="rounded-2xl border border-ink/10 bg-paper">
          <summary class="cursor-pointer px-4 py-3 font-semibold">{s.key} - {s.label}</summary>
          <div class="grid gap-3 border-t border-ink/10 p-4">
            <label class="grid gap-2 text-sm"><span>Titre</span><input class="cms-input" name={`section_heading_${s.key}`} value={defaultSeo.sections[idx].heading} /></label>
            <label class="grid gap-2 text-sm"><span>Paragraphes (1 par ligne)</span><textarea rows={4} class="cms-textarea" name={`section_paragraphs_${s.key}`}></textarea></label>
            <label class="grid gap-2 text-sm"><span>Puces (1 par ligne)</span><textarea rows={4} class="cms-textarea" name={`section_bullets_${s.key}`}></textarea></label>
            {(s.key === '01' || s.key === '02' || s.key === '03' || s.key === '05') && (
              <>
                <label class="grid gap-2 text-sm"><span>Note encadree</span><textarea rows={3} class="cms-textarea" name={`section_callout_text_${s.key}`}></textarea></label>
                <label class="grid gap-2 text-sm"><span>Style note</span><select class="cms-select" name={`section_callout_tone_${s.key}`}><option value="info">Info</option><option value="warning">Alerte</option></select></label>
              </>
            )}
            {s.key === '04' ? <label class="grid gap-2 text-sm"><span>Tableau (Label: Texte)</span><textarea rows={6} class="cms-textarea" name="section_rows_04"></textarea></label> : null}
            {s.key === '07' ? <label class="grid gap-2 text-sm"><span>Timeline (Phase: Texte)</span><textarea rows={6} class="cms-textarea" name="section_steps_07"></textarea></label> : null}
            {s.key === '09' ? <><label class="grid gap-2 text-sm"><span>Risques generaux</span><textarea rows={5} class="cms-textarea" name="section_general_risks_09"></textarea></label><label class="grid gap-2 text-sm"><span>Risques specifiques</span><textarea rows={5} class="cms-textarea" name="section_specific_risks_09"></textarea></label></> : null}
          </div>
        </details>
      ))}

      <details id="sec-faq" data-accordion class="rounded-2xl border border-ink/10 bg-paper">
        <summary class="cursor-pointer px-4 py-3 font-semibold">10 - FAQ</summary>
        <div id="faq-list" class="space-y-3 border-t border-ink/10 p-4">
          {[0, 1, 2].map((idx) => (
            <div class="rounded-xl border border-ink/10 bg-mist/20 p-3">
              <label class="grid gap-2 text-sm"><span>Question</span><input class="cms-input" name={`faq_question_${idx}`} /></label>
              <label class="mt-2 grid gap-2 text-sm"><span>Reponse</span><textarea rows={3} class="cms-textarea" name={`faq_answer_${idx}`}></textarea></label>
            </div>
          ))}
        </div>
        <div class="px-4 pb-4"><button type="button" id="faq-add" class="btn btn-pill btn-sm btn-secondary">Ajouter question</button></div>
      </details>
    </form>

    <aside class="cms-panel p-5 sticky top-24 h-max">
      <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Navigation</div>
      <nav class="mt-3 grid gap-1 text-sm">
        <a class="link" href="#sec-general">General</a>
        <a class="link" href="#sec-facts">Quick facts</a>
        {sectionLabels.map((s) => <a class="link" href={`#sec-${s.key}`}>{s.key}</a>)}
        <a class="link" href="#sec-faq">FAQ</a>
      </nav>
      <div class="mt-5 grid gap-2">
        <button type="submit" value="draft" name="intent" form="intervention-form" class="btn btn-pill btn-md btn-primary">Enregistrer brouillon</button>
        <button type="submit" value="publish" name="intent" form="intervention-form" class="btn btn-pill btn-md btn-secondary">Publier</button>
      </div>
      <div id="intervention-status" class="mt-3 text-xs text-ink/60"></div>
      <div id="intervention-error" class="mt-2 text-xs text-rose-600"></div>
    </aside>
  </div>
</CmsLayout>

<script is:inline>
  (() => {
    const form = document.getElementById('intervention-form');
    const statusEl = document.getElementById('intervention-status');
    const errorEl = document.getElementById('intervention-error');
    if (!(form instanceof HTMLFormElement)) return;

    const panels = Array.from(document.querySelectorAll('details[data-accordion]'));
    panels.forEach((panel) => {
      panel.addEventListener('toggle', () => {
        if (!(panel instanceof HTMLDetailsElement) || !panel.open) return;
        panels.forEach((other) => {
          if (other !== panel && other instanceof HTMLDetailsElement) other.open = false;
        });
      });
    });

    const faqList = document.getElementById('faq-list');
    const addFaq = document.getElementById('faq-add');
    if (faqList instanceof HTMLElement && addFaq instanceof HTMLButtonElement) {
      addFaq.addEventListener('click', () => {
        const idx = faqList.querySelectorAll('[data-faq-item]').length;
        const card = document.createElement('div');
        card.setAttribute('data-faq-item', '1');
        card.className = 'rounded-xl border border-ink/10 bg-mist/20 p-3';
        card.innerHTML = `<label class="grid gap-2 text-sm"><span>Question</span><input class="cms-input" name="faq_question_${idx}" /></label><label class="mt-2 grid gap-2 text-sm"><span>Reponse</span><textarea rows="3" class="cms-textarea" name="faq_answer_${idx}"></textarea></label>`;
        faqList.appendChild(card);
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (errorEl) errorEl.textContent = '';
      if (statusEl) statusEl.textContent = 'Enregistrement...';
      const submitter = event.submitter;
      const intent = submitter && submitter instanceof HTMLButtonElement ? submitter.value : 'draft';
      const formData = new FormData(form);
      const toLines = (value) => String(value || '').split('\n').map((x) => x.trim()).filter(Boolean);
      const sectionKeys = ['01', '02', '03', '04', '05', '06', '07', '08', '09'];
      const parseLabeledRows = (value, keyName, valueName) => toLines(value).map((line) => {
        const idx = line.indexOf(':');
        if (idx <= 0) return null;
        return { [keyName]: line.slice(0, idx).trim(), [valueName]: line.slice(idx + 1).trim() };
      }).filter(Boolean);
      const faq = [];
      for (const [k, v] of formData.entries()) {
        if (!String(k).startsWith('faq_question_')) continue;
        const idx = String(k).replace('faq_question_', '');
        const q = String(v || '').trim();
        const a = String(formData.get(`faq_answer_${idx}`) || '').trim();
        if (q || a) faq.push({ question: q, answer: a });
      }
      const title = String(formData.get('title') ?? '').trim();
      const category = String(formData.get('category') ?? '').trim();
      const fixedQuickFactLabels = ['Durée', 'Anesthésie', 'Hospitalisation', 'Résultat définitif'];
      const seo_page_data = {
        breadcrumb: `Interventions › ${category} › ${title}`,
        categoryLabel: '',
        h1: String(formData.get('seo_h1') ?? '').trim() || title,
        intro: String(formData.get('seo_intro') ?? '').trim(),
        hero: { imageSrc: '', imageAlt: '' },
        quickFacts: [0, 1, 2, 3].map((idx) => ({ value: String(formData.get(`qf_value_${idx}`) ?? '').trim(), label: fixedQuickFactLabels[idx] })),
        sections: sectionKeys.map((key) => {
          const noteText = String(formData.get(`section_callout_text_${key}`) ?? '').trim();
          const noteTone = String(formData.get(`section_callout_tone_${key}`) ?? 'info') === 'warning' ? 'warning' : 'info';
          return {
            key,
            heading: String(formData.get(`section_heading_${key}`) ?? '').trim(),
            paragraphs: toLines(formData.get(`section_paragraphs_${key}`)),
            bullets: toLines(formData.get(`section_bullets_${key}`)),
            rows: key === '04' ? parseLabeledRows(formData.get('section_rows_04'), 'label', 'text') : [],
            steps: key === '07' ? parseLabeledRows(formData.get('section_steps_07'), 'phase', 'text') : [],
            callout: noteText ? { tone: noteTone, text: noteText } : null,
            generalRisks: key === '09' ? toLines(formData.get('section_general_risks_09')) : [],
            specificRisks: key === '09' ? toLines(formData.get('section_specific_risks_09')) : [],
          };
        }),
        faq,
      };
      const payload = {
        title,
        description: String(formData.get('description') ?? '').trim() || String(formData.get('seo_intro') ?? '').trim(),
        category,
        order: '',
        slug: String(formData.get('slug') ?? '').trim(),
        seo_title: String(formData.get('seo_title') ?? '').trim(),
        seo_description: String(formData.get('seo_description') ?? '').trim(),
        template_kind: 'seo_v2',
        hero_image_src: '',
        hero_image_alt: '',
        seo_page_data,
        body_md: '',
        content_blocks: [],
        status: intent === 'publish' ? 'publie' : 'brouillon',
      };
      try {
        const res = await fetch('/api/cms/interventions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (!res.ok) throw new Error(await res.text().catch(() => 'save'));
        if (statusEl) statusEl.textContent = intent === 'publish' ? 'Publié.' : 'Brouillon enregistré.';
        const created = await res.json().catch(() => null);
        if (created?.slug) window.location.href = `/cms/interventions/${created.slug}`;
      } catch {
        if (errorEl) errorEl.textContent = 'Erreur de sauvegarde.';
        if (statusEl) statusEl.textContent = '';
      }
    });
  })();
</script>
