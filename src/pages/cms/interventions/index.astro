---
import CmsLayout from '@/layouts/CmsLayout.astro';
import { listCmsInterventions } from '@/lib/cms/interventions';
import { interventionCategoryMeta, type InterventionCategoryKey } from '@/lib/interventions';

Astro.response.headers.set('Cache-Control', 'no-store');

const items = await listCmsInterventions();

const statusClass = (status: string) =>
  status === 'publie' ? 'bg-emerald-100 text-emerald-700' : 'bg-ink/10 text-ink/70';

const formatStatus = (status: string) => (status === 'publie' ? 'Publié' : 'Brouillon');
const categoryLabel = (key: InterventionCategoryKey) => interventionCategoryMeta[key]?.title ?? key;
---

<CmsLayout title="Interventions">
  <div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Fiches</div>
        <h1 class="mt-1 font-display text-3xl tracking-tight">Interventions</h1>
      </div>
      <a href="/cms/interventions/new" class="btn btn-pill btn-sm btn-primary">Nouvelle intervention</a>
    </div>

    <div class="cms-card shadow-soft">
      <div class="grid grid-cols-[1.4fr_1fr_0.6fr_0.6fr] gap-4 border-b border-ink/10 px-6 py-4 text-xs font-semibold uppercase tracking-wide text-ink/50">
        <div>Titre</div>
        <div>Categorie</div>
        <div>Ordre</div>
        <div>Statut</div>
      </div>
      <div class="divide-y divide-ink/5">
        {items.length ? (
          items.map((item) => (
            <a
              href={`/cms/interventions/${item.slug}`}
              class="cms-row grid grid-cols-[1.4fr_1fr_0.6fr_0.6fr] gap-4 px-6 py-4 text-sm"
            >
              <div class="font-semibold text-ink/90">{item.title}</div>
              <div class="text-ink/70">{categoryLabel(item.category)}</div>
              <div class="text-ink/70">{item.order ?? '—'}</div>
              <div>
                <span class:list={['cms-pill', statusClass(item.status)]}>{formatStatus(item.status)}</span>
              </div>
            </a>
          ))
        ) : (
          <div class="px-6 py-6 text-sm text-ink/60">Aucune intervention. Créez la première fiche.</div>
        )}
      </div>
    </div>
  </div>
</CmsLayout>
