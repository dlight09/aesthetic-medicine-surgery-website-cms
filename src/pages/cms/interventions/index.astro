---
import CmsLayout from '@/layouts/CmsLayout.astro';
import { listCmsInterventions } from '@/lib/cms/interventions';
import { interventionCategoryMeta, type InterventionCategoryKey } from '@/lib/interventions';

Astro.response.headers.set('Cache-Control', 'no-store');

const items = await listCmsInterventions();

const statusClass = (status: string) =>
  status === 'publie' ? 'bg-emerald-100 text-emerald-700' : 'bg-ink/10 text-ink/70';

const formatStatus = (status: string) => (status === 'publie' ? 'Publié' : 'Brouillon');
const categoryLabel = (key: InterventionCategoryKey) => interventionCategoryMeta[key]?.title ?? key;
---

<CmsLayout title="Interventions">
  <div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Fiches</div>
        <h1 class="mt-1 font-display text-3xl tracking-tight">Interventions</h1>
      </div>
      <a href="/cms/interventions/new" class="btn btn-pill btn-sm btn-primary">Nouvelle intervention</a>
    </div>

    <div class="cms-card shadow-soft p-4 sm:p-5">
      <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_220px_170px]">
        <input id="q" class="cms-input" placeholder="Rechercher: titre ou slug" />
        <select id="category" class="cms-select">
          <option value="">Toutes les catégories</option>
          {Array.from(new Set(items.map((i) => i.category))).map((key) => (
            <option value={key}>{categoryLabel(key)}</option>
          ))}
        </select>
        <select id="status" class="cms-select">
          <option value="">Tous les statuts</option>
          <option value="publie">Publié</option>
          <option value="brouillon">Brouillon</option>
        </select>
      </div>
      <div class="mt-3 flex items-center justify-between text-xs text-ink/60">
        <div id="results-count">{items.length} interventions</div>
        <button id="clear-filters" type="button" class="btn btn-pill btn-sm btn-secondary">Effacer filtres</button>
      </div>
    </div>

    <div id="interventions-list" class="grid gap-3">
      {items.length ? (
        items.map((item) => (
          <a
            href={`/cms/interventions/${item.slug}`}
            class="cms-card p-4 sm:p-5 hover:border-ink/20 transition"
            data-item
            data-title={item.title.toLowerCase()}
            data-slug={item.slug.toLowerCase()}
            data-category={item.category}
            data-status={item.status}
          >
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <div class="truncate font-semibold text-ink/90">{item.title}</div>
                <div class="mt-1 truncate text-xs text-ink/55">/{item.slug}</div>
              </div>
              <span class="text-ink/35">→</span>
            </div>
            <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
              <span class="cms-pill bg-ink/10 text-ink/75">{categoryLabel(item.category)}</span>
              <span class:list={['cms-pill', statusClass(item.status)]}>{formatStatus(item.status)}</span>
              <span class="text-ink/50">Maj {new Date(item.updated_at).toLocaleDateString('fr-FR')}</span>
              <span class="text-ink/35">•</span>
              <span class="text-ink/70">Voir page: /interventions/{item.category}/{item.slug}</span>
            </div>
            <div class="mt-2">
              <span class="inline-flex items-center rounded-full border border-ink/15 px-2 py-1 text-[11px] font-semibold text-ink/75">
                Ouvrir éditeur, puis prévisualiser
              </span>
            </div>
          </a>
        ))
      ) : (
        <div class="cms-card p-6 text-sm text-ink/60">Aucune intervention. Créez la première fiche.</div>
      )}
    </div>
    <div id="empty-filters" class="cms-card p-6 text-sm text-ink/60 hidden">Aucun résultat pour ces filtres.</div>
  </div>
</CmsLayout>

<script is:inline>
  (() => {
    const q = document.getElementById('q');
    const category = document.getElementById('category');
    const status = document.getElementById('status');
    const clearBtn = document.getElementById('clear-filters');
    const items = Array.from(document.querySelectorAll('[data-item]'));
    const countEl = document.getElementById('results-count');
    const emptyEl = document.getElementById('empty-filters');
    if (!(q instanceof HTMLInputElement) || !(category instanceof HTMLSelectElement) || !(status instanceof HTMLSelectElement)) return;

    const run = () => {
      const term = q.value.trim().toLowerCase();
      const cat = category.value;
      const st = status.value;
      let visible = 0;
      items.forEach((el) => {
        const title = (el.getAttribute('data-title') || '');
        const slug = (el.getAttribute('data-slug') || '');
        const itemCat = (el.getAttribute('data-category') || '');
        const itemSt = (el.getAttribute('data-status') || '');
        const okTerm = !term || title.includes(term) || slug.includes(term);
        const okCat = !cat || itemCat === cat;
        const okSt = !st || itemSt === st;
        const show = okTerm && okCat && okSt;
        el.style.display = show ? '' : 'none';
        if (show) visible += 1;
      });
      if (countEl) countEl.textContent = `${visible} intervention${visible > 1 ? 's' : ''}`;
      if (emptyEl) emptyEl.classList.toggle('hidden', visible > 0);
    };

    q.addEventListener('input', run);
    category.addEventListener('change', run);
    status.addEventListener('change', run);
    if (clearBtn instanceof HTMLButtonElement) {
      clearBtn.addEventListener('click', () => {
        q.value = '';
        category.value = '';
        status.value = '';
        run();
      });
    }
    run();
  })();
</script>
