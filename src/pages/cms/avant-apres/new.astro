---
import CmsLayout from '@/layouts/CmsLayout.astro';
import { interventionCategories } from '@/lib/interventions';
import { listCmsInterventions } from '@/lib/cms/interventions';
import { getCollection } from 'astro:content';

type InterventionLite = { title: string; slug: string; category: string; order?: number | null };

let interventions: InterventionLite[] = [];
try {
  const rows = await listCmsInterventions();
  interventions = rows.map((row) => ({
    title: row.title,
    slug: row.slug,
    category: row.category,
    order: row.order,
  }));
} catch {
  const entries = await getCollection('interventions');
  interventions = entries.map((entry) => ({
    title: entry.data.title,
    slug: entry.slug.split('/').filter(Boolean).slice(-1)[0] ?? entry.slug,
    category: entry.data.category,
    order: entry.data.order ?? null,
  }));
}

const preselectedRef = Astro.url.searchParams.get('intervention_ref') ?? '';
const interventionsByCategory = interventionCategories.map((category) => ({
  label: category.title,
  items: interventions
    .filter((entry) => entry.category === category.key)
    .sort((a, b) => (a.order ?? 999) - (b.order ?? 999)),
}));
---

<CmsLayout title="Nouveau cas">
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <section class="cms-card p-7">
      <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Avant/Après</div>
      <h1 class="mt-2 font-display text-3xl tracking-tight">Nouveau cas</h1>

      <form id="aa-form" class="mt-8 grid gap-5">
        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">Intervention associée</span>
          <select class="cms-select" name="intervention_ref" required>
            <option value="">Sélectionner une intervention</option>
            {interventionsByCategory.map((group) => (
              <optgroup label={group.label}>
                {group.items.map((item) => (
                  <option
                    value={`${item.category}::${item.slug}`}
                    selected={preselectedRef === `${item.category}::${item.slug}`}
                  >
                    {item.title}
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
          <span class="text-xs text-ink/50">Le titre reprend l’intervention sélectionnée.</span>
        </label>

        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">Numéro du cas</span>
          <div class="cms-input flex items-center text-sm text-ink/70" data-case-display>-</div>
          <span class="text-xs text-ink/50">Attribué automatiquement selon l’intervention.</span>
        </label>

        <div class="rounded-2xl border border-ink/10 bg-mist p-4">
          <div class="text-sm font-semibold text-ink/80">Image avant / après fusionnée</div>
          <p class="mt-1 text-xs text-ink/50">Une seule image contenant la composition avant et après.</p>
          <div data-placeholder class="mt-3 flex h-56 items-center justify-center rounded-xl border border-dashed border-ink/20 bg-paper text-xs text-ink/40">
            Aperçu de la composition
          </div>
          <img data-preview class="mt-3 hidden h-56 w-full rounded-xl object-contain bg-paper" alt="Composition avant et après" />
          <input type="file" accept="image/jpeg,image/png,image/webp" class="mt-3 block text-xs" data-upload required />
          <div class="mt-2 text-[11px] text-ink/50">JPG, PNG ou WebP, 10 Mo max.</div>
          <div data-upload-status class="mt-1 text-[11px] text-ink/60"></div>
          <div data-upload-error class="mt-1 text-[11px] text-rose-600"></div>
          <input type="hidden" name="comparison_path" data-path />
        </div>

        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">Description courte</span>
          <textarea rows={3} class="cms-textarea" name="description" maxlength="500"></textarea>
        </label>
      </form>
    </section>

    <aside class="cms-panel p-6">
      <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Consentement</div>
      <label class="mt-3 flex items-center gap-2 text-sm">
        <input type="checkbox" class="h-4 w-4" name="consent" form="aa-form" />
        <span>Consentement obtenu</span>
      </label>
      <label class="mt-4 grid gap-2 text-sm">
        <span class="font-semibold text-ink/80">Date du consentement</span>
        <input type="date" class="cms-input" name="consent_date" form="aa-form" />
      </label>

      <div class="mt-6 space-y-3">
        <button type="submit" value="draft" form="aa-form" data-submit class="btn btn-pill btn-md btn-primary w-full disabled:cursor-not-allowed disabled:opacity-60">
          Enregistrer brouillon
        </button>
        <button type="submit" value="publish" form="aa-form" data-submit class="btn btn-pill btn-md btn-secondary w-full disabled:cursor-not-allowed disabled:opacity-60">
          Publier
        </button>
      </div>
      <div id="aa-status" class="mt-4 text-xs text-ink/60"></div>
      <div id="aa-error" class="mt-2 text-xs text-rose-600"></div>
    </aside>
  </div>
</CmsLayout>

<script is:inline>
  (() => {
    const form = document.getElementById('aa-form');
    const error = document.getElementById('aa-error');
    const status = document.getElementById('aa-status');
    if (!(form instanceof HTMLFormElement)) return;

    const interventionSelect = form.querySelector('select[name="intervention_ref"]');
    const caseDisplay = form.querySelector('[data-case-display]');
    const uploadInput = form.querySelector('[data-upload]');
    const pathInput = form.querySelector('[data-path]');
    const uploadStatus = form.querySelector('[data-upload-status]');
    const uploadError = form.querySelector('[data-upload-error]');
    const submitButtons = document.querySelectorAll('[data-submit]');

    const setSubmittingDisabled = (disabled) => {
      submitButtons.forEach((button) => {
        if (button instanceof HTMLButtonElement) button.disabled = disabled;
      });
    };

    const refreshCaseNumber = async () => {
      if (!(interventionSelect instanceof HTMLSelectElement) || !(caseDisplay instanceof HTMLElement)) return;
      if (!interventionSelect.value) {
        caseDisplay.textContent = '-';
        return;
      }
      try {
        const response = await fetch('/api/cms/avant-apres');
        if (!response.ok) throw new Error('fetch');
        const items = await response.json();
        const [category, slug] = interventionSelect.value.split('::');
        const numbers = items
          .filter((item) => item.intervention_category === category && item.intervention_slug === slug)
          .map((item) => Number(item.case_number))
          .filter((number) => Number.isFinite(number));
        const nextNumber = (numbers.length ? Math.max(...numbers) : 0) + 1;
        caseDisplay.textContent = `Cas ${String(nextNumber).padStart(2, '0')}`;
      } catch {
        caseDisplay.textContent = '-';
      }
    };

    if (interventionSelect instanceof HTMLSelectElement) {
      interventionSelect.addEventListener('change', refreshCaseNumber);
      refreshCaseNumber();
    }

    if (uploadInput instanceof HTMLInputElement) {
      uploadInput.addEventListener('change', async () => {
        const file = uploadInput.files?.[0];
        if (!file) return;
        if (uploadError instanceof HTMLElement) uploadError.textContent = '';
        if (file.size > 10 * 1024 * 1024) {
          if (uploadError instanceof HTMLElement) uploadError.textContent = 'Fichier trop lourd (10 Mo max).';
          uploadInput.value = '';
          return;
        }
        try {
          setSubmittingDisabled(true);
          if (uploadStatus instanceof HTMLElement) uploadStatus.textContent = 'Upload en cours...';
          const response = await fetch('/api/cms/avant-apres/upload-url', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fileName: file.name, kind: 'comparison', contentType: file.type, byteSize: file.size }),
          });
          if (!response.ok) throw new Error('upload-url');
          const data = await response.json();
          const uploadResponse = await fetch(data.signedUrl, {
            method: 'PUT',
            headers: { 'Content-Type': file.type },
            body: file,
          });
          if (!uploadResponse.ok) throw new Error('upload');
          if (pathInput instanceof HTMLInputElement) pathInput.value = data.path;
          const preview = form.querySelector('[data-preview]');
          const placeholder = form.querySelector('[data-placeholder]');
          if (preview instanceof HTMLImageElement) {
            preview.src = URL.createObjectURL(file);
            preview.classList.remove('hidden');
          }
          if (placeholder instanceof HTMLElement) placeholder.classList.add('hidden');
          if (uploadStatus instanceof HTMLElement) uploadStatus.textContent = 'Upload terminé.';
        } catch {
          if (uploadStatus instanceof HTMLElement) uploadStatus.textContent = '';
          if (uploadError instanceof HTMLElement) uploadError.textContent = "Erreur d'upload. Vérifiez votre connexion.";
        } finally {
          setSubmittingDisabled(false);
        }
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitter = event.submitter;
      const intent = submitter instanceof HTMLButtonElement ? submitter.value : 'draft';
      const formData = new FormData(form);
      const interventionRef = String(formData.get('intervention_ref') ?? '').trim();
      const comparisonPath = String(formData.get('comparison_path') ?? '').trim();
      const title = interventionSelect instanceof HTMLSelectElement
        ? interventionSelect.selectedOptions[0]?.textContent?.trim() ?? ''
        : '';
      if (!interventionRef || !title) {
        if (error) error.textContent = 'Sélectionnez une intervention associée.';
        return;
      }
      if (!comparisonPath) {
        if (error) error.textContent = 'Ajoutez une image avant / après fusionnée.';
        return;
      }
      const consent = formData.get('consent') === 'on';
      const consentDate = String(formData.get('consent_date') ?? '').trim();
      if (intent === 'publish' && (!consent || !consentDate)) {
        if (error) error.textContent = 'Le consentement et sa date sont requis pour publier.';
        return;
      }

      const [interventionCategory, interventionSlug] = interventionRef.split('::');
      const payload = {
        title,
        description: String(formData.get('description') ?? '').trim() || null,
        intervention_category: interventionCategory,
        intervention_slug: interventionSlug,
        consent,
        consent_date: consentDate || null,
        before_path: comparisonPath,
        after_path: comparisonPath,
        status: intent === 'publish' ? 'publie' : 'brouillon',
        media_sets: [{
          set_order: 1,
          label: 'Vue principale',
          media_mode: 'comparison',
          before_path: comparisonPath,
          after_path: comparisonPath,
          is_cover: true,
        }],
      };

      try {
        if (error) error.textContent = '';
        if (status) status.textContent = 'Enregistrement...';
        setSubmittingDisabled(true);
        const response = await fetch('/api/cms/avant-apres', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error('save');
        const data = await response.json();
        window.location.href = intent === 'publish' ? '/cms/avant-apres?published=1' : `/cms/avant-apres/${data.id}`;
      } catch {
        if (error) error.textContent = 'Erreur de sauvegarde.';
        if (status) status.textContent = '';
        setSubmittingDisabled(false);
      }
    });
  })();
</script>
