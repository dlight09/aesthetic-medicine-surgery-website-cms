---
import CmsLayout from '@/layouts/CmsLayout.astro';
import { getCmsAvantApresCase, type AvantApresCaseView } from '@/lib/cms/avantApres';
import { interventionCategories } from '@/lib/interventions';
import { listCmsInterventions } from '@/lib/cms/interventions';
import { getCollection } from 'astro:content';

Astro.response.headers.set('Cache-Control', 'no-store');
const { id } = Astro.params;
type AvantApresCaseWithIntervention = AvantApresCaseView & {
  intervention_category?: string | null;
  intervention_slug?: string | null;
  case_number?: number | null;
};
const item = (id ? await getCmsAvantApresCase(id) : null) as AvantApresCaseWithIntervention | null;
if (!item) return Astro.redirect('/cms/avant-apres');

type InterventionLite = { title: string; slug: string; category: string; order?: number | null };
let interventions: InterventionLite[] = [];
try {
  const rows = await listCmsInterventions();
  interventions = rows.map((row) => ({
    title: row.title,
    slug: row.slug,
    category: row.category,
    order: row.order,
  }));
} catch {
  const entries = await getCollection('interventions');
  interventions = entries.map((entry) => ({
    title: entry.data.title,
    slug: entry.slug.split('/').filter(Boolean).slice(-1)[0] ?? entry.slug,
    category: entry.data.category,
    order: entry.data.order ?? null,
  }));
}

const interventionsByCategory = interventionCategories.map((category) => ({
  label: category.title,
  items: interventions
    .filter((entry) => entry.category === category.key)
    .sort((a, b) => (a.order ?? 999) - (b.order ?? 999)),
}));
const currentInterventionRef =
  item.intervention_category && item.intervention_slug
    ? `${item.intervention_category}::${item.intervention_slug}`
    : '';
const coverMediaSet = item.media_sets.find((set) => set.is_cover) ?? item.media_sets[0] ?? null;
const isComparison = coverMediaSet?.media_mode === 'comparison';
const coverBeforeUrl = coverMediaSet?.beforeUrl ?? item.beforeUrl;
const coverAfterUrl = coverMediaSet?.afterUrl ?? item.afterUrl;
---

<CmsLayout title="Edition cas">
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <section class="cms-card p-7">
      <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Avant/Après</div>
      <h1 class="mt-2 font-display text-3xl tracking-tight">
        {item.case_number ? `Cas ${String(item.case_number).padStart(2, '0')}` : 'Cas'} - {item.title}
      </h1>

      <form id="aa-form" class="mt-8 grid gap-5" data-id={item.id}>
        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">Intervention associée</span>
          <select class="cms-select" name="intervention_ref" required>
            <option value="">Sélectionner une intervention</option>
            {interventionsByCategory.map((group) => (
              <optgroup label={group.label}>
                {group.items.map((entry) => (
                  <option
                    value={`${entry.category}::${entry.slug}`}
                    selected={currentInterventionRef === `${entry.category}::${entry.slug}`}
                  >
                    {entry.title}
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
          <span class="text-xs text-ink/50">Le titre reprend l’intervention sélectionnée.</span>
        </label>

        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">Numéro du cas</span>
          <div class="cms-input flex items-center text-sm text-ink/70">
            {item.case_number ? `Cas ${String(item.case_number).padStart(2, '0')}` : '-'}
          </div>
          <span class="text-xs text-ink/50">Réattribué automatiquement si l’intervention change.</span>
        </label>

        <div class="rounded-2xl border border-ink/10 bg-mist p-4">
          <div class="text-sm font-semibold text-ink/80">Image avant / après</div>
          {isComparison ? (
            <img src={coverBeforeUrl} alt="Composition avant et après" class="mt-3 h-56 w-full rounded-xl bg-paper object-contain" />
          ) : (
            <>
              <div class="mt-2 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
                Ancien format en deux images. Il est conservé tant qu’aucune nouvelle composition fusionnée n’est envoyée.
              </div>
              <div class="mt-3 grid grid-cols-2 gap-3">
                <img src={coverBeforeUrl} alt="Avant" class="h-40 w-full rounded-xl object-cover" />
                <img src={coverAfterUrl} alt="Après" class="h-40 w-full rounded-xl object-cover" />
              </div>
            </>
          )}

          <div class="mt-4 border-t border-ink/10 pt-4">
            <div class="text-xs font-semibold text-ink/70">Remplacer par une image fusionnée</div>
            <input type="file" accept="image/jpeg,image/png,image/webp" class="mt-2 block text-xs" data-upload />
            <img data-preview class="mt-3 hidden h-56 w-full rounded-xl bg-paper object-contain" alt="Nouvelle composition avant et après" />
            <div class="mt-2 text-[11px] text-ink/50">JPG, PNG ou WebP, 10 Mo max. Les autres vues existantes seront conservées.</div>
            <div data-upload-status class="mt-1 text-[11px] text-ink/60"></div>
            <div data-upload-error class="mt-1 text-[11px] text-rose-600"></div>
            <input type="hidden" name="comparison_path" data-path />
          </div>
        </div>

        <label class="grid gap-2 text-sm">
          <span class="font-semibold text-ink/80">Description courte</span>
          <textarea rows={3} class="cms-textarea" name="description" maxlength="500">{item.description ?? ''}</textarea>
        </label>
      </form>
    </section>

    <aside class="cms-panel p-6">
      <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Consentement</div>
      <label class="mt-3 flex items-center gap-2 text-sm">
        <input type="checkbox" class="h-4 w-4" name="consent" form="aa-form" checked={item.consent} />
        <span>Consentement obtenu</span>
      </label>
      <label class="mt-4 grid gap-2 text-sm">
        <span class="font-semibold text-ink/80">Date du consentement</span>
        <input type="date" class="cms-input" name="consent_date" form="aa-form" value={item.consent_date ?? ''} />
      </label>

      <div class="mt-6 space-y-3">
        <button type="submit" value="draft" form="aa-form" data-submit class="btn btn-pill btn-md btn-primary w-full disabled:cursor-not-allowed disabled:opacity-60">
          Enregistrer brouillon
        </button>
        <button type="submit" value="publish" form="aa-form" data-submit class="btn btn-pill btn-md btn-secondary w-full disabled:cursor-not-allowed disabled:opacity-60">
          Publier
        </button>
        <button type="button" data-delete class="btn btn-pill btn-md w-full border border-rose-200 bg-rose-50 text-rose-700 hover:bg-rose-100">
          Supprimer le cas
        </button>
      </div>
      <div id="aa-status" class="mt-4 text-xs text-ink/60"></div>
      <div id="aa-error" class="mt-2 text-xs text-rose-600"></div>
    </aside>
  </div>
</CmsLayout>

<dialog id="aa-confirm" class="cms-drawer">
  <div class="cms-card-elevated mx-auto mt-28 w-[min(92vw,420px)] p-6">
    <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Suppression</div>
    <div class="mt-2 font-display text-2xl tracking-tight">Supprimer ce cas ?</div>
    <p class="mt-3 text-sm text-ink/70">Cette action est définitive et retire le cas du site.</p>
    <div class="mt-6 flex flex-wrap justify-end gap-3">
      <button type="button" data-cancel class="btn btn-pill btn-sm btn-secondary">Annuler</button>
      <button type="button" data-confirm class="btn btn-pill btn-sm btn-primary">Supprimer</button>
    </div>
  </div>
</dialog>

<script is:inline>
  (() => {
    const form = document.getElementById('aa-form');
    const error = document.getElementById('aa-error');
    const status = document.getElementById('aa-status');
    if (!(form instanceof HTMLFormElement)) return;

    const interventionSelect = form.querySelector('select[name="intervention_ref"]');
    const uploadInput = form.querySelector('[data-upload]');
    const pathInput = form.querySelector('[data-path]');
    const uploadStatus = form.querySelector('[data-upload-status]');
    const uploadError = form.querySelector('[data-upload-error]');
    const submitButtons = document.querySelectorAll('[data-submit]');
    const deleteButton = document.querySelector('[data-delete]');
    const confirmDialog = document.getElementById('aa-confirm');
    const confirmButton = confirmDialog?.querySelector('[data-confirm]');
    const cancelButton = confirmDialog?.querySelector('[data-cancel]');

    const setSubmittingDisabled = (disabled) => {
      submitButtons.forEach((button) => {
        if (button instanceof HTMLButtonElement) button.disabled = disabled;
      });
    };

    if (uploadInput instanceof HTMLInputElement) {
      uploadInput.addEventListener('change', async () => {
        const file = uploadInput.files?.[0];
        if (!file) return;
        if (uploadError instanceof HTMLElement) uploadError.textContent = '';
        if (file.size > 10 * 1024 * 1024) {
          if (uploadError instanceof HTMLElement) uploadError.textContent = 'Fichier trop lourd (10 Mo max).';
          uploadInput.value = '';
          return;
        }
        try {
          setSubmittingDisabled(true);
          if (uploadStatus instanceof HTMLElement) uploadStatus.textContent = 'Upload en cours...';
          const response = await fetch('/api/cms/avant-apres/upload-url', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fileName: file.name, kind: 'comparison', contentType: file.type, byteSize: file.size }),
          });
          if (!response.ok) throw new Error('upload-url');
          const data = await response.json();
          const uploadResponse = await fetch(data.signedUrl, {
            method: 'PUT',
            headers: { 'Content-Type': file.type },
            body: file,
          });
          if (!uploadResponse.ok) throw new Error('upload');
          if (pathInput instanceof HTMLInputElement) pathInput.value = data.path;
          const preview = form.querySelector('[data-preview]');
          if (preview instanceof HTMLImageElement) {
            preview.src = URL.createObjectURL(file);
            preview.classList.remove('hidden');
          }
          if (uploadStatus instanceof HTMLElement) uploadStatus.textContent = 'Upload terminé.';
        } catch {
          if (uploadStatus instanceof HTMLElement) uploadStatus.textContent = '';
          if (uploadError instanceof HTMLElement) uploadError.textContent = "Erreur d'upload. Vérifiez votre connexion.";
        } finally {
          setSubmittingDisabled(false);
        }
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitter = event.submitter;
      const intent = submitter instanceof HTMLButtonElement ? submitter.value : 'draft';
      const formData = new FormData(form);
      const interventionRef = String(formData.get('intervention_ref') ?? '').trim();
      const title = interventionSelect instanceof HTMLSelectElement
        ? interventionSelect.selectedOptions[0]?.textContent?.trim() ?? ''
        : '';
      if (!interventionRef || !title) {
        if (error) error.textContent = 'Sélectionnez une intervention associée.';
        return;
      }
      const consent = formData.get('consent') === 'on';
      const consentDate = String(formData.get('consent_date') ?? '').trim();
      if (intent === 'publish' && (!consent || !consentDate)) {
        if (error) error.textContent = 'Le consentement et sa date sont requis pour publier.';
        return;
      }

      const [interventionCategory, interventionSlug] = interventionRef.split('::');
      const comparisonPath = String(formData.get('comparison_path') ?? '').trim();
      const payload = {
        title,
        description: String(formData.get('description') ?? '').trim() || null,
        intervention_category: interventionCategory,
        intervention_slug: interventionSlug,
        consent,
        consent_date: consentDate || null,
        status: intent === 'publish' ? 'publie' : 'brouillon',
      };
      if (comparisonPath) {
        payload.before_path = comparisonPath;
        payload.after_path = comparisonPath;
        payload.replace_cover = true;
        payload.media_sets = [{
          set_order: 1,
          label: 'Vue principale',
          media_mode: 'comparison',
          before_path: comparisonPath,
          after_path: comparisonPath,
          is_cover: true,
        }];
      }

      try {
        if (error) error.textContent = '';
        if (status) status.textContent = 'Enregistrement...';
        setSubmittingDisabled(true);
        const caseId = form.dataset.id ?? '';
        const response = await fetch(`/api/cms/avant-apres/${encodeURIComponent(caseId)}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error('save');
        if (intent === 'publish') {
          window.location.href = '/cms/avant-apres?published=1';
          return;
        }
        window.location.reload();
      } catch {
        if (error) error.textContent = 'Erreur de sauvegarde.';
        if (status) status.textContent = '';
        setSubmittingDisabled(false);
      }
    });

    if (deleteButton instanceof HTMLButtonElement && confirmDialog instanceof HTMLDialogElement) {
      deleteButton.addEventListener('click', () => confirmDialog.showModal());
    }
    if (confirmDialog instanceof HTMLDialogElement) {
      const close = () => confirmDialog.close();
      if (cancelButton instanceof HTMLElement) cancelButton.addEventListener('click', close);
      confirmDialog.addEventListener('click', (event) => {
        if (event.target === confirmDialog) close();
      });
    }
    if (confirmButton instanceof HTMLButtonElement) {
      confirmButton.addEventListener('click', async () => {
        const caseId = form.dataset.id ?? '';
        if (!caseId) return;
        try {
          if (status) status.textContent = 'Suppression...';
          const response = await fetch(`/api/cms/avant-apres/${encodeURIComponent(caseId)}`, { method: 'DELETE' });
          if (!response.ok) throw new Error('delete');
          window.location.href = '/cms/avant-apres?deleted=1';
        } catch {
          if (error) error.textContent = 'Erreur de suppression.';
          if (status) status.textContent = '';
          if (confirmDialog instanceof HTMLDialogElement) confirmDialog.close();
        }
      });
    }
  })();
</script>
