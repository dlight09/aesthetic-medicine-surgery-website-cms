---
import CmsLayout from '@/layouts/CmsLayout.astro';
import { listBookingRequests } from '@/lib/cms/bookings';
import { isCmsAuthed } from '@/lib/cms/auth';

if (!isCmsAuthed(Astro)) return Astro.redirect('/cms/login');
const bookings = await listBookingRequests();

const statusClass = (status: string) => {
  switch (status) {
    case 'nouveau':
      return 'bg-copper/15 text-copper';
    case 'contacte':
      return 'bg-ink/10 text-ink/80';
    case 'planifie':
      return 'bg-emerald-100 text-emerald-700';
    case 'cloture':
      return 'bg-ink/5 text-ink/60';
    default:
      return 'bg-ink/10 text-ink/70';
  }
};

const statusLabel = (status: string) => status.charAt(0).toUpperCase() + status.slice(1);
const formatDate = (value: string) => new Intl.DateTimeFormat('fr-TN', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
---

<CmsLayout title="Demandes">
  <div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Gestion manuelle</div>
        <h1 class="mt-1 font-display text-3xl tracking-tight">Demandes de rendez-vous</h1>
      </div>
      <a href="/cms/bookings/new" class="btn btn-pill btn-sm btn-primary">Nouvelle demande</a>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <select id="booking-status-filter" class="cms-select rounded-full">
        <option value="">Statut: tous</option>
        <option value="nouveau">Nouveau</option>
        <option value="contacte">Contacté</option>
        <option value="planifie">Planifié</option>
        <option value="cloture">Clôturé</option>
      </select>
      <input
        id="booking-search"
        type="search"
        placeholder="Rechercher par nom, categorie, date..."
        class="cms-input min-w-[220px] rounded-full"
      />
    </div>

    <div class="cms-card shadow-soft">
        <div class="grid grid-cols-[1.2fr_1fr_0.8fr_0.8fr] gap-4 border-b border-ink/10 px-6 py-4 text-xs font-semibold uppercase tracking-wide text-ink/50">
          <div>Patient</div>
          <div>Message</div>
          <div>Reçue le</div>
          <div>Statut</div>
        </div>
        <div class="divide-y divide-ink/5">
          {bookings.map((b) => (
          <a
            href={`/cms/bookings/${b.id}`}
            class="cms-row grid grid-cols-[1.2fr_1fr_0.8fr_0.8fr] gap-4 px-6 py-4 text-sm"
            data-booking-row
            data-status={b.status}
            data-search={`${b.full_name} ${b.phone} ${b.email} ${b.intervention_category ?? ''} ${b.message}`.toLowerCase()}
          >
            <div>
              <div class="font-semibold text-ink/90">{b.full_name}</div>
              <div class="text-xs text-ink/60">{b.phone}</div>
            </div>
            <div class="truncate text-ink/70">{b.message}</div>
            <div class="text-ink/70">{formatDate(b.created_at)}</div>
            <div>
              <span class:list={['cms-pill', statusClass(b.status)]}>
                {statusLabel(b.status)}
              </span>
            </div>
          </a>
        ))}
        <div id="booking-empty" class:list={['px-6 py-10 text-sm text-ink/65', bookings.length ? 'hidden' : '']}>
          Aucune demande correspondante.
        </div>
      </div>
    </div>
  </div>
</CmsLayout>

<script>
  const search = document.querySelector('#booking-search');
  const status = document.querySelector('#booking-status-filter');
  const rows = Array.from(document.querySelectorAll('[data-booking-row]'));
  const empty = document.querySelector('#booking-empty');

  const applyFilters = () => {
    const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
    const selectedStatus = status instanceof HTMLSelectElement ? status.value : '';
    let visible = 0;
    rows.forEach((row) => {
      if (!(row instanceof HTMLElement)) return;
      const matches =
        (!query || (row.dataset.search ?? '').includes(query)) &&
        (!selectedStatus || row.dataset.status === selectedStatus);
      row.classList.toggle('hidden', !matches);
      if (matches) visible += 1;
    });
    empty?.classList.toggle('hidden', visible > 0);
  };

  search?.addEventListener('input', applyFilters);
  status?.addEventListener('change', applyFilters);
</script>
