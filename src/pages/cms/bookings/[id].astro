---
import CmsLayout from '@/layouts/CmsLayout.astro';
import { getBookingPhotoUrls, getBookingRequest } from '@/lib/cms/bookings';
import { isCmsAuthed } from '@/lib/cms/auth';
import { interventionCategoryMeta, type InterventionCategoryKey } from '@/lib/interventions';

const { id } = Astro.params;
if (!isCmsAuthed(Astro)) return Astro.redirect('/cms/login');
const booking = id ? await getBookingRequest(id) : null;
if (!booking) return Astro.redirect('/cms/bookings');
const photoUrls = await getBookingPhotoUrls(booking.photo_paths);
const formatDate = (value: string) => new Intl.DateTimeFormat('fr-TN', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
const formatPreferredDate = (value: string) => new Intl.DateTimeFormat('fr-TN', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`));
const interventionLabel = booking.intervention_category
  ? interventionCategoryMeta[booking.intervention_category as InterventionCategoryKey]?.title ?? booking.intervention_category
  : 'Non renseigné';
---

<CmsLayout title="Demande">
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <section class="cms-card p-7">
      <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Demande</div>
       <h1 class="mt-2 font-display text-3xl tracking-tight">{booking.full_name}</h1>
      <p class="mt-2 text-sm text-ink/60">Reference: {booking.id}</p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-ink/10 bg-mist p-4 text-sm">
          <div class="text-xs uppercase tracking-wide text-ink/50">Âge</div>
          <div class="mt-2 font-semibold text-ink/90">{booking.age === null ? 'Non renseigné' : `${booking.age} ans`}</div>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-mist p-4 text-sm">
          <div class="text-xs uppercase tracking-wide text-ink/50">Date souhaitée</div>
          <div class="mt-2 font-semibold text-ink/90">{booking.desired_date ? formatPreferredDate(booking.desired_date) : 'Non renseignée'}</div>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-mist p-4 text-sm">
          <div class="text-xs uppercase tracking-wide text-ink/50">Telephone</div>
          <a href={`tel:${booking.phone.replace(/\s/g, '')}`} class="mt-2 block font-semibold text-ink/90 underline underline-offset-4">{booking.phone}</a>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-mist p-4 text-sm">
          <div class="text-xs uppercase tracking-wide text-ink/50">E-mail</div>
          <a href={`mailto:${booking.email}`} class="mt-2 block break-all font-semibold text-ink/90 underline underline-offset-4">{booking.email}</a>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-mist p-4 text-sm">
          <div class="text-xs uppercase tracking-wide text-ink/50">Reçue le</div>
          <div class="mt-2 font-semibold text-ink/90">{formatDate(booking.created_at)}</div>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-mist p-4 text-sm">
          <div class="text-xs uppercase tracking-wide text-ink/50">Consentement</div>
          <div class="mt-2 font-semibold text-ink/90">Recueilli le {formatDate(booking.consent_at)}</div>
        </div>
       </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-ink/10 bg-mist p-4 text-sm">
          <div class="text-xs uppercase tracking-wide text-ink/50">Poids</div>
          <div class="mt-2 font-semibold text-ink/90">{booking.weight_kg === null ? 'Non renseigné' : `${booking.weight_kg} kg`}</div>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-mist p-4 text-sm">
          <div class="text-xs uppercase tracking-wide text-ink/50">Taille</div>
          <div class="mt-2 font-semibold text-ink/90">{booking.height_cm === null ? 'Non renseignée' : `${booking.height_cm} cm`}</div>
        </div>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-ink/10 bg-mist p-4 text-sm">
          <div class="text-xs uppercase tracking-wide text-ink/50">Tabagisme</div>
          <div class="mt-2 font-semibold text-ink/90">{booking.smoking_status === null ? 'Non renseigné' : booking.smoking_status === 'yes' ? 'Oui' : 'Non'}</div>
        </div>
      </div>

      <div class="mt-8 space-y-6">
        <div>
           <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Antécédents médicaux, chirurgicaux et gynécologiques</div>
          <p class="mt-2 whitespace-pre-wrap rounded-2xl border border-ink/10 bg-mist/45 p-5 text-sm leading-relaxed text-ink/80">{booking.medical_history || 'Non renseignées'}</p>
        </div>
        {booking.previous_surgeries ? <div>
          <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Chirurgies antérieures</div>
          <p class="mt-2 whitespace-pre-wrap rounded-2xl border border-ink/10 bg-mist/45 p-5 text-sm leading-relaxed text-ink/80">{booking.previous_surgeries || 'Non renseignées'}</p>
        </div> : null}
        <div>
          <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Médicaments pris quotidiennement</div>
          <p class="mt-2 whitespace-pre-wrap rounded-2xl border border-ink/10 bg-mist/45 p-5 text-sm leading-relaxed text-ink/80">{booking.daily_medications || 'Non renseignés'}</p>
        </div>
      </div>

      <div class="mt-8 rounded-2xl border border-ink/10 bg-mist p-4 text-sm">
        <div class="text-xs uppercase tracking-wide text-ink/50">Type de chirurgie envisagée</div>
        <div class="mt-2 font-semibold text-ink/90">{interventionLabel}</div>
      </div>

      <div class="mt-8">
         <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Message</div>
         <p class="mt-2 whitespace-pre-wrap rounded-2xl border border-ink/10 bg-mist/45 p-5 text-sm leading-relaxed text-ink/80">{booking.message}</p>
       </div>

       {photoUrls.length > 0 && <div class="mt-8"><div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Photos jointes</div><div class="mt-3 grid gap-3 sm:grid-cols-2">{photoUrls.map((url, index) => <a href={url} target="_blank" rel="noreferrer" class="overflow-hidden rounded-2xl border border-ink/10 bg-mist"><img src={url} alt={`Photo jointe ${index + 1}`} class="aspect-[4/3] w-full object-cover" loading="lazy" /></a>)}</div></div>}
    </section>

    <aside class="cms-panel p-6">
      <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Actions</div>
       <div class="mt-3 space-y-2">
         <a href={`tel:${booking.phone.replace(/\s/g, '')}`} class="btn btn-pill btn-md btn-primary w-full">Appeler</a>
         <a href={`mailto:${booking.email}`} class="btn btn-pill btn-md btn-secondary w-full">E-mail</a>
      </div>

      <div class="mt-6">
        <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">Statut</div>
         <select
           id="booking-status"
           class="cms-select mt-2 w-full"
           data-id={booking.id}
           data-updated-at={booking.updated_at}
         >
           <option value="nouveau" selected={booking.status === 'nouveau'}>Nouveau</option>
           <option value="contacte" selected={booking.status === 'contacte'}>Contacté</option>
           <option value="planifie" selected={booking.status === 'planifie'}>Planifié</option>
           <option value="cloture" selected={booking.status === 'cloture'}>Clôturé</option>
         </select>
         <div id="booking-status-message" class="mt-2 text-xs text-ink/60"></div>
      </div>

       {photoUrls.length > 0 && <div class="mt-6 text-xs text-ink/60">Les photos jointes sont accessibles uniquement dans cet espace administrateur.</div>}
    </aside>
  </div>
</CmsLayout>

<script>
  const select = document.querySelector('#booking-status');
  const message = document.querySelector('#booking-status-message');
  if (select instanceof HTMLSelectElement) {
    select.addEventListener('change', async () => {
      const previous = select.dataset.previous ?? select.value;
      select.disabled = true;
      if (message) message.textContent = 'Enregistrement...';
      try {
        const response = await fetch(`/api/cms/bookings/${encodeURIComponent(select.dataset.id ?? '')}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            status: select.value,
            expected_updated_at: select.dataset.updatedAt,
          }),
        });
        if (!response.ok) throw new Error(await response.text());
        const updated = await response.json();
        select.dataset.updatedAt = updated.updated_at;
        select.dataset.previous = updated.status;
        if (message) message.textContent = 'Statut mis à jour.';
      } catch {
        select.value = previous;
        if (message) message.textContent = 'La mise à jour a échoué. Rechargez la page.';
      } finally {
        select.disabled = false;
      }
    });
    select.dataset.previous = select.value;
  }
</script>
