---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/lib/site';

const addressQuery = [...site.contact.addressLines, site.contact.city, site.contact.country]
  .filter(Boolean)
  .join(', ');
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressQuery)}`;
const mapsEmbed = `https://www.google.com/maps?q=${encodeURIComponent(addressQuery)}&output=embed`;

const processSteps = [
  {
    index: '01',
    title: 'Échange',
    text: 'Un premier dialogue confidentiel pour comprendre vos attentes, vos priorités et répondre à vos questions initiales.',
  },
  {
    index: '02',
    title: 'Examen clinique',
    text: 'Une évaluation médicale rigoureuse pour vérifier l’indication et analyser les options adaptées à votre situation.',
  },
  {
    index: '03',
    title: 'Proposition',
    text: 'Un plan personnalisé avec bénéfices attendus, limites, suites possibles et cadre de prise en charge.',
  },
  {
    index: '04',
    title: 'Suivi',
    text: 'Un accompagnement structuré après le geste, avec consignes et contrôles pour une évolution sereine.',
  },
];
---

<BaseLayout title="Rendez-vous" description="Prendre rendez-vous: telephone, WhatsApp, adresse, horaires et informations de consultation.">
  <section class="relative overflow-hidden bg-ink">
    <img
      src="/images/hero-clinic-01.webp"
      width="1536"
      height="1024"
      alt="Espace de consultation du cabinet"
      loading="eager"
      class="absolute inset-0 h-full w-full object-cover opacity-45"
    />
    <div class="absolute inset-0 bg-ink/72"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-14 sm:py-20 lg:py-24">
      <div class="max-w-2xl text-paper">
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-paper/70">Première demande</span>
        <h1 class="mt-5 font-display text-4xl tracking-tight text-paper sm:text-5xl">Rendez-vous</h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-paper/82 sm:text-lg">
          Contactez directement le cabinet pour une première demande et l’organisation d’une consultation adaptée à votre situation.
        </p>
      </div>

      <section class="mt-10 max-w-3xl rounded-3xl border border-paper/20 bg-paper p-5 text-ink shadow-lift sm:p-8">
        <div class="border-b border-ink/10 pb-6">
          <h2 class="font-display text-2xl tracking-tight">Envoyer une demande</h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink/75">Décrivez brièvement votre demande et joignez les photos utiles à sa compréhension. Elles restent strictement accessibles à l’équipe du cabinet.</p>
        </div>

        <form id="booking-form" class="mt-8 space-y-8" novalidate>
          <fieldset class="space-y-5">
            <legend class="font-display text-lg tracking-tight text-ink">Vos coordonnées</legend>
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="grid gap-2 text-sm font-semibold text-ink/85">
                <span class="booking-label">Nom et prénom <b aria-hidden="true">*</b></span>
              <input name="fullName" autocomplete="name" required class="booking-input" />
              </label>
              <label class="grid gap-2 text-sm font-semibold text-ink/85">
                <span class="booking-label">E-mail <b aria-hidden="true">*</b></span>
              <input name="email" type="email" autocomplete="email" required class="booking-input" />
              </label>
            </div>
            <label class="grid gap-2 text-sm font-semibold text-ink/85">
              <span class="booking-label">Numéro de téléphone <b aria-hidden="true">*</b></span>
              <input name="phone" type="tel" autocomplete="tel" required class="booking-input" />
            </label>
          </fieldset>
          <fieldset class="space-y-5 border-t border-ink/10 pt-7">
            <legend class="font-display text-lg tracking-tight text-ink">Votre demande</legend>
            <label class="mt-5 grid gap-2 text-sm font-semibold text-ink/85">
              <span class="booking-label">Votre message <b aria-hidden="true">*</b></span>
              <textarea name="message" rows="5" required class="booking-input resize-y" placeholder="Expliquez votre demande ou la zone concernée."></textarea>
            </label>
            <div class="booking-photo-area">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <span class="booking-label">Photos à joindre <b aria-hidden="true">*</b></span>
                <span class="text-sm text-ink/65">De 1 à 5 photos</span>
              </div>
              <label for="booking-photos" class="booking-upload mt-3">
                <span class="font-semibold text-ink">Ajoutez les photos utiles à votre demande</span>
                <span class="mt-1 block max-w-xl text-sm leading-relaxed text-ink/70">JPG, PNG ou WebP, 3 Mo maximum par photo. Elles ne sont ni publiées ni partagées.</span>
                <span class="mt-4 inline-flex rounded-full bg-ink px-4 py-2 text-sm font-semibold text-paper transition">Sélectionner les photos</span>
              </label>
              <input id="booking-photos" name="photos" type="file" accept="image/jpeg,image/png,image/webp" multiple class="sr-only" />
              <ul id="booking-photo-list" class="mt-3 space-y-2 text-sm text-ink/75" aria-live="polite"></ul>
            </div>
          </fieldset>
          <label class="flex items-start gap-3 text-sm leading-relaxed text-ink/75">
            <input name="consent" type="checkbox" required class="mt-1 h-4 w-4 rounded border-ink/30 accent-copper-deep" />
            <span>J’accepte que le cabinet traite mes informations et les photos jointes afin de répondre à ma demande, conformément à l’<a href="/consentement" class="font-semibold underline decoration-ink/35 underline-offset-4 hover:decoration-ink">information sur le consentement</a>. <b aria-hidden="true" class="text-copper-deep">*</b></span>
          </label>
          <input name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <div class="flex flex-col gap-4 border-t border-ink/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
            <p id="booking-status" class="text-sm leading-relaxed text-ink/70" role="status" aria-live="polite">Tous les champs, y compris les photos, sont obligatoires.</p>
            <button type="submit" class="btn btn-pill btn-lg btn-accent">Envoyer la demande</button>
          </div>
        </form>

        <div class="mt-7 border-t border-ink/10 pt-6">
          <p class="text-sm leading-relaxed text-ink/70">Vous préférez échanger directement ?</p>
          <div class="mt-3 flex flex-wrap gap-3">
            <a href={site.links.tel} class="btn btn-pill btn-md btn-primary">Appeler</a>
            <a href={site.links.whatsapp} class="btn btn-pill btn-md btn-secondary">WhatsApp</a>
            <a href={site.links.email} class="btn btn-pill btn-md btn-secondary">E-mail</a>
          </div>
        </div>
      </section>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 pt-14 sm:pt-20">
    <section id="consultation" class="rounded-3xl border border-ink/10 bg-mist/60 px-6 py-14 sm:px-10">
      <div class="flex items-start justify-between gap-4">
        <div class="max-w-2xl">
          <h2 class="font-display text-4xl tracking-tight sm:text-5xl">Votre parcours de consultation</h2>
          <p class="mt-4 text-base leading-relaxed text-ink/70">
            Chaque prise en charge suit une démarche médicale claire : écoute, évaluation, proposition et suivi.
          </p>
        </div>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((step) => (
          <article class="relative rounded-2xl border border-ink/10 bg-paper p-6 shadow-soft">
            <div class="absolute -top-6 left-4 font-display text-6xl text-ink/10">{step.index}</div>
            <h3 class="relative font-display text-2xl tracking-tight">{step.title}</h3>
            <p class="relative mt-3 text-sm leading-relaxed text-ink/70">{step.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-20 grid gap-0 overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-soft lg:grid-cols-[1.15fr_0.85fr]">
      <div class="h-[26rem] min-h-[22rem] bg-mist">
        <iframe
          src={mapsEmbed}
          title="Localisation de la clinique"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          class="h-full w-full border-0"
        ></iframe>
      </div>
      <div class="bg-mist/50 p-8 sm:p-10">
        <h3 class="font-display text-3xl tracking-tight">Venir au cabinet</h3>
        <p class="mt-4 text-sm leading-relaxed text-ink/70">
          Le cabinet se situe à {site.contact.city}. Vous pouvez ouvrir l'itinéraire directement dans Google Maps.
        </p>
        <div class="mt-6 space-y-3 text-sm text-ink/80">
          {site.contact.hoursLines.map((line) => (
            <div>{line}</div>
          ))}
        </div>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center gap-2 border-b border-ink pb-1 text-xs font-semibold uppercase tracking-[0.2em] text-ink/80 hover:text-ink">
          Ouvrir l'itinéraire
          <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
            <path d="M8 16 16 8M9 8h7v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </section>
  </section>

</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#booking-form');
  const photoInput = document.querySelector<HTMLInputElement>('#booking-photos');
  const photoList = document.querySelector<HTMLUListElement>('#booking-photo-list');
  const status = document.querySelector<HTMLElement>('#booking-status');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const maxPhotos = 5;
  const maxPhotoSize = 3 * 1024 * 1024;
  const allowedTypes = new Set(['image/jpeg', 'image/png', 'image/webp']);
  let selectedPhotos: File[] = [];

  function setStatus(message: string, isError = false) {
    if (!status) return;
    status.textContent = message;
    status.className = `text-sm leading-relaxed ${isError ? 'text-copper-deep font-semibold' : 'text-ink/70'}`;
  }

  function escapeHtml(value: string) {
    const element = document.createElement('span');
    element.textContent = value;
    return element.innerHTML;
  }

  function renderPhotos() {
    if (!photoList) return;
    if (!selectedPhotos.length) {
      photoList.innerHTML = '<li class="rounded-xl border border-dashed border-ink/20 px-3 py-2 text-ink/65">Aucune photo sélectionnée.</li>';
      return;
    }
    photoList.innerHTML = selectedPhotos.map((file, index) => `
      <li class="flex items-center justify-between gap-3 rounded-xl bg-mist/45 px-3 py-2">
        <span class="min-w-0 truncate">${escapeHtml(file.name)} <span class="text-ink/55">(${Math.ceil(file.size / 1024)} Ko)</span></span>
        <button type="button" class="font-semibold text-ink underline underline-offset-2" data-photo-index="${index}">Retirer</button>
      </li>`).join('');
  }

  photoInput?.addEventListener('change', () => {
    const files = Array.from(photoInput.files ?? []);
    const invalid = files.find((file) => !allowedTypes.has(file.type) || file.size > maxPhotoSize);
    if (invalid) {
      setStatus('Chaque photo doit être au format JPG, PNG ou WebP et ne pas dépasser 3 Mo.', true);
      photoInput.value = '';
      return;
    }
    if (selectedPhotos.length + files.length > maxPhotos) {
      setStatus(`Vous pouvez joindre jusqu’à ${maxPhotos} photos.`, true);
      photoInput.value = '';
      return;
    }
    selectedPhotos = [...selectedPhotos, ...files];
    photoInput.value = '';
    setStatus(`${selectedPhotos.length} photo${selectedPhotos.length > 1 ? 's' : ''} sélectionnée${selectedPhotos.length > 1 ? 's' : ''}.`);
    renderPhotos();
  });

  photoList?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-photo-index]');
    if (!button) return;
    selectedPhotos.splice(Number(button.dataset.photoIndex), 1);
    renderPhotos();
    if (!selectedPhotos.length) setStatus('Ajoutez au moins une photo pour envoyer votre demande.', true);
  });

  renderPhotos();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    if (!selectedPhotos.length) {
      setStatus('Ajoutez au moins une photo pour envoyer votre demande.', true);
      photoInput?.focus();
      return;
    }

    const data = new FormData(form);
    submitButton!.disabled = true;
    setStatus('Enregistrement de votre demande…');

    try {
      const response = await fetch('/api/bookings/submit', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          fullName: data.get('fullName'), email: data.get('email'), phone: data.get('phone'), message: data.get('message'),
          consent: data.get('consent') === 'on', website: data.get('website'),
          photos: selectedPhotos.map(({ name, type, size }) => ({ name, type, size })),
        }),
      });
      if (!response.ok) throw new Error(await response.text());
      const { uploads } = await response.json();

      if (uploads.length) {
        setStatus('Envoi sécurisé des photos…');
        const results = await Promise.all(uploads.map((upload: { signedUrl: string }, index: number) => fetch(upload.signedUrl, {
          method: 'PUT', headers: { 'content-type': selectedPhotos[index].type }, body: selectedPhotos[index],
        })));
        if (results.some((result) => !result.ok)) throw new Error('La demande est enregistrée, mais une ou plusieurs photos n’ont pas pu être envoyées. Contactez le cabinet si nécessaire.');
      }

      form.reset();
      selectedPhotos = [];
      renderPhotos();
      setStatus('Votre demande a bien été envoyée. Le cabinet vous répondra dans les meilleurs délais.');
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Une erreur est survenue. Veuillez réessayer ou contacter le cabinet directement.', true);
    } finally {
      submitButton!.disabled = false;
    }
  });
</script>

<style>
  .booking-label { @apply inline-flex w-fit items-baseline gap-1 whitespace-nowrap font-semibold text-ink/90; }
  .booking-label b { @apply text-copper-deep; }
  .booking-input { @apply w-full rounded-xl border border-ink/20 bg-paper px-4 py-3 text-base text-ink outline-none transition placeholder:text-ink/60 focus:border-copper-deep focus:ring-2 focus:ring-copper/25; }
  .booking-photo-area { @apply rounded-2xl border border-ink/10 bg-mist/25 p-5 sm:p-6; }
  .booking-upload { @apply block cursor-pointer rounded-xl border border-dashed border-ink/30 bg-paper p-5 text-sm text-ink transition hover:border-copper-deep hover:bg-paper/70 focus-within:ring-2 focus-within:ring-copper/30; }
  .booking-upload:hover span:last-child { @apply bg-ink/90; }
</style>
