---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/lib/site';

const addressQuery = [...site.contact.addressLines, site.contact.city, site.contact.country]
  .filter(Boolean)
  .join(', ');
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressQuery)}`;
const mapsEmbed = `https://www.google.com/maps?q=${encodeURIComponent(addressQuery)}&output=embed`;

const processSteps = [
  {
    index: '01',
    title: 'Échange',
    text: 'Un premier dialogue confidentiel pour comprendre vos attentes, vos priorités et répondre à vos questions initiales.',
  },
  {
    index: '02',
    title: 'Examen clinique',
    text: 'Une évaluation médicale rigoureuse pour vérifier l’indication et analyser les options adaptées à votre situation.',
  },
  {
    index: '03',
    title: 'Proposition',
    text: 'Un plan personnalisé avec bénéfices attendus, limites, suites possibles et cadre de prise en charge.',
  },
  {
    index: '04',
    title: 'Suivi',
    text: 'Un accompagnement structuré après le geste, avec consignes et contrôles pour une évolution sereine.',
  },
];
---

<BaseLayout title="Rendez-vous" description="Prendre rendez-vous: telephone, WhatsApp, adresse, horaires et informations de consultation.">
  <section class="mx-auto max-w-6xl px-4 pb-20 pt-14">
    <header class="grid items-end gap-10 border-b border-ink/10 pb-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-ink/55">Planifiez votre visite</span>
        <h1 class="mt-6 font-display text-6xl tracking-tight sm:text-7xl lg:text-8xl">Rendez-vous</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/75">
          Entrez dans un parcours structuré, avec une information claire et une consultation personnalisée à {site.contact.city}.
        </p>
      </div>
      <div class="overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-lift lg:col-span-5">
        <img
          src="/images/hero-clinic-01.webp"
          width="1536"
          height="1024"
          alt="Clinique et espace de consultation"
          loading="eager"
          class="h-[28rem] w-full object-cover transition duration-700 hover:scale-[1.03]"
        />
      </div>
    </header>

    <section class="mt-14 grid gap-4 md:grid-cols-3">
      <article class="rounded-3xl border border-ink/10 bg-mist p-7 shadow-soft">
        <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-paper text-ink/80">
          <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
            <path d="M5 6.5c0 6.4 5.1 11.5 11.5 11.5h1.1a1.4 1.4 0 0 0 1.4-1.4v-2.2c0-.7-.5-1.3-1.2-1.4l-2.3-.4a1.5 1.5 0 0 0-1.4.4l-1 .9a13.2 13.2 0 0 1-3.9-3.9l.9-1a1.5 1.5 0 0 0 .4-1.4l-.4-2.3c-.1-.7-.7-1.2-1.4-1.2H6.4A1.4 1.4 0 0 0 5 5.4v1.1Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
        <div class="mt-4 text-xs font-semibold uppercase tracking-[0.2em] text-ink/55">Téléphone</div>
        <div class="mt-3 font-display text-3xl tracking-tight">{site.contact.phoneDisplay}</div>
        <div class="mt-2 text-sm text-ink/70">Disponible selon horaires du cabinet</div>
        <div class="mt-6">
          <a href={site.links.tel} class="btn btn-pill btn-sm btn-primary">Appeler</a>
        </div>
      </article>

      <article class="rounded-3xl border border-ink/10 bg-mist p-7 shadow-soft">
        <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-paper text-ink/80">
          <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
            <path d="M12.1 4.8A7.2 7.2 0 0 0 5 12a7 7 0 0 0 1 3.7L5 19l3.6-1a7.2 7.2 0 1 0 3.5-13.2Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M9.4 10.1c.2.4.8 1.3 1.7 2 .9.8 1.8 1.1 2.2 1.2.3.1.6 0 .8-.2l.7-.7c.2-.2.6-.3.9-.1l1 .6c.3.2.4.6.3.9-.3.9-1.2 1.5-2.2 1.4-1.2-.2-2.6-.9-4-2.1-1.2-1.1-2-2.3-2.2-3.5-.1-.9.3-1.8 1.1-2.3.3-.2.7-.1.9.1l.7.9c.2.3.2.7 0 .9l-.5.7c-.2.2-.2.5-.1.7Z" fill="currentColor" fill-opacity="0.15"></path>
          </svg>
        </div>
        <div class="mt-4 text-xs font-semibold uppercase tracking-[0.2em] text-ink/55">WhatsApp</div>
        <div class="mt-3 font-display text-3xl tracking-tight">{site.contact.phoneDisplay}</div>
        <div class="mt-2 text-sm text-ink/70">Réponse rapide selon disponibilités</div>
        <div class="mt-6">
          <a href={site.links.whatsapp} class="btn btn-pill btn-sm btn-secondary">Écrire</a>
        </div>
      </article>

      <article class="rounded-3xl border border-ink/10 bg-mist p-7 shadow-soft">
        <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-paper text-ink/80">
          <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
            <path d="M12 20s6-4.9 6-9.4a6 6 0 1 0-12 0C6 15.1 12 20 12 20Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            <circle cx="12" cy="10.6" r="2.1" stroke="currentColor" stroke-width="1.6"></circle>
          </svg>
        </div>
        <div class="mt-4 text-xs font-semibold uppercase tracking-[0.2em] text-ink/55">Adresse</div>
        <div class="mt-3 text-lg leading-relaxed text-ink/80">
          {site.contact.addressLines.map((line) => (
            <div>{line}</div>
          ))}
          <div>{site.contact.city}, {site.contact.country}</div>
        </div>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-ink/75 hover:text-ink">
          Ouvrir dans Maps
          <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
            <path d="M8 16 16 8M9 8h7v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </article>
    </section>

    <section id="consultation" class="mt-20 rounded-3xl border border-ink/10 bg-mist/60 px-6 py-14 sm:px-10">
      <div class="flex items-start justify-between gap-4">
        <div class="max-w-2xl">
          <h2 class="font-display text-4xl tracking-tight sm:text-5xl">Votre parcours de consultation</h2>
          <p class="mt-4 text-base leading-relaxed text-ink/70">
            Chaque prise en charge suit une démarche médicale claire : écoute, évaluation, proposition et suivi.
          </p>
        </div>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((step) => (
          <article class="relative rounded-2xl border border-ink/10 bg-paper p-6 shadow-soft">
            <div class="absolute -top-6 left-4 font-display text-6xl text-ink/10">{step.index}</div>
            <h3 class="relative font-display text-2xl tracking-tight">{step.title}</h3>
            <p class="relative mt-3 text-sm leading-relaxed text-ink/70">{step.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-20 overflow-hidden rounded-3xl border border-ink/10 bg-ink shadow-lift lg:grid lg:grid-cols-2">
      <div class="p-10 text-paper sm:p-14">
        <h2 class="font-display text-4xl leading-tight tracking-tight sm:text-5xl">Prête à planifier votre consultation ?</h2>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-paper/80">
          Réservez votre créneau pour une évaluation personnalisée et un échange complet sur les options adaptées à votre situation.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.links.tel} class="btn btn-pill btn-lg bg-paper text-ink hover:bg-paper/90">Appeler</a>
          <a href={site.links.whatsapp} class="btn btn-pill btn-lg border border-paper/35 bg-transparent text-paper hover:bg-paper/10">WhatsApp</a>
        </div>
      </div>
      <div class="h-80 lg:h-full">
        <img
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuDMuQzC6L3YIQzzZhlT5KYl9UmX8mRdVEdEuQ98_2txAlXGLLNHiXy34ZOuf0QbPeSFP9KzfIT3gyOu1LNZipKeWhnJ2UqmDFPhc36DDvRrOiM2i-iAnnIDF6Eh1vFAF9r-YUVkm222ccy5L1nuJ61VwUtJ_COPcTEawz3ky4iiWNVIr0jx6BlR5VgALmc1w8bGLLwSy9Z2Pj-UG9CwdOf3vjxsfcgLmwSU4rgbXf7q3gR2LaRDWgrCfaQNE465EAojmqhHss8J6FRh"
          alt="Préparation de consultation en cabinet"
          class="h-full w-full object-cover opacity-85"
          loading="lazy"
        />
      </div>
    </section>

    <section class="mt-20 grid gap-0 overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-soft lg:grid-cols-[1.15fr_0.85fr]">
      <div class="h-[26rem] min-h-[22rem] bg-mist">
        <iframe
          src={mapsEmbed}
          title="Localisation de la clinique"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          class="h-full w-full border-0"
        ></iframe>
      </div>
      <div class="bg-mist/50 p-8 sm:p-10">
        <h3 class="font-display text-3xl tracking-tight">Venir à la clinique</h3>
        <p class="mt-4 text-sm leading-relaxed text-ink/70">
          Le cabinet se situe à {site.contact.city}. Vous pouvez ouvrir l'itinéraire directement dans Google Maps.
        </p>
        <div class="mt-6 space-y-3 text-sm text-ink/80">
          {site.contact.hoursLines.map((line) => (
            <div>{line}</div>
          ))}
        </div>
        <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center gap-2 border-b border-ink pb-1 text-xs font-semibold uppercase tracking-[0.2em] text-ink/80 hover:text-ink">
          Ouvrir l'itinéraire
          <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
            <path d="M8 16 16 8M9 8h7v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </section>
  </section>
</BaseLayout>
