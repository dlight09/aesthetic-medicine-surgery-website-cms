---
type Props = {
  beforeUrl: string;
  afterUrl: string;
  altBefore?: string;
  altAfter?: string;
  loading?: 'eager' | 'lazy';
  mode?: 'pair' | 'comparison';
};

const {
  beforeUrl,
  afterUrl,
  altBefore = 'Photographie avant intervention',
  altAfter = 'Photographie après intervention',
  loading = 'lazy',
  mode = 'pair',
} = Astro.props;
---

<div class:list={['before-after-pair', { 'before-after-pair--comparison': mode === 'comparison' }]}>
  {mode === 'comparison' ? (
    <figure>
      <div class="before-after-pair__image">
        <img src={beforeUrl} alt="Photographie comparative avant et après intervention" loading={loading} />
        <span>Avant / Après</span>
      </div>
    </figure>
  ) : (
    <>
      <figure>
        <div class="before-after-pair__image">
          <img src={beforeUrl} alt={altBefore} loading={loading} />
          <span>Avant</span>
        </div>
      </figure>
      <figure>
        <div class="before-after-pair__image">
          <img src={afterUrl} alt={altAfter} loading={loading} />
          <span>Après</span>
        </div>
      </figure>
    </>
  )}
</div>

<style>
  .before-after-pair {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border: 1px solid rgba(20, 20, 19, 0.1);
    border-radius: 24px;
    background: rgba(20, 20, 19, 0.1);
  }

  figure {
    min-width: 0;
    margin: 0;
    background: rgb(var(--c-paper));
  }

  .before-after-pair__image {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: rgb(var(--c-mist));
  }

  .before-after-pair--comparison .before-after-pair__image {
    aspect-ratio: auto;
  }

  .before-after-pair--comparison img {
    height: auto;
    max-height: 54rem;
    object-fit: contain;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  span {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 5px 10px;
    border-radius: 9999px;
    background: rgb(var(--c-paper) / 0.94);
    color: rgb(var(--c-ink));
    font-family: 'Manrope', sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 640px) {
    .before-after-pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
