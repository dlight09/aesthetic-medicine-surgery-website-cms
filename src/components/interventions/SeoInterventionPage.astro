---
import { site } from '@/lib/site';
import type { SeoInterventionTemplateV2 } from '@/lib/cms/interventionSeoTemplate';

type Props = {
  data: SeoInterventionTemplateV2;
};

const { data } = Astro.props;

const faqStep = String((data.sections.length + 1)).padStart(2, '0');
---

<section class="relative overflow-hidden bg-paper" data-reveal-group="hero-seo">
  <div class="absolute inset-0 bg-[radial-gradient(60rem_34rem_at_14%_8%,rgba(231,219,200,0.45),transparent_62%)]"></div>
  <div class="relative mx-auto max-w-6xl px-4 py-14 lg:py-18">
    <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <div class="reveal text-sm font-semibold uppercase tracking-[0.2em] text-ink/55" data-reveal>{data.breadcrumb}</div>
        <h1 class="reveal mt-4 max-w-3xl heading-sober text-4xl sm:text-5xl" data-reveal>{data.h1}</h1>
        <p class="reveal mt-5 max-w-3xl text-base leading-8 text-ink/78 sm:text-lg" data-reveal>{data.intro}</p>
      </div>
      <div class="reveal fx-image-pan overflow-hidden rounded-[1.8rem] border border-ink/10 bg-paper shadow-soft" data-reveal>
        <img src={data.hero.imageSrc || '/images/thumbnails/visage.webp'} alt={data.hero.imageAlt || 'Intervention'} class="h-[20rem] w-full object-cover sm:h-[24rem]" loading="lazy" />
      </div>
    </div>

    <div class="mt-8 quick-rail grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group="facts-seo">
      {data.quickFacts.map((fact) => (
        <article class="reveal fx-tile rounded-2xl border border-ink/10 bg-paper px-5 py-4" data-reveal>
          <div class="text-sm font-semibold uppercase tracking-[0.18em] text-ink/60">{fact.label}</div>
          <div class="mt-1 heading-sober text-3xl text-copper">{fact.value}</div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="bg-paper py-12">
  <div class="mx-auto max-w-6xl px-4">
    <div class="grid gap-5 lg:grid-cols-[1fr_20rem]">
      <div class="space-y-5">
        {data.sections.map((section) => (
          <article id={`s-${section.key}`} class="reveal rounded-3xl border border-ink/10 bg-mist/35 p-6 shadow-soft sm:p-8" data-reveal>
            <div class="text-sm font-semibold uppercase tracking-[0.2em] text-copper">{section.key}</div>
            <h2 class="mt-2 heading-sober text-2xl">{section.heading}</h2>
            {section.key === '04' && section.rows.length ? (
              <div class="mt-4 divide-y divide-ink/10 rounded-2xl border border-ink/10 bg-paper">
                {section.rows.map((row) => (
                  <div class="grid gap-2 p-4 sm:grid-cols-[11rem_1fr] sm:gap-4">
                    <div class="text-xs font-semibold uppercase tracking-[0.18em] text-copper">{row.label}</div>
                    <div class="text-sm leading-7 text-ink/78 sm:text-base">{row.text}</div>
                  </div>
                ))}
              </div>
            ) : null}

            {section.key === '07' && section.steps.length ? (
              <div class="timeline mt-5 grid gap-3">
                {section.steps.map((step) => (
                  <div class="timeline-row rounded-2xl border border-ink/10 bg-paper p-4 sm:p-5">
                    <div class="text-sm font-semibold uppercase tracking-[0.18em] text-copper">{step.phase}</div>
                    <p class="mt-2 text-sm leading-7 text-ink/78 sm:text-base">{step.text}</p>
                  </div>
                ))}
              </div>
            ) : null}

            {section.callout?.text ? (
              <div class:list={[
                'mt-4 rounded-xl border-l-4 px-4 py-3 italic',
                section.callout.tone === 'warning'
                  ? 'border-amber-600 bg-amber-50 text-amber-900'
                  : 'border-sky-700 bg-sky-50 text-sky-900',
              ]}>
                {section.callout.text}
              </div>
            ) : null}

            {section.key === '09' && (section.generalRisks.length || section.specificRisks.length) ? (
              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                <div class="rounded-2xl border border-ink/10 bg-paper p-5">
                  <div class="text-xs font-semibold uppercase tracking-[0.18em] text-copper">Risques généraux</div>
                  <ul class="mt-3 grid gap-2 text-sm leading-7 text-ink/78 sm:text-base">
                    {section.generalRisks.map((item) => (
                      <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink/45"></span><span>{item}</span></li>
                    ))}
                  </ul>
                </div>
                <div class="rounded-2xl border border-ink/10 bg-paper p-5">
                  <div class="text-xs font-semibold uppercase tracking-[0.18em] text-copper">Risques spécifiques</div>
                  <ul class="mt-3 grid gap-2 text-sm leading-7 text-ink/78 sm:text-base">
                    {section.specificRisks.map((item) => (
                      <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink/45"></span><span>{item}</span></li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : null}

            {section.paragraphs?.length && section.key !== '04' && !(section.key === '07' && section.steps.length) && section.key !== '09' ? (
              <div class="mt-4 space-y-4 text-sm leading-7 text-ink/78 sm:text-base">
                {section.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            ) : null}

            {section.bullets?.length && section.key !== '04' && !(section.key === '07' && section.steps.length) && section.key !== '09' ? (
              <ul class="mt-4 grid gap-2 text-sm leading-7 text-ink/78 sm:text-base">
                {section.bullets.map((item) => (
                  <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink/45"></span><span>{item}</span></li>
                ))}
              </ul>
            ) : null}
          </article>
        ))}

        <article id="faq" class="reveal rounded-3xl border border-ink/10 bg-paper p-6 shadow-soft sm:p-8" data-reveal>
          <div class="text-sm font-semibold uppercase tracking-[0.2em] text-copper">{faqStep}</div>
          <h2 class="mt-2 heading-sober text-2xl">QUESTIONS FRÉQUENTES</h2>
          <div class="mt-5 space-y-3">
            {data.faq.map((item) => (
              <details class="group faq-item rounded-2xl border border-ink/10 bg-mist/45 p-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink/85">
                  <span>{item.question}</span>
                  <span class="text-ink/55 transition group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 text-sm leading-7 text-ink/78 sm:text-base">{item.answer}</p>
              </details>
            ))}
          </div>
        </article>
      </div>

      <aside class="reveal h-max rounded-3xl border border-ink/10 bg-paper p-6 shadow-soft lg:sticky lg:top-24" data-reveal>
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-ink/55">Prendre rendez-vous</div>
        <div class="mt-3 text-sm leading-7 text-ink/78">
          <div>Téléphone : {site.contact.phoneDisplay}</div>
          <div class="mt-1">{site.contact.addressLines[0]}</div>
          <div>{site.contact.addressLines[1]}</div>
        </div>
        <div class="mt-4 flex flex-col gap-2">
          <a href={site.links.tel} class="btn btn-pill btn-sm btn-primary">Appeler</a>
          <a href={site.links.whatsapp} class="btn btn-pill btn-sm btn-secondary">WhatsApp</a>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .heading-sober {
    font-family: 'Source Sans 3', ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.08;
  }

  .quick-rail {
    position: relative;
  }

  .quick-rail::before {
    content: '';
    position: absolute;
    inset: -0.5rem 0 auto 0;
    height: 2px;
    background: linear-gradient(to right, rgba(var(--c-copper) / 0.2), rgba(var(--c-copper) / 0.6), rgba(var(--c-copper) / 0.2));
  }

  .timeline-row {
    position: relative;
    overflow: hidden;
  }

  .timeline-row::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(to bottom, rgba(var(--c-copper) / 0.72), rgba(var(--c-sand) / 0.34));
  }

  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 560ms ease, transform 680ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .fx-tile,
  .timeline-row,
  .faq-item {
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .fx-tile:hover,
  .timeline-row:hover,
  .faq-item:hover {
    transform: translateY(-2px);
    border-color: rgba(var(--c-copper) / 0.26);
    box-shadow: 0 14px 28px rgba(17, 24, 39, 0.08);
  }

  .fx-image-pan img {
    transition: transform 820ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .fx-image-pan:hover img {
    transform: scale(1.02) translateY(-1px);
  }

  .faq-item summary span:last-child {
    transition: transform 260ms ease;
  }

  .faq-item[open] summary span:last-child {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .reveal.is-visible,
    .fx-tile,
    .timeline-row,
    .faq-item,
    .fx-image-pan img,
    .faq-item summary span:last-child {
      transition: none;
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
  const revealGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal-group]'));

  revealGroups.forEach((group) => {
    const items = Array.from(group.querySelectorAll<HTMLElement>('[data-reveal]'));
    items.forEach((item, index) => {
      item.style.transitionDelay = `${Math.min(index * 65, 260)}ms`;
    });
  });

  if (mediaQuery.matches) {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14, rootMargin: '0px 0px -8% 0px' },
    );

    revealItems.forEach((item) => observer.observe(item));
  }
</script>
