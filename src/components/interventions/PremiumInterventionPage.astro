---
type QuickFactIcon = 'target' | 'schedule' | 'event_available' | 'healing';

type QuickFact = {
  icon: QuickFactIcon;
  label: string;
  text: string;
};

type FaqItem = {
  q: string;
  a: string;
};

type Props = {
  categoryLabel: string;
  titleStart: string;
  titleEmphasis: string;
  heroDescription: string;
  heroImageSrc: string;
  heroImageAlt: string;
  quickFacts: QuickFact[];
  objectiveParagraphs: string[];
  forWho: string[];
  processParagraphs: string[];
  contraindicationIntro: string;
  contraindications: string[];
  risksText: string;
  faq: FaqItem[];
  ctaTitle: string;
  ctaEmphasis: string;
  ctaBody: string;
  phoneDisplay: string;
  telHref: string;
  whatsappHref: string;
};

const {
  categoryLabel,
  titleStart,
  titleEmphasis,
  heroDescription,
  heroImageSrc,
  heroImageAlt,
  quickFacts,
  objectiveParagraphs,
  forWho,
  processParagraphs,
  contraindicationIntro,
  contraindications,
  risksText,
  faq,
  ctaTitle,
  ctaEmphasis,
  ctaBody,
  phoneDisplay,
  telHref,
  whatsappHref,
} = Astro.props;
---

<section class="relative overflow-hidden bg-[#fcf9f2]">
  <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-[#ece7df] to-transparent"></div>
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-[1.1fr_0.9fr] lg:py-20">
    <div class="space-y-6">
      <p class="text-xs uppercase tracking-[0.28em] text-ink/60">{categoryLabel}</p>
      <h1 class="font-display text-4xl leading-tight tracking-tight text-ink sm:text-6xl">
        {titleStart}
        <span class="italic"> {titleEmphasis}</span>
      </h1>
      <p class="max-w-xl text-lg text-ink/75">{heroDescription}</p>
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a href="/contact" class="btn btn-pill btn-lg btn-primary">Prendre rendez-vous</a>
        <a href="#en-bref" class="btn btn-pill btn-lg btn-secondary">Découvrir</a>
      </div>
    </div>
    <div class="overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-lift">
      <img src={heroImageSrc} alt={heroImageAlt} class="h-full min-h-[21rem] w-full object-cover" loading="eager" />
    </div>
  </div>
</section>

<section id="en-bref" class="bg-[#f6f3ec] py-16">
  <div class="mx-auto max-w-6xl px-4">
    <div class="mb-8">
      <p class="text-xs uppercase tracking-[0.28em] text-ink/55">En bref</p>
      <h2 class="mt-2 font-display text-3xl tracking-tight text-ink">L'essentiel de l'intervention</h2>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {quickFacts.map((fact) => (
        <article class="rounded-2xl border border-ink/10 bg-paper p-6 shadow-soft transition hover:-translate-y-0.5 hover:shadow-lift">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-ink/10 bg-mist text-ink/75">
            {fact.icon === 'target' ? (
              <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
                <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"></circle>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"></circle>
                <circle cx="12" cy="12" r="1.3" fill="currentColor"></circle>
              </svg>
            ) : null}
            {fact.icon === 'schedule' ? (
              <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
                <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"></circle>
                <path d="M12 8.5v3.7l2.4 1.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            ) : null}
            {fact.icon === 'event_available' ? (
              <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
                <rect x="4.5" y="6" width="15" height="13" rx="2.2" stroke="currentColor" stroke-width="1.6"></rect>
                <path d="M8 4.8v2.4M16 4.8v2.4M8 11.8l2.2 2.2 4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            ) : null}
            {fact.icon === 'healing' ? (
              <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
                <path d="M7.8 6.7a3 3 0 0 1 4.2 0l4.8 4.8a3 3 0 1 1-4.2 4.2l-1-1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M16.2 17.3a3 3 0 0 1-4.2 0l-4.8-4.8a3 3 0 1 1 4.2-4.2l1 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            ) : null}
          </span>
          <h3 class="mt-4 text-xs font-semibold uppercase tracking-[0.18em] text-ink/70">{fact.label}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/75">{fact.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="bg-[#fcf9f2] py-20">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 lg:grid-cols-[1fr_0.9fr]">
    <article class="rounded-3xl border border-ink/10 bg-paper p-8 shadow-soft sm:p-10">
      <h2 class="font-display text-3xl tracking-tight text-ink">Objectif et philosophie du soin</h2>
      <div class="mt-6 space-y-5 text-base leading-relaxed text-ink/80">
        {objectiveParagraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </article>

    <aside class="rounded-3xl border border-ink/10 bg-mist/70 p-8 shadow-soft sm:p-10">
      <h3 class="text-xs font-semibold uppercase tracking-[0.24em] text-ink/60">Pour qui ?</h3>
      <ul class="mt-5 space-y-3 text-sm text-ink/80">
        {forWho.map((item) => (
          <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/50"></span><span>{item}</span></li>
        ))}
      </ul>
      <div class="mt-8 rounded-2xl border border-ink/10 bg-paper p-5">
        <div class="text-xs font-semibold uppercase tracking-wide text-ink/60">Contact</div>
        <div class="mt-2 text-sm text-ink/80">Téléphone : {phoneDisplay}</div>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href={telHref} class="btn btn-pill btn-sm btn-primary">Appeler</a>
          <a href={whatsappHref} class="btn btn-pill btn-sm btn-secondary">WhatsApp</a>
        </div>
      </div>
    </aside>
  </div>
</section>

<section class="bg-[#f6f3ec] py-20">
  <div class="mx-auto max-w-6xl space-y-8 px-4">
    <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr]">
      <article class="overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-soft">
        <div class="relative aspect-[16/10] w-full bg-[radial-gradient(circle_at_30%_20%,#d7d2ca_0%,#c8c2b8_45%,#b9b3aa_100%)]">
          <div class="absolute inset-0 bg-[linear-gradient(120deg,rgba(20,20,19,0.08),transparent_55%)]"></div>
          <button
            type="button"
            class="absolute left-1/2 top-1/2 inline-flex -translate-x-1/2 -translate-y-1/2 items-center gap-2 rounded-full border border-paper/50 bg-ink/85 px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-paper transition hover:bg-ink"
            aria-label="Voir la vidéo de présentation"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
              <path d="M8.2 6.9a1 1 0 0 1 1.5-.9l8 5a1.1 1.1 0 0 1 0 1.9l-8 5a1 1 0 0 1-1.5-.9V6.9Z"></path>
            </svg>
            Lecture
          </button>
          <div class="absolute bottom-4 left-4 rounded-full bg-paper/85 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.15em] text-ink/70">
            Vidéo placeholder
          </div>
        </div>
      </article>

      <article class="rounded-3xl border border-ink/10 bg-paper p-8 shadow-soft sm:p-10">
        <h2 class="font-display text-3xl tracking-tight text-ink">Déroulé et suites</h2>
        <div class="mt-6 space-y-5 text-sm leading-relaxed text-ink/80">
          {processParagraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </article>
    </div>

    <article class="rounded-3xl border border-ink/10 bg-[#e5e2db] p-8 shadow-soft sm:p-12">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
        <div>
          <h2 class="font-display text-4xl tracking-tight text-ink">Contre-indications</h2>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink/70">{contraindicationIntro}</p>
          <ul class="mt-8 grid gap-4 text-sm uppercase tracking-[0.13em] text-ink/70 sm:grid-cols-2">
            {contraindications.map((item) => (
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/45"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="font-display text-4xl tracking-tight text-ink">Risques potentiels</h2>
          <p class="mt-5 text-lg leading-relaxed text-ink/70">{risksText}</p>
          <a href="/contact" class="mt-8 inline-flex border-b border-ink pb-1 text-xs font-semibold uppercase tracking-[0.22em] text-ink/85">
            Lire la fiche d'information complète
          </a>
        </div>
      </div>
    </article>
  </div>
</section>

<section class="bg-[#fcf9f2] py-20">
  <div class="mx-auto max-w-3xl px-4">
    <div class="text-center">
      <p class="text-xs uppercase tracking-[0.28em] text-ink/55">Questions fréquentes</p>
      <h2 class="mt-3 font-display text-3xl tracking-tight text-ink">Clarifier vos interrogations</h2>
    </div>
    <div class="mt-8 space-y-3">
      {faq.map((item) => (
        <details class="group rounded-2xl border border-ink/10 bg-paper p-5 shadow-soft">
          <summary class="flex cursor-pointer list-none items-center justify-between text-left text-base font-semibold text-ink">
            <span>{item.q}</span>
            <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5 text-ink/60 transition group-open:rotate-180" aria-hidden="true">
              <path d="M7 10.5 12 15l5-4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-ink/80">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="relative overflow-hidden bg-ink py-20 text-paper">
  <div class="absolute inset-0 opacity-15">
    <img
      src="https://lh3.googleusercontent.com/aida-public/AB6AXuCuTHCpNGuQfaM3Ngjz0mu9cZflxMnep0kYDoQ-GRy53lTm4cwxWAG6FY4UMRj7KgWHeJ0z-BgIxXbIX3y7cjP5DPaGyUjbFfW4zGACC3K7IyJai84P2y0tdF3d6cWKJA3TLKEym0mGoD_X0pEhJgdTcfAuIOON7rXqGjGCnRWpYSVQCtihLGASNOjMHhp8EXiC9uAkssjjZk8KSRhS7OUDhm4TOUV_3g8WpRPIGSXmORYCmiXpKSlMYXjs_np_5RxNJ39Ev6tW7Gkv"
      alt="Texture décorative"
      class="h-full w-full object-cover"
      loading="lazy"
    />
  </div>
  <div class="relative mx-auto max-w-4xl px-4 text-center">
    <h2 class="font-display text-4xl leading-tight tracking-tight sm:text-5xl">
      {ctaTitle}
      <span class="italic text-paper/70"> {ctaEmphasis}</span>
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-base text-paper/80">{ctaBody}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/contact" class="btn btn-pill btn-lg bg-paper text-ink hover:bg-paper/90">Réserver une consultation</a>
      <a href={telHref} class="btn btn-pill btn-lg border border-paper/30 bg-transparent text-paper hover:bg-paper/10">
        {phoneDisplay}
      </a>
    </div>
  </div>
</section>
