---
import type { BlogBlock } from '@/lib/cms/blogBlocks';

type Props = { blocks: BlogBlock[] };

const { blocks } = Astro.props;
const safeBlocks = Array.isArray(blocks) ? blocks : [];

type PlainChunk =
  | { type: 'p'; text: string }
  | { type: 'ul'; items: string[] };

function escapeHtml(value: string) {
  return String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function parsePlainText(input: string): PlainChunk[] {
  const text = String(input ?? '');
  const lines = text.split('\n');
  const out: PlainChunk[] = [];
  let paragraph: string[] = [];
  let bullets: string[] = [];

  const flushParagraph = () => {
    const t = paragraph.join(' ').trim();
    paragraph = [];
    if (t) out.push({ type: 'p', text: t });
  };
  const flushBullets = () => {
    const items = bullets.map((x) => x.trim()).filter(Boolean);
    bullets = [];
    if (items.length) out.push({ type: 'ul', items });
  };

  for (const raw of lines) {
    const line = raw.trim();
    if (!line) {
      flushParagraph();
      flushBullets();
      continue;
    }
    if (line.startsWith('- ')) {
      flushParagraph();
      bullets.push(line.slice(2));
      continue;
    }
    flushBullets();
    paragraph.push(line);
  }
  flushParagraph();
  flushBullets();
  return out;
}

function renderPlainHtml(input: string) {
  const chunks = parsePlainText(input);
  return chunks
    .map((c) => {
      if (c.type === 'p') return `<p class="mt-3 first:mt-0">${escapeHtml(c.text)}</p>`;
      const items = c.items
        .map(
          (item) =>
            `<li class="flex gap-3"><span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink/40"></span><span>${escapeHtml(
              item,
            )}</span></li>`,
        )
        .join('');
      return `<ul class="mt-3 grid gap-2 pl-1">${items}</ul>`;
    })
    .join('');
}

function calloutStyle(tone: string) {
  if (tone === 'securite') return { label: 'Sécurité', className: 'border-copper-deep' };
  if (tone === 'a-retenir') return { label: 'À retenir', className: 'border-copper' };
  if (tone === 'mythe-vrai') return { label: 'Mythe/Vrai', className: 'border-ink/45' };
  return { label: 'Conseil', className: 'border-sand' };
}
---

<div class="space-y-10">
  {
    safeBlocks.map((block) => {
      if (block.type === 'paragraph') {
        return <div class="text-lg leading-8 text-ink/80"><Fragment set:html={renderPlainHtml(block.text)} /></div>;
      }

      if (block.type === 'bullets') {
        return (
          <section>
            <h2 class="font-display text-2xl tracking-tight">{block.heading}</h2>
            <ul class="mt-5 grid gap-3 border-y border-ink/20 py-5 text-ink/80">
              {block.items.map((item) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-ink/40"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        );
      }

      if (block.type === 'section') {
        return (
          <section>
            <h2 class="font-display text-2xl tracking-tight">{block.heading}</h2>
            <div class="mt-4 text-ink/80"><Fragment set:html={renderPlainHtml(block.text)} /></div>
            {Array.isArray(block.points) && block.points.length ? (
              <ul class="mt-4 grid gap-2 pl-1 text-ink/80">
                {block.points.map((p) => (
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink/40"></span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            ) : null}
          </section>
        );
      }

      if (block.type === 'callout') {
        const style = calloutStyle(block.tone);
        return (
          <section class:list={[
            'border-l-2 py-2 pl-6 sm:pl-8',
            style.className
          ]}>
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-ink/60">{style.label}</div>
            {block.title ? <div class="mt-2 font-display text-3xl tracking-tight">{block.title}</div> : null}
            <div class="mt-3 text-ink/80"><Fragment set:html={renderPlainHtml(block.text)} /></div>
            {Array.isArray(block.points) && block.points.length ? (
              <ul class="mt-4 grid gap-2 pl-1 text-ink/80">
                {block.points.map((p) => (
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink/40"></span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            ) : null}
          </section>
        );
      }

      if (block.type === 'image') {
        const layout = block.layout ?? 'card';
        const figureClass =
          layout === 'left'
            ? 'grid gap-5 md:grid-cols-[280px_minmax(0,1fr)]'
            : layout === 'right'
              ? 'grid gap-5 md:grid-cols-[minmax(0,1fr)_280px]'
              : 'grid gap-4';

        return (
          <section>
            {block.heading ? <h2 class="font-display text-2xl tracking-tight">{block.heading}</h2> : null}
            <div class:list={[
              'mt-5 border-y border-ink/20 py-5'
            ]}>
              <figure class:list={[figureClass]}>
                <div class="overflow-hidden bg-mist/40">
                  <img src={block.url} alt={block.alt} class="h-full w-full object-cover" loading="lazy" />
                </div>
                {block.caption ? <figcaption class="text-sm text-ink/70">{block.caption}</figcaption> : null}
              </figure>
            </div>
          </section>
        );
      }

      if (block.type === 'faq') {
        return (
          <section>
            <h2 class="font-display text-2xl tracking-tight">{block.heading}</h2>
            <div class="mt-5 border-t border-ink/20">
              {block.items.map((item) => (
                <details class="group border-b border-ink/20 py-5">
                  <summary class="cursor-pointer list-none select-none font-semibold text-ink/85">
                    <div class="flex items-start justify-between gap-4">
                      <span>{item.question}</span>
                      <span class="mt-1 text-ink/50 transition group-open:rotate-45">+</span>
                    </div>
                  </summary>
                  <div class="mt-4 text-ink/80"><Fragment set:html={renderPlainHtml(item.answer)} /></div>
                </details>
              ))}
            </div>
          </section>
        );
      }

      if (block.type === 'sources') {
        const heading = block.heading || 'Références';
        return (
          <section>
            <h2 class="font-display text-2xl tracking-tight">{heading}</h2>
            {block.items.length ? (
              <ol class="mt-4 grid gap-3 border-y border-ink/20 py-5 text-sm text-ink/80">
                {block.items.map((s) => (
                  <li>
                    <a class="link" href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a>
                    <div class="mt-1 text-xs text-ink/55">
                      {[s.publisher, s.year].filter(Boolean).join(' • ')}
                    </div>
                  </li>
                ))}
              </ol>
            ) : (
              <div class="mt-3 text-sm text-ink/60">Aucune référence.</div>
            )}
          </section>
        );
      }

      if (block.type === 'cta') {
        return (
          <section class="border-y border-ink/30 bg-mist/50 px-6 py-7 sm:px-8">
            <h2 class="font-display text-3xl tracking-tight">{block.heading}</h2>
            <div class="mt-3 text-ink/80"><Fragment set:html={renderPlainHtml(block.text)} /></div>
            <div class="mt-5">
              <a href={block.button_href} class="inline-flex min-h-11 items-center justify-center border border-ink bg-ink px-5 text-xs font-semibold uppercase tracking-[0.14em] text-paper transition hover:bg-transparent hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-copper/50">{block.button_label}</a>
            </div>
          </section>
        );
      }

      return null;
    })
  }
</div>
