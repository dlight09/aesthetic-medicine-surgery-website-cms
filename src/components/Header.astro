---
import { site } from '@/lib/site';
import BrandLockup from '@/components/BrandLockup.astro';
import { getCollection } from 'astro:content';
import {
  interventionCategories,
  interventionCategoryFallbackList,
  interventionCategoryHref,
  type InterventionCategoryKey
} from '@/lib/interventions';
import { listPublicInterventions } from '@/lib/cms/interventions';
import { seoInterventionPages } from '@/lib/interventions/seoPages';

const pathname = (() => {
  const p = Astro.url?.pathname || '/';
  if (p === '/') return '/';
  return p.endsWith('/') ? p.slice(0, -1) : p;
})();

function isActiveHref(href: string) {
  const h = href === '/' ? '/' : href.endsWith('/') ? href.slice(0, -1) : href;
  if (h === '/') return pathname === '/';
  return pathname === h || pathname.startsWith(`${h}/`);
}

const nav = [
  { href: '/', label: 'Accueil' },
  { href: '/dr-sirine-soussi', label: 'Dr Soussi' },
  { href: '/interventions', label: 'Interventions' },
  { href: '/avant-apres', label: 'Avant/Après' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Rendez-vous' },
];

function leafSlug(full: string) {
  const parts = full.split('/').filter(Boolean);
  return parts[parts.length - 1] ?? full;
}

type NavEntry = { title: string; category: InterventionCategoryKey; order?: number | null; slug: string };

const localInterventionEntries: NavEntry[] = (await getCollection('interventions')).map((entry) => ({
  title: entry.data.title,
  category: entry.data.category,
  order: entry.data.order ?? null,
  slug: entry.slug.split('/').filter(Boolean).slice(-1)[0] ?? entry.slug,
}));

let cmsInterventionEntries: NavEntry[] = [];
try {
  const rows = await listPublicInterventions();
  cmsInterventionEntries = rows.map((r) => ({
    title: r.title,
    category: r.category,
    order: r.order,
    slug: r.slug,
  }));
} catch {
  // Repository content keeps navigation useful when the CMS is unavailable.
}

const interventionEntries = [...localInterventionEntries, ...cmsInterventionEntries];

const megaInterventions = interventionCategories.map((c) => {
  const normalize = (value: string) =>
    String(value || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();

  const seoCategoryAliases: Record<InterventionCategoryKey, string[]> = {
    'medecine-esthetique': ['medecine esthetique'],
    visage: ['visage'],
    silhouette: ['silhouette'],
    seins: ['seins'],
    'chirurgie-reparatrice': ['chirurgie reparatrice'],
    'chirurgie-de-la-main': ['chirurgie de la main'],
    intime: ['intime'],
  };

  const cmsEntries = interventionEntries
    .filter((i) => i.category === c.key)
    .sort((a, b) => (a.order ?? 999) - (b.order ?? 999))
    .map((i) => ({
      slug: leafSlug(i.slug),
      label: i.title,
      href: `/interventions/${i.category}/${leafSlug(i.slug)}`
    }));

  const seoEntries = Object.entries(seoInterventionPages)
    .filter(([, p]) => {
      const label = normalize(p.categoryLabel);
      return seoCategoryAliases[c.key as InterventionCategoryKey].includes(label);
    })
    .map(([slug, p]) => ({
      slug,
      label: p.breadcrumb.split('›').pop()?.trim() || p.h1,
      href: `/interventions/${c.key}/${slug}`,
    }));

  const prefersSeo = true;
  const merged = prefersSeo ? [...seoEntries, ...cmsEntries] : [...cmsEntries, ...seoEntries];
  const canonicalSlug = (slug: string) =>
    slug === 'blepharoplastie-paupieres' ? 'blepharoplastie' : slug;
  const seen = new Set<string>();
  const entries = merged
    .filter((item) => {
      const key = canonicalSlug(item.slug) || item.href;
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    })
    .map(({ label, href }) => ({ label, href }));

  const fallback = interventionCategoryFallbackList[c.key as InterventionCategoryKey] ?? [];

  return {
    key: c.key,
    title: c.title,
    description: c.description,
    thumbnail: c.presentationImage,
    href: interventionCategoryHref(c.key),
    entries,
    fallback
  };
});
---

<header
  class="site-header fixed inset-x-0 top-0 z-40 border-b text-paper"
  data-transparent={pathname === '/' ? 'true' : 'false'}
  data-scrolled={pathname === '/' ? 'false' : 'true'}
>
  <div class="relative mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href="/" class="group inline-flex items-center">
      <BrandLockup
        id="header-brand"
        class="transition group-hover:opacity-82"
        gapClass="gap-2 lg:gap-3"
        markClass="h-9 lg:h-11"
        wordmarkClass="hidden lg:inline"
        wordmarkSize="0.9rem"
      />
    </a>

    <nav aria-label="Navigation principale" class="hidden items-center gap-1 text-sm lg:flex">
      {nav.map((i) => {
        const active = isActiveHref(i.href);

        if (i.href === '/interventions') {
          return (
            <div class="group" data-mega-root data-open="false">
              <div class="inline-flex items-center" data-mega-trigger>
                <a
                  href={i.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'rounded-full px-3 py-3 transition',
                    'text-paper/72 hover:text-paper',
                    'focus:outline-none focus-visible:ring-2 focus-visible:ring-copper/40',
                    active && 'bg-paper/10 text-paper'
                  ]}
                >
                  <span class:list={[active && 'font-semibold']}>{i.label}</span>
                </a>

                <button
                  type="button"
                  class="-ml-1 inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-2 py-2 text-paper/62 transition hover:text-paper focus:outline-none focus-visible:ring-2 focus-visible:ring-copper/40"
                  aria-label="Ouvrir le menu Interventions"
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-controls="mega-interventions"
                  data-mega-toggle
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    class="transition-transform duration-200 group-data-[open=true]:rotate-180"
                  >
                    <path
                      d="M6 9L12 15L18 9"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
              </div>

              <div
                class="mega-wrap absolute left-1/2 top-full z-50 mt-3 w-[min(72rem,calc(100vw-2rem))] -translate-x-1/2"
              >
                <div
                  id="mega-interventions"
                  class="mega-panel overflow-hidden rounded-2xl border border-ink/10 bg-paper shadow-lift"
                  aria-hidden="true"
                  data-mega-panel
                >
                  <div class="max-h-[calc(100vh-6.75rem)] overflow-y-auto overscroll-contain">
                    <div class="flex items-center justify-between gap-6 border-b border-ink/10 px-5 py-3">
                      <div>
                        <div class="font-display text-xl tracking-tight text-ink">Explorer les interventions</div>
                        <div class="mt-0.5 text-xs text-ink/60">Une information claire, catégorie par catégorie.</div>
                      </div>
                      <a href="/interventions" class="shrink-0 text-xs font-semibold text-ink/70 hover:text-ink">
                        Toutes les interventions →
                      </a>
                    </div>

                    <div class="grid grid-cols-4 gap-3 p-4">
                      {megaInterventions.map((c) => (
                        <article class="flex min-w-0 flex-col rounded-2xl border border-ink/10 bg-mist/35 p-4 transition hover:border-ink/20 hover:bg-mist/60">
                          <a href={c.href} class="group/category flex min-w-0 items-center gap-3">
                            <img
                              src={c.thumbnail.src}
                              width={c.thumbnail.width}
                              height={c.thumbnail.height}
                              alt=""
                              loading="lazy"
                              class="h-12 w-14 shrink-0 rounded-xl border border-ink/10 object-cover"
                            />
                            <span class="min-w-0 font-display text-lg leading-tight tracking-tight text-ink group-hover/category:text-copper-deep">
                              {c.title}
                            </span>
                          </a>

                          {c.entries.length ? (
                            <ul class="mt-4 space-y-2 text-xs">
                              {c.entries.slice(0, 4).map((x) => (
                                <li class="min-w-0">
                                  <a href={x.href} class="block truncate text-ink/70 transition hover:text-ink">
                                    {x.label}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          ) : c.fallback.length ? (
                            <ul class="mt-4 space-y-2 text-xs">
                              {c.fallback.slice(0, 4).map((x) => (
                                <li class="truncate text-ink/60">{x}</li>
                              ))}
                            </ul>
                          ) : (
                            <div class="mt-4 text-xs text-ink/60">Fiches détaillées à venir.</div>
                          )}

                          <a href={c.href} class="mt-auto inline-flex pt-4 text-xs font-semibold text-ink/75 hover:text-ink">
                            Voir la catégorie →
                          </a>
                        </article>
                      ))}

                      <aside class="flex flex-col rounded-2xl bg-ink p-4 text-paper shadow-soft">
                        <div class="text-xs font-semibold uppercase tracking-[0.18em] text-paper/55">Consultation</div>
                        <div class="mt-2 font-display text-xl leading-tight tracking-tight">Votre projet commence par un échange.</div>
                        <p class="mt-2 text-xs leading-relaxed text-paper/68">
                          Une question sur une intervention ? Le cabinet vous répond.
                        </p>
                        <div class="mt-auto grid gap-2 pt-4">
                          <a href="/contact" class="inline-flex items-center justify-center rounded-xl bg-paper px-4 py-2.5 text-xs font-semibold text-ink transition hover:bg-sand">
                            Prendre rendez-vous
                          </a>
                          <div class="grid grid-cols-2 gap-2">
                            <a href={site.links.tel} class="inline-flex items-center justify-center rounded-xl border border-paper/20 px-3 py-2.5 text-xs font-semibold text-paper transition hover:bg-paper/10">
                              Appeler
                            </a>
                            <a href={site.links.whatsapp} class="inline-flex items-center justify-center rounded-xl border border-paper/20 px-3 py-2.5 text-xs font-semibold text-paper transition hover:bg-paper/10">
                              WhatsApp
                            </a>
                          </div>
                        </div>
                      </aside>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          );
        }

        return (
          <a
            href={i.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'rounded-full px-3 py-3 transition',
              'text-paper/72 hover:text-paper',
              'focus:outline-none focus-visible:ring-2 focus-visible:ring-copper/40',
              active && 'bg-paper/10 text-paper'
            ]}
          >
            <span class:list={[active && 'font-semibold']}>{i.label}</span>
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={site.links.whatsapp}
        class="hidden min-h-11 rounded-full border border-paper/18 bg-paper/10 px-3 py-2 text-sm text-paper/82 transition hover:border-paper/34 hover:bg-paper/16 hover:text-paper lg:inline-flex"
      >
        WhatsApp
      </a>

      <button
        type="button"
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full border border-paper/18 bg-paper/10 px-3 py-2 text-sm text-paper/82 transition hover:border-paper/34 hover:bg-paper/16 hover:text-paper focus:outline-none focus-visible:ring-2 focus-visible:ring-copper/40 lg:hidden"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <span class="sr-only">Ouvrir le menu</span>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M4 7H20M4 12H20M4 17H20"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          />
        </svg>
      </button>

      <a
        href={site.links.tel}
        class="inline-flex min-h-11 rounded-full bg-paper px-4 py-2 text-sm font-semibold text-ink shadow-soft transition hover:bg-sand hover:shadow-lift"
      >
        Appeler
      </a>
    </div>
  </div>

  <dialog
    id="mobile-menu"
    class="lg:hidden w-full max-w-none bg-transparent p-0"
    data-menu-dialog
  >
    <div class="fixed inset-0">
      <button
        type="button"
        class="fixed inset-0 bg-ink/30 backdrop-blur-sm"
        aria-label="Fermer le menu"
        data-menu-close
      ></button>

      <div class="relative mx-auto flex h-full max-w-6xl flex-col">
        <div class="flex-1 px-4 pt-4">
          <div class="mobile-menu-panel overflow-hidden rounded-2xl border border-ink/10 bg-paper shadow-lift">
            <div class="flex items-center justify-between border-b border-ink/10 px-4 py-3">
              <div class="flex items-baseline gap-2">
                <span class="font-display text-base tracking-tight">{site.name}</span>
                <span class="text-xs text-ink/65">{site.contact.city}</span>
              </div>
              <button
                type="button"
                class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full border border-ink/15 bg-paper px-3 py-2 text-sm text-ink/80 transition hover:border-ink/25 hover:bg-mist focus:outline-none focus-visible:ring-2 focus-visible:ring-copper/40"
                data-menu-close
              >
                <span class="sr-only">Fermer le menu</span>
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <path
                    d="M7 7L17 17M17 7L7 17"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                  />
                </svg>
              </button>
            </div>

            <nav aria-label="Navigation principale" class="px-2 py-2">
              {nav.map((i) => {
                const active = isActiveHref(i.href);
                return (
                  <a
                    href={i.href}
                    aria-current={active ? 'page' : undefined}
                    data-menu-link
                    class:list={[
                      'flex items-center justify-between rounded-xl px-3 py-3 text-base transition',
                      'focus:outline-none focus-visible:ring-2 focus-visible:ring-copper/40',
                      active ? 'bg-mist text-ink' : 'text-ink/85 hover:bg-mist'
                    ]}
                  >
                    <span class:list={[active && 'font-semibold']}>{i.label}</span>
                    <span class="text-ink/40" aria-hidden="true">→</span>
                  </a>
                );
              })}
            </nav>

            <div class="grid grid-cols-2 gap-2 border-t border-ink/10 px-4 py-3">
              <a
                href={site.links.tel}
                class="inline-flex items-center justify-center rounded-xl bg-ink px-4 py-3 text-sm font-semibold text-paper"
                data-menu-link
              >
                Appeler
              </a>
              <a
                href={site.links.whatsapp}
                class="inline-flex items-center justify-center rounded-xl border border-ink/15 bg-mist px-4 py-3 text-sm font-semibold text-ink"
                data-menu-link
              >
                WhatsApp
              </a>
            </div>
          </div>
        </div>
        <div class="h-8"></div>
      </div>
    </div>
  </dialog>

  <script is:inline>
    (() => {
      const header = document.querySelector('.site-header');
      if (header instanceof HTMLElement && header.dataset.transparent === 'true') {
        const updateHeader = () => {
          header.dataset.scrolled = window.scrollY > 32 ? 'true' : 'false';
        };

        updateHeader();
        window.addEventListener('scroll', updateHeader, { passive: true });
      }

      const openBtn = document.querySelector('[data-menu-open]');
      const dialog = document.querySelector('[data-menu-dialog]');
      if (!(openBtn instanceof HTMLElement)) return;
      if (!(dialog instanceof HTMLDialogElement)) return;

      const closeEls = dialog.querySelectorAll('[data-menu-close], [data-menu-link]');

      const lockScroll = (locked) => {
        document.documentElement.classList.toggle('menu-scroll-lock', locked);
        document.body.classList.toggle('menu-scroll-lock', locked);
      };

      const open = () => {
        if (dialog.open) return;
        dialog.showModal();
        lockScroll(true);
        const panel = dialog.querySelector('.mobile-menu-panel');
        const focusTarget = dialog.querySelector('[data-menu-close]');
        if (panel) panel.classList.add('mobile-menu-enter');
        if (focusTarget instanceof HTMLElement) focusTarget.focus();
      };

      const close = () => {
        if (!dialog.open) return;
        dialog.close();
      };

      openBtn.addEventListener('click', open);
      closeEls.forEach((el) => el.addEventListener('click', close));

      dialog.addEventListener('close', () => {
        lockScroll(false);
        const panel = dialog.querySelector('.mobile-menu-panel');
        if (panel) panel.classList.remove('mobile-menu-enter');
        openBtn.focus();
      });

      dialog.addEventListener('click', (e) => {
        // Click outside the panel closes the dialog.
        if (e.target === dialog) close();
      });
    })();
  </script>

  <script is:inline>
    (() => {
      const roots = document.querySelectorAll('[data-mega-root]');
      if (!roots.length) return;

      roots.forEach((root) => {
        const toggle = root.querySelector('[data-mega-toggle]');
        const trigger = root.querySelector('[data-mega-trigger]');
        const panel = root.querySelector('[data-mega-panel]');
        if (!(toggle instanceof HTMLButtonElement)) return;
        if (!(trigger instanceof HTMLElement)) return;
        if (!(panel instanceof HTMLElement)) return;

        let open = false;
        let openTimer;
        let closeTimer;

        const setOpen = (next) => {
          open = next;
          root.dataset.open = open ? 'true' : 'false';
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          panel.setAttribute('aria-hidden', open ? 'false' : 'true');
          panel.classList.toggle('mega-open', open);
        };

        const scheduleOpen = (delay = 70) => {
          window.clearTimeout(closeTimer);
          window.clearTimeout(openTimer);
          openTimer = window.setTimeout(() => setOpen(true), delay);
        };

        const scheduleClose = (delay = 180) => {
          window.clearTimeout(openTimer);
          window.clearTimeout(closeTimer);
          closeTimer = window.setTimeout(() => setOpen(false), delay);
        };

        // Hover: only open when user is on the trigger or panel.
        trigger.addEventListener('mouseenter', () => scheduleOpen(60));
        trigger.addEventListener('mouseleave', () => scheduleClose(220));
        panel.addEventListener('mouseenter', () => scheduleOpen(0));
        panel.addEventListener('mouseleave', () => scheduleClose(180));

        root.addEventListener('focusin', () => setOpen(true));
        root.addEventListener('focusout', (e) => {
          const next = e.relatedTarget;
          if (!(next instanceof Node)) return;
          if (!root.contains(next)) scheduleClose(0);
        });

        toggle.addEventListener('click', (e) => {
          e.preventDefault();
          setOpen(!open);
        });

        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          if (!open) return;
          setOpen(false);
          toggle.focus();
        });

        document.addEventListener('mousedown', (e) => {
          if (!open) return;
          const t = e.target;
          if (!(t instanceof Node)) return;
          if (root.contains(t)) return;
          setOpen(false);
        });
      });
    })();
  </script>

  <style>
    .site-header {
      background: rgb(var(--c-ink));
      border-color: rgba(var(--c-paper) / 0.1);
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04);
      transition:
        background-color 220ms ease,
        border-color 220ms ease,
        box-shadow 220ms ease;
    }

    .site-header[data-transparent='true'][data-scrolled='false'] {
      background: transparent;
      border-color: transparent;
      box-shadow: none;
    }
  </style>
</header>
