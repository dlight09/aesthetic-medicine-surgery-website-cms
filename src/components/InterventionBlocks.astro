---
import type { InterventionContentBlock } from '@/lib/cms/interventionBlocks';

type Props = {
  blocks: InterventionContentBlock[];
};

const { blocks } = Astro.props;

const safeBlocks = Array.isArray(blocks) ? blocks : [];

type ProcedureCardLoose = { subtitle?: string; text?: string; points?: string[] };
type ProcedureCard = { subtitle: string; text: string; points: string[] };

type PlainChunk =
  | { type: 'p'; text: string }
  | { type: 'ul'; items: string[] };

function parsePlainText(input: string): PlainChunk[] {
  const text = String(input ?? '');
  const lines = text.split('\n');
  const out: PlainChunk[] = [];
  let paragraph: string[] = [];
  let bullets: string[] = [];

  const flushParagraph = () => {
    const t = paragraph.join(' ').trim();
    paragraph = [];
    if (t) out.push({ type: 'p', text: t });
  };
  const flushBullets = () => {
    const items = bullets.map((x) => x.trim()).filter(Boolean);
    bullets = [];
    if (items.length) out.push({ type: 'ul', items });
  };

  for (const raw of lines) {
    const line = raw.trim();
    if (!line) {
      flushParagraph();
      flushBullets();
      continue;
    }
    if (line.startsWith('- ')) {
      flushParagraph();
      bullets.push(line.slice(2));
      continue;
    }
    flushBullets();
    paragraph.push(line);
  }
  flushParagraph();
  flushBullets();
  return out;
}

function renderPlain(input: string) {
  const chunks = parsePlainText(input);
  return chunks.map((c) => {
    if (c.type === 'p') return <p class="mt-3 first:mt-0">{c.text}</p>;
    return (
      <ul class="mt-3 grid gap-2 pl-1">
        {c.items.map((item) => (
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink/40"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    );
  });
}

function normalizeMdLists(md: string) {
  // Back-compat for old seeded content that used markdown.
  return String(md ?? '').replace(/^(###\s+[^\n]+)\n(-\s+)/gm, '$1\n\n$2');
}

function parseProcedure(md: string) {
  const src = normalizeMdLists(md);
  const re = /^###\s+(.+)\s*$/gm;
  const matches: { title: string; start: number; end: number }[] = [];
  let m: RegExpExecArray | null;
  while ((m = re.exec(src))) {
    matches.push({ title: (m[1] ?? '').trim(), start: m.index, end: re.lastIndex });
  }
  if (matches.length < 2) return null;
  const parts: { title: string; body: string }[] = [];
  for (let i = 0; i < matches.length; i++) {
    const cur = matches[i];
    const next = matches[i + 1];
    const bodyStart = cur.end;
    const bodyEnd = next ? next.start : src.length;
    const body = src.slice(bodyStart, bodyEnd).trim();
    parts.push({ title: cur.title, body });
  }
  return parts;
}

function isDerouleHeading(value: string) {
  const v = String(value ?? '')
    .toLowerCase()
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .trim();
  return v === 'deroule' || v === 'deroulement';
}
---

<div class="space-y-10">
  {
    safeBlocks.map((block) => {
      if (block.type === 'bullets') {
        return (
          <section>
            <h2 class="font-display text-2xl tracking-tight">{block.heading}</h2>
            <ul class="mt-4 grid gap-2 rounded-3xl border border-ink/10 bg-mist/40 p-6 text-ink/80 shadow-soft">
              {block.items.map((item) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-ink/40"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        );
      }

      if (block.type === 'section') {
        const rawText = (block as any).text ?? (block as any).body ?? '';
        const procedure = isDerouleHeading(block.heading) ? parseProcedure(rawText) : null;
        return (
          <section>
            <h2 class="font-display text-2xl tracking-tight">{block.heading}</h2>
            {procedure ? (
              <div class="mt-5 grid gap-4 sm:grid-cols-3">
                {procedure.map((item) => (
                  <div class="rounded-3xl border border-ink/10 bg-paper p-6 shadow-soft">
                    <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">{item.title}</div>
                    <div class="mt-3 text-ink/80">{renderPlain(item.body)}</div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="mt-4 text-ink/80">
                {renderPlain(rawText)}
                {Array.isArray((block as any).points) && (block as any).points.length ? (
                  <ul class="mt-4 grid gap-2 pl-1">
                    {(block as any).points.map((p: string) => (
                      <li class="flex gap-3">
                        <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink/40"></span>
                        <span>{p}</span>
                      </li>
                    ))}
                  </ul>
                ) : null}
              </div>
            )}
          </section>
        );
      }

      if (block.type === 'procedure') {
        const legacyCards = (Array.isArray((block as any).cards)
          ? (block as any).cards
          : [
              { subtitle: 'Carte 1', text: (block as any).avant ?? '', points: [] },
              { subtitle: 'Carte 2', text: (block as any).pendant ?? '', points: [] },
              { subtitle: 'Carte 3', text: (block as any).apres ?? '', points: [] },
            ]) as ProcedureCardLoose[];

        const cards: ProcedureCard[] = legacyCards
          .slice(0, 3)
          .map((c: ProcedureCardLoose, idx: number) => ({
            subtitle: String(c?.subtitle ?? `Carte ${idx + 1}`),
            text: String(c?.text ?? ''),
            points: Array.isArray(c?.points) ? c.points : [],
          }));

        const hasAny = cards.some(
          (c: ProcedureCard) => String(c.text ?? '').trim() || (Array.isArray(c.points) && c.points.length),
        );
        if (!hasAny) return null;

        return (
          <section>
            <h2 class="font-display text-2xl tracking-tight">{block.heading || 'Déroulé'}</h2>
            <div class="mt-5 grid gap-4 sm:grid-cols-3">
              {cards.map((item, idx: number) => (
                <div class="rounded-3xl border border-ink/10 bg-paper p-6 shadow-soft">
                  <div class="text-xs font-semibold uppercase tracking-wide text-ink/50">
                    {item.subtitle || `Carte ${idx + 1}`}
                  </div>
                  <div class="mt-3 text-ink/80">
                    {item.text ? renderPlain(item.text) : null}
                    {Array.isArray(item.points) && item.points.length ? (
                      <ul class="mt-3 grid gap-2 pl-1">
                        {item.points.map((p: string) => (
                          <li class="flex gap-3">
                            <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink/40"></span>
                            <span>{p}</span>
                          </li>
                        ))}
                      </ul>
                    ) : null}
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      }

      if (block.type === 'image') {
        const layout = block.layout ?? 'card';
        const wrapClass =
          layout === 'full'
            ? 'overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-soft'
            : 'overflow-hidden rounded-3xl border border-ink/10 bg-paper shadow-soft';

        const figureClass =
          layout === 'left'
            ? 'grid gap-5 md:grid-cols-[280px_minmax(0,1fr)]'
            : layout === 'right'
              ? 'grid gap-5 md:grid-cols-[minmax(0,1fr)_280px]'
              : 'grid gap-4';

        const imgClass = 'h-full w-full object-cover';
        const imgWrapClass =
          layout === 'left' || layout === 'right'
            ? 'overflow-hidden rounded-3xl border border-ink/10 bg-mist/40'
            : 'overflow-hidden rounded-3xl border border-ink/10 bg-mist/40';

        return (
          <section>
            {block.heading ? <h2 class="font-display text-2xl tracking-tight">{block.heading}</h2> : null}
            <div class:list={[wrapClass, block.heading ? 'mt-4 p-6' : 'p-6']}>
              <figure class:list={[figureClass]}>
                {layout === 'right' ? (
                  <>
                    <figcaption class="order-1">
                      {block.caption ? <div class="text-sm text-ink/70">{block.caption}</div> : null}
                    </figcaption>
                    <div class:list={[imgWrapClass, 'order-2']}>
                      <img src={block.url} alt={block.alt} class={imgClass} loading="lazy" />
                    </div>
                  </>
                ) : (
                  <>
                    <div class={imgWrapClass}>
                      <img src={block.url} alt={block.alt} class={imgClass} loading="lazy" />
                    </div>
                    {block.caption ? <figcaption class="text-sm text-ink/70">{block.caption}</figcaption> : null}
                  </>
                )}
              </figure>
            </div>
          </section>
        );
      }

      if (block.type === 'faq') {
        return (
          <section>
            <h2 class="font-display text-2xl tracking-tight">{block.heading}</h2>
            <div class="mt-5 grid gap-3">
              {block.items.map((item) => (
                <details class="group rounded-3xl border border-ink/10 bg-paper p-5 shadow-soft">
                  <summary class="cursor-pointer list-none select-none font-semibold text-ink/85">
                    <div class="flex items-start justify-between gap-4">
                      <span>{item.question}</span>
                      <span class="mt-1 text-ink/50 transition group-open:rotate-45">+</span>
                    </div>
                  </summary>
                  <div class="mt-4 text-ink/80">{renderPlain(item.answer)}</div>
                </details>
              ))}
            </div>
          </section>
        );
      }

      if (block.type === 'cta') {
        return (
          <section class="rounded-3xl border border-ink/10 bg-mist/40 p-7 shadow-soft">
            <h2 class="font-display text-2xl tracking-tight">{block.heading}</h2>
            <div class="mt-3 text-ink/80">{renderPlain(block.body)}</div>
            <div class="mt-5">
              <a href={block.button_href} class="btn btn-pill btn-md btn-primary">{block.button_label}</a>
            </div>
          </section>
        );
      }

      return null;
    })
  }
</div>
