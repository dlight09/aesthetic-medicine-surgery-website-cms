---
type Metric = { value: string; label: string };
const { metrics } = Astro.props as { metrics: Metric[] };
---

<dl class="stat-bar" data-stat-bar>
  {metrics.map((metric, index) => {
    const target = parseFloat(metric.value);
    const suffix = metric.value.replace(/^[\d.]+/, '');
    return (
      <div class="stat-cell">
        <dt>
          {index > 0 && <div class="stat-divider" aria-hidden="true"></div>}
          {index >= 2 && <div class="stat-divider stat-divider--row" aria-hidden="true"></div>}
          <div class="stat-tick" aria-hidden="true"></div>
          <span class="sr-only">{metric.value}</span>
          <span class="stat-number" aria-hidden="true">
            <span class="stat-count" data-count={target} data-decimals="0" style={`--digits: ${String(target).length}`}>{target}</span>
            {suffix && <span class="stat-suffix">{suffix}</span>}
          </span>
        </dt>
        <dd class="stat-label">{metric.label}</dd>
      </div>
    );
  })}
</dl>

<style>
  .stat-bar,
  .stat-bar * { border-radius: 0; }

  .stat-bar {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    border: 1px solid rgb(var(--c-ink));
    background: rgb(var(--c-paper));
    color: rgb(var(--c-ink));
  }

  .stat-cell {
    position: relative;
    min-width: 0;
    padding: 40px 28px 34px;
  }

  .stat-divider {
    position: absolute;
    left: 0;
    top: 14%;
    bottom: 14%;
    width: 1px;
    background: rgb(var(--c-ink) / 0.2);
    transform-origin: top;
    pointer-events: none;
  }

  .stat-divider--row { display: none; }

  .stat-number {
    display: flex;
    align-items: flex-start;
    gap: 2px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(34px, 4.2vw, 52px);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .stat-count { min-width: calc(var(--digits) * 1ch); }

  .stat-suffix {
    margin-top: 0.15em;
    color: rgb(var(--c-copper-deep));
    font-size: 0.5em;
  }

  .stat-label {
    max-width: 20ch;
    margin: 14px 0 0;
    color: rgb(var(--c-ink) / 0.75);
    font-size: 13px;
    line-height: 1.5;
  }

  .stat-tick {
    position: absolute;
    top: 0;
    left: 28px;
    width: 18px;
    height: 2px;
    background: rgb(var(--c-copper));
    transform-origin: left;
    pointer-events: none;
  }

  @media (max-width: 760px) {
    .stat-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat-cell { padding-inline: 20px; }
    .stat-tick { left: 20px; }
    .stat-cell:nth-child(3) .stat-divider:not(.stat-divider--row) { display: none; }
    .stat-divider--row {
      display: block;
      top: 0;
      bottom: auto;
      width: 100%;
      height: 1px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stat-bar { clip-path: none !important; }
    .stat-divider,
    .stat-tick { transform: none !important; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll<HTMLElement>('[data-stat-bar]').forEach((bar) => {
    const counters = Array.from(bar.querySelectorAll<HTMLElement>('[data-count]'));
    const dividers = bar.querySelectorAll<HTMLElement>('.stat-divider');
    const ticks = bar.querySelectorAll<HTMLElement>('.stat-tick');
    const media = gsap.matchMedia();
    let started = false;
    const showFinalNumbers = () => counters.forEach((element) => {
      element.textContent = Number(element.dataset.count).toFixed(Number(element.dataset.decimals));
    });

    media.add('(prefers-reduced-motion: no-preference)', () => {
      // A preference change must not replay a sequence already started.
      if (started) return;
      gsap.set(bar, { clipPath: 'inset(0 100% 0 0)' });
      gsap.set(dividers, { scaleY: 0 });
      gsap.set(ticks, { scaleX: 0 });
      counters.forEach(element => { element.textContent = '0'; });

      // Exact timings and numeric-proxy counter logic from stats-bar-gsap.html.
      // Build within matchMedia's context so even proxy tweens are cleaned up.
      const timeline = gsap.timeline({ paused: true, defaults: { ease: 'expo.out' } });
      timeline
        .to(bar, { clipPath: 'inset(0 0% 0 0)', duration: 1.0 }, 0)
        .to(bar.querySelectorAll('.stat-divider:not(.stat-divider--row)'), { scaleY: 1, duration: 0.5, ease: 'power2.out', stagger: 0.12 }, 0.35)
        .to(bar.querySelectorAll('.stat-divider--row'), { scaleY: 1, duration: 0.5, ease: 'power2.out', stagger: 0.12 }, 0.35)
        .to(ticks, { scaleX: 1, duration: 0.5, stagger: 0.12 }, 0.5);

      counters.forEach((element, index) => {
        const target = Number(element.dataset.count);
        const decimals = Number(element.dataset.decimals);
        const proxy = { val: 0 };
        timeline.to(proxy, {
          val: target,
          duration: 1.3,
          ease: 'power2.out',
          onUpdate: () => { element.textContent = proxy.val.toFixed(decimals); },
        }, 0.55 + index * 0.12);
      });

      ScrollTrigger.create({
        trigger: bar,
        start: 'top 78%',
        once: true,
        onEnter: () => {
          started = true;
          timeline.play();
        },
      });

      return showFinalNumbers;
    });

    document.addEventListener('astro:before-swap', () => {
      media.revert();
      showFinalNumbers();
    }, { once: true });
  });
</script>
