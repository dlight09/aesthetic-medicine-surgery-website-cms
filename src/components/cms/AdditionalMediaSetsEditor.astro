---
type MediaSet = {
  label?: string | null;
  view_key?: string | null;
  result_delay_label?: string | null;
  before_path?: string | null;
  after_path?: string | null;
  beforeUrl?: string | null;
  afterUrl?: string | null;
};

const { initialMediaSets = [] } = Astro.props as { initialMediaSets?: MediaSet[] };
const editorId = `additional-media-${crypto.randomUUID()}`;
---

<section id={editorId} class="rounded-2xl border border-ink/10 bg-mist/45 p-5" data-media-editor data-initial={JSON.stringify(initialMediaSets)}>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <div class="text-sm font-semibold text-ink/85">Vues complémentaires</div>
      <p class="mt-1 text-xs leading-relaxed text-ink/60">Ajoutez une paire Avant/Après pour un profil ou une autre vue. Facultatif.</p>
    </div>
    <button type="button" class="btn btn-pill btn-sm btn-secondary" data-add-media-set>Ajouter une vue</button>
  </div>
  <div class="mt-5 grid gap-4" data-media-set-list></div>
  <input type="hidden" name="media_sets_json" value="[]" data-media-set-value />
</section>

<script is:inline define:vars={{ editorId }}>
  (() => {
    const root = document.getElementById(editorId);
    if (!(root instanceof HTMLElement)) return;
    const list = root.querySelector('[data-media-set-list]');
    const valueInput = root.querySelector('[data-media-set-value]');
    const addButton = root.querySelector('[data-add-media-set]');
    if (!(list instanceof HTMLElement) || !(valueInput instanceof HTMLInputElement) || !(addButton instanceof HTMLButtonElement)) return;

    const maxFileSize = 10 * 1024 * 1024;
    let sets = [];
    try {
      const initial = JSON.parse(root.dataset.initial ?? '[]');
      sets = Array.isArray(initial)
        ? initial.map((set) => ({
            label: typeof set?.label === 'string' ? set.label : '',
            view_key: typeof set?.view_key === 'string' ? set.view_key : '',
            result_delay_label: typeof set?.result_delay_label === 'string' ? set.result_delay_label : '',
            before_path: typeof set?.before_path === 'string' ? set.before_path : '',
            after_path: typeof set?.after_path === 'string' ? set.after_path : '',
            beforeUrl: typeof set?.beforeUrl === 'string' ? set.beforeUrl : '',
            afterUrl: typeof set?.afterUrl === 'string' ? set.afterUrl : '',
          }))
        : [];
    } catch {
      sets = [];
    }

    const sync = () => {
      valueInput.value = JSON.stringify(
        sets
          .filter((set) => set.before_path && set.after_path)
          .map((set) => ({
            label: set.label || null,
            view_key: set.view_key || null,
            result_delay_label: set.result_delay_label || null,
            before_path: set.before_path,
            after_path: set.after_path,
          })),
      );
    };

    const upload = async (index, kind, file, status) => {
      if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
        status.textContent = 'Format non accepté.';
        return;
      }
      if (file.size > maxFileSize) {
        status.textContent = 'Fichier trop lourd (10 Mo max).';
        return;
      }
      status.textContent = 'Upload en cours...';
      try {
        const response = await fetch('/api/cms/avant-apres/upload-url', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fileName: file.name, kind, contentType: file.type }),
        });
        if (!response.ok) throw new Error('upload-url');
        const data = await response.json();
        const result = await fetch(data.signedUrl, {
          method: 'PUT',
          headers: { 'Content-Type': file.type },
          body: file,
        });
        if (!result.ok) throw new Error('upload');
        sets[index][`${kind}_path`] = data.path;
        sets[index][`${kind}Url`] = URL.createObjectURL(file);
        sync();
        render();
      } catch {
        status.textContent = 'Erreur d’upload. Réessayez.';
      }
    };

    const render = () => {
      list.replaceChildren();
      sets.forEach((set, index) => {
        const row = document.createElement('div');
        row.className = 'rounded-xl border border-ink/10 bg-paper p-4';
        row.innerHTML = `
          <div class="flex items-center justify-between gap-3">
            <div class="text-xs font-semibold uppercase tracking-wide text-ink/55">Vue ${index + 2}</div>
            <button type="button" class="text-xs font-semibold text-rose-700 hover:text-rose-900" data-remove>Retirer</button>
          </div>
          <div class="mt-4 grid gap-3 sm:grid-cols-3">
            <label class="grid gap-1 text-xs text-ink/70">Libellé<input class="cms-input" data-field="label" placeholder="Profil" /></label>
            <label class="grid gap-1 text-xs text-ink/70">Vue<input class="cms-input" data-field="view_key" placeholder="profile" /></label>
            <label class="grid gap-1 text-xs text-ink/70">Délai résultat<input class="cms-input" data-field="result_delay_label" placeholder="3 mois" /></label>
          </div>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <label class="grid gap-2 text-xs font-semibold text-ink/70">Avant<input type="file" accept="image/jpeg,image/png,image/webp" data-upload="before" /></label>
            <label class="grid gap-2 text-xs font-semibold text-ink/70">Après<input type="file" accept="image/jpeg,image/png,image/webp" data-upload="after" /></label>
          </div>
          <div class="mt-3 grid gap-3 sm:grid-cols-2" data-preview-row></div>
          <div class="mt-2 text-xs text-ink/60" data-status></div>
        `;
        row.querySelectorAll('[data-field]').forEach((input) => {
          if (!(input instanceof HTMLInputElement)) return;
          const field = input.dataset.field;
          if (!field) return;
          input.value = set[field] ?? '';
          input.addEventListener('input', () => {
            sets[index][field] = input.value;
            sync();
          });
        });
        const previewRow = row.querySelector('[data-preview-row]');
        if (previewRow instanceof HTMLElement) {
          [['before', set.beforeUrl], ['after', set.afterUrl]].forEach(([label, url]) => {
            if (!url) return;
            const image = document.createElement('img');
            image.src = url;
            image.alt = `Vue complémentaire ${label}`;
            image.className = 'h-28 w-full rounded-lg object-cover';
            previewRow.append(image);
          });
        }
        const status = row.querySelector('[data-status]');
        row.querySelectorAll('[data-upload]').forEach((input) => {
          if (!(input instanceof HTMLInputElement) || !(status instanceof HTMLElement)) return;
          input.addEventListener('change', () => {
            const file = input.files?.[0];
            const kind = input.dataset.upload;
            if (file && (kind === 'before' || kind === 'after')) upload(index, kind, file, status);
          });
        });
        const remove = row.querySelector('[data-remove]');
        if (remove instanceof HTMLButtonElement) {
          remove.addEventListener('click', () => {
            sets.splice(index, 1);
            sync();
            render();
          });
        }
        list.append(row);
      });
    };

    addButton.addEventListener('click', () => {
      sets.push({ label: '', view_key: '', result_delay_label: '', before_path: '', after_path: '', beforeUrl: '', afterUrl: '' });
      render();
    });
    sync();
    render();
  })();
</script>
