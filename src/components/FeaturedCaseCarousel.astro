---
type GalleryImage = {
  src: string;
  alt: string;
};

const { images } = Astro.props as { images: GalleryImage[] };
const carouselId = `home-gallery-${crypto.randomUUID()}`;
const repeatedImages = Array.from({ length: 3 }, (_, groupIndex) =>
  images.map((image, imageIndex) => ({ ...image, groupIndex, imageIndex })),
).flat();
---

<section id={carouselId} class="home-gallery" aria-labelledby={`${carouselId}-title`}>
  <div class="home-gallery__intro">
    <h2 id={`${carouselId}-title`}>Galerie photos</h2>
    <p>Découvrez les actes de médecine et de chirurgie esthétique pratiqués par le Dr Sirine Soussi à Tunis.</p>
  </div>

  <div class="home-gallery__carousel">
    <div class="home-gallery__viewport" data-viewport aria-roledescription="carrousel" aria-label="Galerie de photographies cliniques">
      <div class="home-gallery__track">
        {repeatedImages.map((image) => {
          const isPrimary = image.groupIndex === 1;
          return (
            <figure
              class="home-gallery__slide"
              data-slide
              data-image-index={image.imageIndex}
              aria-hidden={isPrimary ? undefined : 'true'}
            >
              <img
                src={image.src}
                alt={isPrimary ? image.alt : ''}
                loading={isPrimary && image.imageIndex === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </figure>
          );
        })}
      </div>
    </div>

    {images.length > 1 && (
      <>
        <button class="home-gallery__control home-gallery__control--previous" type="button" data-previous aria-label="Voir la photo précédente">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button class="home-gallery__control home-gallery__control--next" type="button" data-next aria-label="Voir la photo suivante">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </>
    )}
  </div>

  <div class="home-gallery__footer">
    <a href="/avant-apres">
      Voir tous les résultats
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .home-gallery {
    overflow: hidden;
    padding: 4rem 0 5rem;
    background: #090909;
    color: #fff;
  }

  .home-gallery__intro {
    padding: 0 4%;
    text-align: center;
  }

  .home-gallery__intro h2 {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 3.5vw, 3.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  .home-gallery__intro p {
    max-width: 42rem;
    margin: 1.5rem auto 0;
    color: rgb(255 255 255 / 0.78);
    font-size: 0.9375rem;
    line-height: 1.75;
    text-wrap: balance;
  }

  .home-gallery__carousel {
    position: relative;
    margin-top: 2.5rem;
  }

  .home-gallery__viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    touch-action: pan-x pan-y;
  }

  .home-gallery__viewport::-webkit-scrollbar { display: none; }

  .home-gallery__track {
    --gallery-gap: 1.875rem;
    display: flex;
    gap: var(--gallery-gap);
  }

  .home-gallery__slide {
    flex: 0 0 100%;
    aspect-ratio: 4 / 5;
    margin: 0;
    overflow: hidden;
    background: #151515;
    scroll-snap-align: start;
  }

  .home-gallery__slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .home-gallery__control {
    position: absolute;
    z-index: 2;
    top: 50%;
    display: grid;
    width: 3rem;
    height: 3rem;
    padding: 0;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.9);
    border-radius: 9999px;
    background: rgb(9 9 9 / 0.22);
    color: #fff;
    cursor: pointer;
    transform: translateY(-50%);
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .home-gallery__control:hover { background: #fff; color: #090909; }
  .home-gallery__control:active { transform: translateY(-50%) scale(0.96); }
  .home-gallery__control:focus-visible { outline: 2px solid rgb(var(--c-copper)); outline-offset: 3px; }
  .home-gallery__control svg { width: 1.25rem; height: 1.25rem; }
  .home-gallery__control--previous { left: 4%; }
  .home-gallery__control--next { right: 4%; }

  .home-gallery__footer {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
    padding-inline: 4%;
  }

  .home-gallery__footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.55);
    padding-bottom: 0.3rem;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    transition: border-color 180ms ease;
  }

  .home-gallery__footer a:hover { border-color: #fff; }
  .home-gallery__footer a:focus-visible { outline: 2px solid rgb(var(--c-copper)); outline-offset: 4px; }
  .home-gallery__footer span { transition: transform 180ms ease; }
  .home-gallery__footer a:hover span { transform: translateX(0.25rem); }

  @media (min-width: 768px) {
    .home-gallery__intro p { margin-top: 2rem; font-size: 1rem; }
    .home-gallery__track { --gallery-gap: 2.5rem; }
    .home-gallery__slide { flex-basis: calc((100% - (2 * var(--gallery-gap))) / 3); }
    .home-gallery__control { width: 3.5rem; height: 3.5rem; }
  }

  @media (min-width: 1280px) {
    .home-gallery { padding: 5rem 0 7.5rem; }
  }

  @media (min-width: 1536px) {
    .home-gallery__track { --gallery-gap: 4.375rem; }
    .home-gallery__slide { flex-basis: calc((100% - (4 * var(--gallery-gap))) / 5); }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-gallery__viewport { scroll-behavior: auto; }
    .home-gallery__footer a,
    .home-gallery__footer span { transition: none; }
  }
</style>

<script is:inline define:vars={{ carouselId, imageCount: images.length }}>
  (() => {
    const root = document.getElementById(carouselId);
    const viewport = root?.querySelector('[data-viewport]');
    if (!(root instanceof HTMLElement) || !(viewport instanceof HTMLElement) || imageCount < 2) return;

    const slides = Array.from(root.querySelectorAll('[data-slide]'));
    const previous = root.querySelector('[data-previous]');
    const next = root.querySelector('[data-next]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let scrollTimer = 0;

    const nearestSlideIndex = () => {
      let nearestIndex = 0;
      let nearestDistance = Number.POSITIVE_INFINITY;
      slides.forEach((slide, index) => {
        const distance = Math.abs(slide.offsetLeft - viewport.scrollLeft);
        if (distance < nearestDistance) {
          nearestDistance = distance;
          nearestIndex = index;
        }
      });
      return nearestIndex;
    };

    const jumpTo = (index) => viewport.scrollTo({ left: slides[index].offsetLeft, behavior: 'auto' });
    const normalizePosition = () => {
      const index = nearestSlideIndex();
      if (index < imageCount) jumpTo(index + imageCount);
      if (index >= imageCount * 2) jumpTo(index - imageCount);
    };
    const move = (direction) => {
      normalizePosition();
      const targetIndex = nearestSlideIndex() + direction;
      viewport.scrollTo({
        left: slides[targetIndex].offsetLeft,
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
    };

    previous?.addEventListener('click', () => move(-1));
    next?.addEventListener('click', () => move(1));
    viewport.addEventListener('scroll', () => {
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(normalizePosition, 140);
    }, { passive: true });
    window.addEventListener('resize', () => {
      const logicalIndex = Number(slides[nearestSlideIndex()].dataset.imageIndex ?? 0);
      window.requestAnimationFrame(() => jumpTo(imageCount + logicalIndex));
    });
    window.requestAnimationFrame(() => jumpTo(imageCount));
  })();
</script>
