# Public site
SITE_URL=http://localhost:4321

# CMS auth
CMS_PASSWORD=change-me
# Active actor UUID used for audited CMS writes
CMS_ACTOR_ID=YOUR_CMS_ACTOR_UUID

# Supabase (server-side)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional
SUPABASE_AVANT_APRES_BUCKET=avant-apres
SUPABASE_CMS_MEDIA_BUCKET=cms-media
SUPABASE_BOOKING_MEDIA_BUCKET=booking-media
SUPABASE_PUBLIC_READ_TIMEOUT_MS=5000

# Preview-only approved blog fixture (never enable in production)
BLOG_PREVIEW_SERIES_2=false
